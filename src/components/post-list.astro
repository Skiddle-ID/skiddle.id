---
import FormattedDate from './formatted-date.astro';
import { postUrl, readingMinutes, type Post } from '~/lib/posts';
import { plainText } from '~/lib/plain-text.mjs';

interface Props {
  posts: Post[];
  /** Show description under the title */
  descriptions?: boolean;
  /** Add data attributes used by the client-side search on /posts */
  searchable?: boolean;
}
const { posts, descriptions = false, searchable = false } = Astro.props;
---
<ul class="flex flex-col">
  {/* data-search: plain text (no Markdown or HTML), so a post that mentions <script> can't look like a script tag to the CSP builder */}
  {posts.map((p) => (
    <li
      class="post-item py-3 border-b border-dashed last:border-b-0"
      data-search={searchable ? [p.data.title, p.data.description ?? '', p.data.tags.join(' '), p.data.category, plainText(p.body ?? '')].join(' ').toLowerCase() : undefined}
    >
      <div class="flex flex-col sm:flex-row sm:items-baseline gap-x-4 gap-y-0.5">
        <span class="text-xs text-[var(--color-muted)] shrink-0 sm:w-28 tabular-nums"><FormattedDate date={p.data.pubDate} /></span>
        <div class="min-w-0">
          <a href={postUrl(p)} class="hover:text-[var(--color-primary)] hover:underline underline-offset-4" lang={p.data.lang}>{p.data.title}</a>
          {descriptions && p.data.description && (
            <p class="text-sm text-[var(--color-muted)] mt-0.5">{p.data.description}</p>
          )}
          {descriptions && (
            <p class="text-xs text-[var(--color-muted)] mt-1 flex flex-wrap gap-x-2">
              <span>{readingMinutes(p)} min read</span>
              {p.data.tags.map((t) => <a href={`/topics/tag/${t.toLowerCase()}/`} class="tag">#{t}</a>)}
            </p>
          )}
        </div>
      </div>
    </li>
  ))}
</ul>
