---
/*
  The home page's testimonials: the first five from the services record (drag them into order in
  the admin app), one at a time, sliding (src/lib/slider.ts).
  - Swipe or scroll it sideways (CSS scroll snap), or use ‹ ›, the dots, or ← → with it focused.
  - It moves on by itself every 7 seconds, pausing while the pointer or focus is on it and while
    the tab is hidden. It stops for good once someone moves it, and never starts for people who
    ask for less motion (prefers-reduced-motion).
  - Without JavaScript it's still a sideways-scrolling row, just without the buttons.
*/
import type { TestimonialItem } from '~/types/services';

interface Props {
  testimonials: TestimonialItem[];
}

/** How many the home page shows; every one is on /services/ */
const MAX = 5;
const testimonials = Astro.props.testimonials.slice(0, MAX);
const n = testimonials.length;
---

{n > 0 && (
  <section aria-label="What people say" class="mt-12" data-slider>
    <div
      class="slider-track"
      data-track
      role={n > 1 ? 'region' : undefined}
      aria-roledescription={n > 1 ? 'carousel' : undefined}
      aria-label={n > 1 ? 'Testimonials' : undefined}
      tabindex={n > 1 ? 0 : undefined}
    >
      {testimonials.map((t, i) => (
        <figure class="slider-slide border-l-2 border-[var(--color-primary)] pl-4" data-slide aria-roledescription={n > 1 ? 'slide' : undefined} aria-label={n > 1 ? `${i + 1} of ${n}` : undefined}>
          <blockquote class="text-sm leading-relaxed">“{t.quote}”</blockquote>
          <figcaption class="text-xs text-[var(--color-muted)] mt-2">
            — <span class="text-[var(--color-text)]">{t.author}</span>{t.role && <>, {t.role}</>}
          </figcaption>
        </figure>
      ))}
    </div>
    {n > 1 && (
      <div class="mt-3 flex items-center gap-1 text-xs text-[var(--color-muted)]" data-controls hidden>
        <button type="button" class="slider-btn" data-prev aria-label="Previous testimonial">‹</button>
        <span class="flex items-center">
          {testimonials.map((t, i) => (
            <button type="button" class="slider-dot" data-dot={i} aria-label={`Testimonial ${i + 1}: ${t.author}`} aria-current={i === 0 ? 'true' : undefined}>
              <span aria-hidden="true"></span>
            </button>
          ))}
        </span>
        <button type="button" class="slider-btn" data-next aria-label="Next testimonial">›</button>
      </div>
    )}
  </section>
)}

<style>
  .slider-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-radius: var(--radius-xs, 2px);
  }
  .slider-track::-webkit-scrollbar {
    display: none;
  }
  .slider-track:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }
  /* Each slide is the track's whole width; the tallest sets the height, so nothing jumps */
  .slider-slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
  }
  .slider-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    min-height: 1.75rem;
    border-radius: var(--radius-sm, 4px);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .slider-btn:hover {
    color: var(--color-primary);
  }
  /* A dot inside a bigger button, so it's easy to hit */
  .slider-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.75rem;
    cursor: pointer;
  }
  .slider-dot > span {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-border);
    transition: background-color 0.2s, width 0.2s;
  }
  .slider-dot[aria-current='true'] > span {
    width: 0.875rem;
    background: var(--color-primary);
  }
  .slider-dot:hover > span {
    background: var(--color-primary);
  }
  .slider-btn:focus-visible,
  .slider-dot:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .slider-dot > span {
      transition: none;
    }
  }
</style>

<script>
  import { slider } from '~/lib/slider';

  for (const root of document.querySelectorAll<HTMLElement>('[data-slider]')) slider(root, { autoplay: 7000 });
</script>
