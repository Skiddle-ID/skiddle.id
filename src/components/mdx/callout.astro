---
interface Props { type?: 'info' | 'warn' | 'tip' | 'danger'; title?: string; }
const { type = 'info', title } = Astro.props as Props;
const accent: Record<string, string> = {
  info: 'var(--color-primary)',
  warn: '#f1c21b',
  tip: '#42be65',
  danger: '#fa4d56',
};
---
<aside class="not-prose my-5 border-l-2 pl-4 py-1 text-sm leading-relaxed" style={`border-color: ${accent[type] ?? accent.info}`}>
  {title && <p class="font-semibold mb-1" style={`color: ${accent[type] ?? accent.info}`}>{title}</p>}
  <div><slot /></div>
</aside>
