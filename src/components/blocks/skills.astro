---
/* The skills block (src/lib/page-blocks.mjs): each group of skills as a card of tags, two to a row */
import type { SkillsBlock } from '~/lib/page-blocks.mjs';

interface Props {
  block: SkillsBlock;
  anchor?: string;
}
const { block, anchor } = Astro.props;
---

<section aria-labelledby={anchor} class="mt-12">
  <h2 id={anchor} class="font-semibold before-hash-2 print:before:content-none">{block.title}</h2>
  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    {block.groups.map((g) => (
      <div class="card p-4">
        <h3 class="text-xs uppercase tracking-wider text-[var(--color-primary)]">{g.title}</h3>
        <p class="mt-2.5 flex flex-wrap gap-1.5">
          {g.items.map((s) => <span class="text-xs px-2 py-0.5 rounded-sm border">{s}</span>)}
        </p>
      </div>
    ))}
  </div>
</section>
