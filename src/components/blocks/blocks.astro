---
/*
  A page made of blocks (docs/v4/themes.md, src/lib/page-blocks.mjs): its column, narrow for
  reading or wide for grids, its heading unless it hides it, then its blocks in rows. A full block
  is a row of its own; halves and thirds share a row on wide screens, lined up at the top, and stack
  on a phone, in the same order, which is also the order screen readers read them in. A block the site doesn't know is
  left out, and one that fails is left out and logged (frame.astro). Anything in the slot goes
  above the heading.
*/
import { rowsOf, type BlockKind, type Page } from '~/lib/page-blocks.mjs';
import type { PageData } from '~/lib/page-data';
import Frame from './frame.astro';
import callToAction from './callToAction.astro';
import links from './links.astro';
import markdown from './markdown.astro';
import now from './now.astro';
import profile from './profile.astro';
import projects from './projects.astro';
import recentPosts from './recentPosts.astro';
import testimonials from './testimonials.astro';
import thisWeek from './thisWeek.astro';

interface Props {
  page: Page;
  data: PageData;
}
const { page, data } = Astro.props;

// Each kind of block's component (src/lib/page-blocks.mjs's BLOCKS has how each is read). A new kind
// is a def in lexicons/id/skiddle/page.json, an entry in BLOCKS and a component here, which
// scripts/page-blocks.test.mjs checks
const BLOCK_COMPONENTS = { profile, markdown, links, now, thisWeek, projects, recentPosts, testimonials, callToAction } satisfies Record<BlockKind, unknown>;
const COLUMN = { narrow: 'max-w-[70ch] w-full', wide: 'max-w-[56rem] w-full' };
// Blocks side by side line up at the top: the row has the space above it, not each block. A block
// that shows nothing (it failed, or This week is empty) leaves no gap.
const CELL = '*:mt-0 [&:not(:has(>*))]:hidden';
const SPAN = { full: '', half: `sm:col-span-3 ${CELL}`, third: `sm:col-span-2 ${CELL}` };
const rows = rowsOf(page.blocks).map((row) => row.map((placed) => ({ placed, Block: BLOCK_COMPONENTS[placed.block.kind] })));
---

<div class={COLUMN[page.width]}>
  <slot />
  {!page.hideHeading && <h1 class="font-semibold text-xl before-hash-1">{page.title}</h1>}
  {rows.map((row) =>
    row[0].placed.width === 'full' ? (
      row.map(({ placed, Block }) => (
        <Frame kind={placed.block.kind}><Block block={placed.block} anchor={placed.anchor} data={data} /></Frame>
      ))
    ) : (
      <div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-6 mt-12">
        {row.map(({ placed, Block }) => (
          <div class={SPAN[placed.width]}>
            <Frame kind={placed.block.kind}><Block block={placed.block} anchor={placed.anchor} data={data} /></Frame>
          </div>
        ))}
      </div>
    ),
  )}
</div>
