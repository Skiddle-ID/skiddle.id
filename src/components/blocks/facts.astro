---
/*
  The facts block (src/lib/page-blocks.mjs): Jeff's avatar beside facts about him, as neofetch
  prints them, with colour blocks that double as the accent picker (the same setting as the
  sidebar's; the About page's script runs them, as the home page's runs the profile's status). Its
  heading, if it has one, is the page's main heading, above the card.
*/
import type { FactsBlock } from '~/lib/page-blocks.mjs';
import { ACCENTS, DEFAULT_COLORS } from '~/lib/site-theme.mjs';

interface Props {
  block: FactsBlock;
}
const { block } = Astro.props;

// The theme's accent colours (src/style.css's --theme-* variables), today's when it doesn't set them
const accents = ACCENTS.map((id) => ({
  id,
  dark: `var(--theme-dark-${id}, ${DEFAULT_COLORS.dark[id]})`,
  light: `var(--theme-light-${id}, ${DEFAULT_COLORS.light[id]})`,
}));
---

{block.heading && <h1 class="font-semibold text-xl before-hash-1">{block.heading}</h1>}

<section aria-label="Profile" class="card mt-5 p-5 text-sm">
  <p class="prompt text-[var(--color-muted)]" aria-hidden="true">
    <span class="text-[var(--color-primary)]">skiddle@web</span>:~$ neofetch
  </p>
  <div class="mt-4 flex flex-col sm:flex-row gap-6">
    <img src="/avatars/github.jpg" alt="Jeff's avatar" width="140" height="140" class="size-28 sm:size-36 rounded-lg border shrink-0" />
    <div class="min-w-0">
      <p class="font-semibold"><span class="text-[var(--color-primary)]">jeff</span>@<span class="text-[var(--color-primary)]">skiddle</span></p>
      <p class="text-[var(--color-muted)]" aria-hidden="true">------------</p>
      <dl class="mt-1 grid grid-cols-[5.5rem_1fr] gap-x-2 gap-y-0.5">
        {block.facts.map(({ label, value }) => (
          <>
            <dt class="text-[var(--color-primary)] font-semibold">{label}:</dt>
            <dd class="min-w-0">{value}</dd>
          </>
        ))}
      </dl>
      <div class="mt-3 flex gap-1" role="group" aria-label="Pick an accent colour">
        {accents.map((a) => (
          <button
            type="button"
            class="accent-swatch h-4 w-7 rounded-sm border border-transparent hover:scale-110 transition-transform"
            data-accent-choice={a.id}
            style={`--swatch-dark:${a.dark};--swatch-light:${a.light}`}
            aria-label={`Use ${a.id} accent`}
            title={a.id}
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>
