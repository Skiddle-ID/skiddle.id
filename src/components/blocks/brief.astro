---
/*
  The brief block (src/lib/page-blocks.mjs): a box asking about a project, with what to include as a
  list and buttons, each with its icon (linkIcon), the one marked primary in the accent colour.
*/
import Icon from '../icon.astro';
import { linkAttributes, linkIcon, type BriefBlock } from '~/lib/page-blocks.mjs';

interface Props {
  block: BriefBlock;
  anchor?: string;
}
const { block, anchor } = Astro.props;
const links = block.links.map((l) => ({ ...l, ...linkAttributes(l), icon: linkIcon(l.href) }));
---

<section aria-labelledby={anchor} class="mt-12 card p-6">
  <h2 id={anchor} class="font-semibold text-lg">{block.title}</h2>
  {block.text && (
    <p class="text-sm text-[var(--color-muted)] mt-2 max-w-[60ch]">
      {block.text}
    </p>
  )}
  {block.points.length > 0 && (
    <ul class="mt-3 text-sm flex flex-col gap-1">
      {block.points.map((p) => (
        <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span>{p}</li>
      ))}
    </ul>
  )}
  {links.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-5">
      {links.map((l) => (
        <a class={l.primary ? 'btn border-[var(--color-primary)] text-[var(--color-primary)]' : 'btn'} href={l.href} target={l.target} rel={l.rel}>{l.icon ? <><Icon name={l.icon} size={14} /> {l.label}</> : l.label}</a>
      ))}
    </div>
  )}
</section>
