---
/*
  The uses block (src/lib/page-blocks.mjs): its heading, the page's main heading, a lead, how many
  things there are and when the page was last updated, links to jump to each section (they stick to
  the top as the page scrolls), then each section's groups as cards, and a closing line.
*/
import type { Page, UsesBlock } from '~/lib/page-blocks.mjs';
import { lineHtml } from '~/lib/now-html';
import { monthYear } from '~/lib/page-records.mjs';

interface Props {
  block: UsesBlock;
  page: Page;
}
const { block, page } = Astro.props;

const itemCount = block.sections.reduce((n, s) => n + s.groups.reduce((m, g) => m + g.items.length, 0), 0);
const updated = page.updatedAt && monthYear(new Date(page.updatedAt));
---

<header class="max-w-[70ch]">
  <h1 class="font-semibold text-xl before-hash-1">{block.heading}</h1>
  {block.text && (
    <p class="text-sm mt-2 leading-relaxed">
      <Fragment set:html={lineHtml(block.text)} />
    </p>
  )}
  <p class="text-xs text-[var(--color-muted)] mt-3">{itemCount} things{updated && ` · last updated ${updated}`}</p>
</header>

<!-- Jump links -->
<nav aria-label="Sections" class="sticky top-12 lg:top-0 z-10 -mx-5 lg:-mx-10 px-5 lg:px-10 py-3 mt-6 bg-[var(--color-bg)]/95 backdrop-blur border-b border-dashed print:hidden">
  <p class="text-xs flex flex-wrap gap-x-1 gap-y-1.5">
    <span class="text-[var(--color-muted)] mr-1" aria-hidden="true">cd</span>
    {block.sections.map((s) => (
      <a href={`#${s.id}`} class="px-2 py-0.5 rounded-sm border hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-colors">{s.id}/</a>
    ))}
  </p>
</nav>

{block.sections.map((section) => (
  <section id={section.id} aria-labelledby={`${section.id}-title`} class="mt-10 scroll-mt-28 lg:scroll-mt-16">
    <h2 id={`${section.id}-title`} class="font-semibold before-hash-2">{section.title}</h2>
    {section.blurb && <p class="text-sm text-[var(--color-muted)] mt-1">{section.blurb}</p>}
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {section.groups.map((group) => (
        <div class="card p-4">
          <h3 class="text-xs uppercase tracking-wider text-[var(--color-primary)]">{group.title}</h3>
          <ul class="mt-2.5 flex flex-col gap-2 text-sm">
            {group.items.map((item) => (
              <li>
                {item.href
                  ? <a href={item.href} class="link" target="_blank" rel="noopener noreferrer">{item.name}</a>
                  : <span>{item.name}</span>}
                {item.note && <span class="block text-xs text-[var(--color-muted)] mt-0.5">{item.note}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
))}

{block.outro && (
  <p class="mt-12 text-sm text-[var(--color-muted)]">
    <Fragment set:html={lineHtml(block.outro)} />
  </p>
)}
