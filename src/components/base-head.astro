---
// Preload the site font (the same files src/style.css imports) so text doesn't reflow when it arrives
import geistMono400 from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
import geistMono600 from '@fontsource/geist-mono/files/geist-mono-latin-600-normal.woff2?url';
import { PUBLICATION_URI } from '~/lib/standard-site.mjs';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** at:// URI of the page's site.standard.document record (posts only) */
  atDocument?: string;
}

const { title, description, image, type = 'website', atDocument } = Astro.props as Props;
const site = Astro.site;
const canonical = new URL(Astro.url.pathname, site).toString();
const ogTitle = title ?? 'Skiddle';
const ogDesc = description ?? 'Jeff (Skiddle) — protocol engineer in Bangkok, writing about infra, open protocols, homelab and life.';
// Share cards (1200×630 PNG) are rendered at build time by src/integrations/share-cards.ts
const ogImage = image ?? '/og/site.png';
const isCard = ogImage.startsWith('/og/');
const absOgImage = /^https?:\/\//i.test(ogImage) ? ogImage : new URL(ogImage, site).toString();
---

<link rel="preload" href={geistMono400} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={geistMono600} as="font" type="font/woff2" crossorigin />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index,follow" />
<meta name="author" content="Laurensius Jeffrey (Skiddle)" />
<!-- Follows the site theme (dark default); updated by the theme script in shell/sidebar -->
<meta name="theme-color" content="#161616" id="themeColor" />
<link rel="alternate" type="application/rss+xml" title="Skiddle — posts" href="/rss.xml" />
<link rel="me" href="https://bsky.app/profile/skiddle.blue" />
<link rel="me" href="https://github.com/arcestia" />
<!-- Standard.site (AT Protocol): this site's publication record and, on posts, the post's document
     record. See src/lib/standard-site.mjs. -->
<link rel="site.standard.publication" href={PUBLICATION_URI} />
{atDocument && <link rel="site.standard.document" href={atDocument} />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Skiddle" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDesc} />
<meta property="og:image" content={absOgImage} />
{isCard && <meta property="og:image:type" content="image/png" />}
{isCard && <meta property="og:image:width" content="1200" />}
{isCard && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={ogTitle} />

<!-- Twitter / Bluesky -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDesc} />
<meta name="twitter:image" content={absOgImage} />

<!-- Icons -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
