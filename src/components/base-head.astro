---
// Preload the site font (the same files src/style.css imports) so text doesn't reflow when it arrives
import geistMono400 from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
import geistMono600 from '@fontsource/geist-mono/files/geist-mono-latin-600-normal.woff2?url';
// Posts also preload Geist Sans, the font for post text (see .prose-reading in src/style.css)
import geist400 from '@fontsource/geist/files/geist-latin-400-normal.woff2?url';
import geist600 from '@fontsource/geist/files/geist-latin-600-normal.woff2?url';
import { PUBLICATION_URI } from '~/lib/standard-site.mjs';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** at:// URI of the page's site.standard.document record (posts only) */
  atDocument?: string;
  /** The page's own RSS feed (a series'), linked next to the site's */
  feed?: { title: string; href: string };
  /** The page's keywords, then the site's (src/lib/site-meta.mjs) */
  keywords?: string[];
  /** Ask search engines not to list it */
  noindex?: boolean;
  /** From the site's metadata (id.skiddle.site) */
  siteName?: string;
  author?: string;
  /** Jeff's profiles elsewhere, linked as his (rel="me") */
  profiles?: string[];
  /** The site's icon from its metadata: blob CIDs, served at /media/<cid>. Without it, the icons in /public */
  icon?: { png32: string; png180: string; png192: string; png512: string };
}

const {
  title,
  description,
  image,
  type = 'website',
  atDocument,
  feed,
  keywords = [],
  noindex = false,
  siteName = 'Skiddle',
  author = 'Laurensius Jeffrey (Skiddle)',
  profiles = ['https://bsky.app/profile/skiddle.blue', 'https://github.com/arcestia'],
  icon,
} = Astro.props as Props;
const site = Astro.site;
const canonical = new URL(Astro.url.pathname, site).toString();
const ogTitle = title ?? 'Skiddle';
const ogDesc = description ?? 'Jeff (Skiddle) — protocol engineer in Bangkok, writing about infra, open protocols, homelab and life.';
// Share cards (1200×630 PNG) are rendered at build time by src/integrations/share-cards.ts;
// the shell layout picks the page's card (see shareImage there)
const ogImage = image ?? '/og/site.png';
const isCard = ogImage.startsWith('/og/');
const absOgImage = /^https?:\/\//i.test(ogImage) ? ogImage : new URL(ogImage, site).toString();
---

<link rel="preload" href={geistMono400} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={geistMono600} as="font" type="font/woff2" crossorigin />
{type === 'article' && <link rel="preload" href={geist400} as="font" type="font/woff2" crossorigin />}
{type === 'article' && <link rel="preload" href={geist600} as="font" type="font/woff2" crossorigin />}
<link rel="canonical" href={canonical} />
<!-- Preview builds (pull requests, which can show drafts) stay out of search engines -->
<meta name="robots" content={__PREVIEW__ ? 'noindex,nofollow' : noindex ? 'noindex,follow' : 'index,follow'} />
<!-- The commit this page was built from: lets CI tell which commit a preview serves (tests/wait-for-preview.mjs) -->
<meta name="build" content={__GIT_HASH__} />
<meta name="author" content={author} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<!-- Text and data mining reserved (W3C TDMRep): no AI training on this writing, see LICENSE-CONTENT.md -->
<meta name="tdm-reservation" content="1" />
<!-- Follows the site theme (dark default); updated by the theme script in shell/sidebar -->
<meta name="theme-color" content="#161616" id="themeColor" />
<link rel="alternate" type="application/rss+xml" title={`${siteName} — posts`} href="/rss.xml" />
{feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />}
{profiles.map((href) => <link rel="me" href={href} />)}
<!-- Standard.site (AT Protocol): this site's publication record and, on posts, the post's document
     record. See src/lib/standard-site.mjs. -->
<link rel="site.standard.publication" href={PUBLICATION_URI} />
{atDocument && <link rel="site.standard.document" href={atDocument} />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDesc} />
<meta property="og:image" content={absOgImage} />
{isCard && <meta property="og:image:type" content="image/png" />}
{isCard && <meta property="og:image:width" content="1200" />}
{isCard && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={ogTitle} />

<!-- Twitter / Bluesky -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDesc} />
<meta name="twitter:image" content={absOgImage} />

<!-- Icons -->
{
  icon ? (
    <>
      <link rel="icon" href={`/media/${icon.png32}`} type="image/png" sizes="32x32" />
      <link rel="icon" href={`/media/${icon.png192}`} type="image/png" sizes="192x192" />
      <link rel="apple-touch-icon" href={`/media/${icon.png180}`} />
    </>
  ) : (
    <>
      <link rel="icon" href="/favicon.ico" sizes="any" />
      <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    </>
  )
}
