---
import { isExternal, type SiteLink } from '~/lib/site-meta.mjs';

interface Props {
  /** The footer's links, from the id.skiddle.site record or the built-in ones (src/data/frame.ts) */
  links: SiteLink[];
}
const { links } = Astro.props;
const year = new Date().getFullYear();
const hash = __GIT_HASH__;
const tag = __GIT_TAG__;
const describe = __GIT_DESCRIBE__;
const m = /^(?<tag>.+)-(?<distance>\d+)-g(?<short>[0-9a-f]+)$/.exec(describe ?? '');
const versionTag = m?.groups?.tag || tag;
const repo = 'https://github.com/Skiddle-ID/skiddle.id';
const linkCls = 'decoration-wavy underline underline-offset-2 hover:text-[var(--color-primary)]';
---
<footer class="px-5 lg:px-10 py-6 text-xs text-[var(--color-muted)] lg:text-center print:hidden">
  <p>© {year} Laurensius Jeffrey · <span class="whitespace-nowrap">Skiddle Labs Pte. Ltd.</span></p>
  <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 lg:justify-center">
    <span>
      {versionTag ? (
        <a target="_blank" rel="noopener" href={`${repo}/releases/tag/${versionTag}`} class={linkCls}>{versionTag}</a>
      ) : (
        // No tag reachable (e.g. git info unavailable at build): fall back to the commit
        <a target="_blank" rel="noopener" href={`${repo}/commit/${m?.groups?.short || hash}`} class={linkCls}>{m?.groups?.short || hash}</a>
      )}
    </span>
    <span aria-hidden="true">·</span>
    {links.map((l) => (
      <Fragment>
        {' '}<a href={l.href} target={isExternal(l.href) ? '_blank' : undefined} rel={isExternal(l.href) ? 'noopener' : undefined} class={linkCls}>{l.label}</a>
      </Fragment>
    ))}
  </div>
  <p class="mt-1">
    <a href={`${repo}/blob/v4/LICENSE-CONTENT.md`} target="_blank" rel="noopener" class={linkCls}>writing: all rights reserved</a>
    <span aria-hidden="true"> · </span>
    <a href={`${repo}/blob/v4/LICENSE`} target="_blank" rel="noopener" class={linkCls}>code: MIT</a>
  </p>
</footer>
