---
const year = new Date().getFullYear();
const hash = __GIT_HASH__;
const tag = __GIT_TAG__;
const describe = __GIT_DESCRIBE__;
const m = /^(?<tag>.+)-(?<distance>\d+)-g(?<short>[0-9a-f]+)$/.exec(describe ?? '');
const versionTag = m?.groups?.tag || tag;
const repo = 'https://github.com/Skiddle-ID/skiddle.id';
const linkCls = 'decoration-wavy underline underline-offset-2 hover:text-[var(--color-primary)]';
---
<footer class="px-5 lg:px-10 py-6 text-xs text-[var(--color-muted)] print:hidden">
  <div class="max-w-[70ch] lg:mx-0 flex flex-wrap gap-x-3 gap-y-1">
    <span>© {year} Laurensius Jeffrey</span>
    <span aria-hidden="true">·</span>
    <span>
      {versionTag ? (
        <a target="_blank" rel="noopener" href={`${repo}/releases/tag/${versionTag}`} class={linkCls}>{versionTag}</a>
      ) : null}{versionTag ? '+' : ''}<a target="_blank" rel="noopener" href={`${repo}/commit/${m?.groups?.short || hash}`} class={linkCls}>{m?.groups?.short || hash}</a>
    </span>
    <span aria-hidden="true">·</span>
    <a href="/rss.xml" class={linkCls}>rss</a>
    <a href="mailto:work@skiddle.id" class={linkCls}>work@skiddle.id</a>
    <a href={repo} target="_blank" rel="noopener" class={linkCls}>source</a>
  </div>
</footer>
