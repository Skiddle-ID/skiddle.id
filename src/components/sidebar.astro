    <!-- Primary color picker -->
    <div class="relative">
      <button
        id="primaryToggle"
        class="inline-flex items-center justify-center size-8 hover:text-[var(--color-primary)] hover:bg-[var(--color-bg-alt)] rounded leading-none p-0 transition-colors"
        type="button"
        title="Change primary color"
        aria-haspopup="true"
        aria-expanded="false">
        <span class="sr-only">Change primary color</span>
        <span id="primarySwatch" class="inline-block size-5 rounded-full border border-border" style="background-color: var(--color-primary);"></span>
      </button>
      <div id="primaryMenu" class="hidden absolute left-0 mt-2 w-14 rounded-xl bg-[var(--color-bg-alt)] border border-border p-2 shadow-lg">
        <ul class="flex flex-col gap-2" role="menu" aria-label="Primary color choices">
          <li>
            <button data-color="var(--color-base0B)" class="size-5 rounded-full block" style="background-color: var(--color-base0B);" title="Blue" aria-label="Blue"></button>
