    <span class="text-[var(--color-muted)]">skiddle</span><span class="text-[var(--color-primary)]">@web</span><span class="text-[var(--color-muted)]"> ~</span>
    <div class="cursor-blink"></div>
  </div>

  <!-- Nav links -->
  <div class="flex flex-col gap-0.5">
    <a class="hover:text-[var(--color-primary)] py-1 px-2 rounded text-sm transition-colors" href="/posts">posts</a>
    <a class="hover:text-[var(--color-primary)] py-1 px-2 rounded text-sm transition-colors" href="/about">about</a>
    <a class="hover:text-[var(--color-primary)] py-1 px-2 rounded text-sm transition-colors" href="/works">works</a>
    <a class="hover:text-[var(--color-primary)] py-1 px-2 rounded text-sm transition-colors" href="/projects">projects</a>
    <a class="hover:text-[var(--color-primary)] py-1 px-2 rounded text-sm transition-colors" href="/services">services</a>
    <a class="hover:text-[var(--color-primary)] py-1 px-2 rounded text-sm transition-colors" href="/uses">uses</a>
    <a class="hover:text-[var(--color-primary)] py-1 px-2 rounded text-sm transition-colors" href="/rss.xml">rss</a>
