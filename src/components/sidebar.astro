  <!-- Search -->
  <form action="/posts" method="get" class="mt-3 px-2">
    <label class="sr-only" for="siteSearch">Search</label>
    <input
      id="siteSearch"
      type="search"
      name="q"
      placeholder="Search posts..."
      class="h-8 w-full bg-[var(--color-bg-alt)] border border-border rounded-md px-3 text-sm placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-primary)] transition-colors" />
  </form>

  <!-- Bottom controls: theme + colors + socials -->
  <div class="mt-auto flex items-center gap-2 pt-2 border-t border-border">
    <button
      id="themeToggle"
      class="inline-flex items-center justify-center size-8 hover:text-[var(--color-primary)] hover:bg-[var(--color-bg-alt)] rounded leading-none p-0 transition-colors"
      type="button"
      title="Toggle theme"
      aria-label="Toggle theme"
      aria-pressed="false">
      <span class="sr-only">Toggle theme</span>
      <i id="themeIcon" class="fa-solid fa-sun text-[18px]" aria-hidden="true"></i>
