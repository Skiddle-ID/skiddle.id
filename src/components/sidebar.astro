---
import Icon from './icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/posts/', label: 'posts' },
  { href: '/about/', label: 'about' },
  { href: '/works/', label: 'works' },
  { href: '/projects/', label: 'projects' },
  { href: '/uses/', label: 'uses' },
  { href: '/services/', label: 'services' },
];
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '');
  return path === h || path.startsWith(h + '/') || (h === '/posts' && path.startsWith('/topics'));
};
---

<nav id="sidebar" aria-label="Main" class="print:hidden fixed left-0 top-12 lg:top-0 h-[calc(100dvh-3rem)] lg:h-dvh w-56 border-r flex flex-col gap-1 p-5 z-40 lg:z-20 -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-out bg-[var(--color-bg)] overflow-y-auto">
  <a href="/" class="hidden lg:flex items-center gap-1.5 text-[var(--color-primary)] mb-5">
    <span>skiddle@web ~</span><span class="cursor-blink" aria-hidden="true"></span>
  </a>

  <ul class="flex flex-col">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          aria-current={isActive(l.href) ? 'page' : undefined}
          class:list={[
            'block py-1 px-2 -mx-2 rounded transition-colors hover:text-[var(--color-primary)]',
            isActive(l.href) && 'text-[var(--color-primary)]',
          ]}
        >
          {isActive(l.href) ? <span aria-hidden="true">&gt; </span> : <span aria-hidden="true" class="opacity-0">&gt; </span>}{l.label}
        </a>
      </li>
    ))}
  </ul>

  <!-- Desktop: opens the command bar (components/command-bar.astro); without JavaScript it's a link to /posts/.
       On mobile the search icon in the top bar does this instead. -->
  <a
    href="/posts/"
    data-cmdk-open
    aria-haspopup="dialog"
    aria-keyshortcuts="Meta+K Control+K /"
    class="hidden lg:flex items-center mt-3 py-1 px-2 -mx-2 rounded text-[var(--color-muted)] transition-colors hover:text-[var(--color-primary)]"
  >
    <span aria-hidden="true" class="opacity-0">&gt; </span>search
    <kbd data-cmdk-key class="ml-auto font-[inherit] text-xs border rounded px-1.5 leading-5">⌘K</kbd>
  </a>

  <!-- Now playing (Last.fm) — stays hidden unless a track loads -->
  <a id="nowPlaying" href="https://www.last.fm/user/arcestia" target="_blank" rel="noopener noreferrer" class="hidden mt-5 text-xs leading-snug text-[var(--color-muted)] hover:text-[var(--color-text)] group">
    <span class="flex items-center gap-1.5 mb-1">
      <Icon name="music" size={12} class="text-[var(--color-primary)]" />
      <span id="nowPlayingLabel">last played</span>
    </span>
    <span id="nowPlayingTrack" class="block text-[var(--color-text)] group-hover:text-[var(--color-primary)] line-clamp-2"></span>
    <span id="nowPlayingArtist" class="block line-clamp-1"></span>
  </a>

  <div class="mt-auto pt-4 flex items-center gap-1 text-[var(--color-muted)]">
    <button id="themeToggle" type="button" class="inline-flex items-center justify-center size-8 rounded-full hover:text-[var(--color-primary)]" aria-label="Switch to light theme" title="Toggle theme">
      <span class="theme-icon-dark"><Icon name="sun" /></span>
      <span class="theme-icon-light hidden"><Icon name="moon" /></span>
    </button>
    <button id="accentToggle" type="button" class="inline-flex items-center justify-center size-8 rounded-full text-[var(--color-primary)] hover:scale-110 transition-transform" aria-label="Change accent colour" title="Change accent colour">
      <Icon name="palette" size={16} />
    </button>
    <a class="inline-flex items-center justify-center size-8 rounded-full hover:text-[var(--color-primary)]" href="https://github.com/arcestia" target="_blank" rel="me noopener noreferrer" aria-label="GitHub"><Icon name="github" /></a>
    <a class="inline-flex items-center justify-center size-8 rounded-full hover:text-[var(--color-primary)]" href="https://bsky.app/profile/skiddle.blue" target="_blank" rel="me noopener noreferrer" aria-label="Bluesky"><Icon name="bluesky" /></a>
    <a class="inline-flex items-center justify-center size-8 rounded-full hover:text-[var(--color-primary)]" href="/rss.xml" aria-label="RSS feed"><Icon name="rss" /></a>
  </div>
</nav>

<style>
  :global([data-theme='light']) .theme-icon-dark { display: none; }
  :global([data-theme='light']) .theme-icon-light { display: inline; }
</style>

<script>
  const root = document.documentElement;
  const ACCENTS = ['blue', 'teal', 'purple', 'pink', 'green'];
  const save = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
  const load = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const forget = (k: string) => { try { localStorage.removeItem(k); } catch {} };

  const themeBtn = document.getElementById('themeToggle');
  const systemLight = matchMedia('(prefers-color-scheme: light)');
  const systemTheme = () => (systemLight.matches ? 'light' : 'dark');
  const picked = () => ['light', 'dark'].includes(load('theme') ?? '');
  const syncThemeLabel = () => {
    const light = root.dataset.theme === 'light';
    themeBtn?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
    document.getElementById('themeColor')?.setAttribute('content', light ? '#ffffff' : '#161616');
  };
  syncThemeLabel();
  themeBtn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    // Switching back to the device's own theme means "follow the device" again; otherwise remember it.
    if (next === systemTheme()) forget('theme');
    else save('theme', next);
    syncThemeLabel();
  });
  // Follow the device when it switches light/dark (e.g. automatic at sunset), unless a theme was picked here.
  systemLight.addEventListener('change', () => {
    if (picked()) return;
    root.dataset.theme = systemTheme();
    syncThemeLabel();
  });

  document.getElementById('accentToggle')?.addEventListener('click', () => {
    const i = ACCENTS.indexOf(root.dataset.accent || 'blue');
    const next = ACCENTS[(i + 1) % ACCENTS.length];
    root.dataset.accent = next;
    save('accent', next);
  });

  // Now playing
  (async () => {
    const card = document.getElementById('nowPlaying') as HTMLAnchorElement | null;
    if (!card) return;
    try {
      const res = await fetch('/api/lastfm.json');
      if (!res.ok) return;
      const { track } = await res.json();
      if (!track?.name) return;
      document.getElementById('nowPlayingLabel')!.textContent = track.isCurrent ? 'now playing' : 'last played';
      document.getElementById('nowPlayingTrack')!.textContent = track.name;
      document.getElementById('nowPlayingArtist')!.textContent = track.artist || '';
      if (track.trackUrl) card.href = track.trackUrl;
      card.classList.remove('hidden');
    } catch {}
  })();
</script>
