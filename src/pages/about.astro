---
import Shell from '../layouts/shell.astro';
import Blocks from '../components/blocks/blocks.astro';
import { CONTENT_PAGES } from '~/data/list-pages';
import { blockPage } from '~/lib/block-page';
import { PAGES_CACHE, getAbout } from '~/lib/page-content';
import { aboutPageFromLegacy } from '~/lib/page-legacy.mjs';

// Rendered on request, from blocks: the id.skiddle.page record `about`, or until there is one, the
// page made from the id.skiddle.about record (aboutPageFromLegacy)
export const prerender = false;

const { page, data, preview } = await blockPage(Astro, 'about', async () => aboutPageFromLegacy((await getAbout()).about, CONTENT_PAGES.about, new Date().toISOString()));
if (!preview) Astro.cache.set(PAGES_CACHE);
---

<Shell title={`${page.title} — Skiddle`} description={page.description || undefined} image={page.card && `/media/${page.card}`}>
  <Blocks page={page} data={data} preview={preview} />
</Shell>

<script>
  // The facts block's colour blocks double as an accent picker (same setting as the sidebar dot).
  const root = document.documentElement;
  const swatches = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-accent-choice]'));
  const siteAccent = root.dataset.siteAccent || 'blue';
  const sync = () => swatches.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.accentChoice === (root.dataset.accent || siteAccent))));
  swatches.forEach((b) =>
    b.addEventListener('click', () => {
      root.dataset.accent = b.dataset.accentChoice!;
      // The site's own accent means "follow the site" again
      try {
        if (root.dataset.accent === siteAccent) localStorage.removeItem('accent');
        else localStorage.setItem('accent', root.dataset.accent);
      } catch {}
      sync();
    }),
  );
  new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-accent'] });
  sync();
</script>
