---
import Shell from '../layouts/shell.astro';
import Blocks from '../components/blocks/blocks.astro';
import { CONTENT_PAGES } from '~/data/list-pages';
import { blockPage } from '~/lib/block-page';
import { PAGES_CACHE, getAbout } from '~/lib/page-content';
import { aboutPageFromLegacy } from '~/lib/page-legacy.mjs';

// Rendered on request, from blocks: the id.skiddle.page record `about`, or until there is one, the
// page made from the id.skiddle.about record (aboutPageFromLegacy)
export const prerender = false;

const { page, data, preview } = await blockPage(Astro, 'about', async () => aboutPageFromLegacy((await getAbout()).about, CONTENT_PAGES.about, new Date().toISOString()));
if (!preview) Astro.cache.set(PAGES_CACHE);
---

<Shell title={`${page.title} — Skiddle`} description={page.description || undefined} image={page.card && `/media/${page.card}`}>
  <Blocks page={page} data={data} preview={preview} />
</Shell>

<script>
  import '~/components/blocks/scripts/accent-picker';
</script>
