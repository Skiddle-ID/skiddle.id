---
import Shell from '../layouts/shell.astro';

const birthdate = new Date('1997-08-09T07:00:00Z');
const now = new Date();
let age = now.getUTCFullYear() - birthdate.getUTCFullYear();
if (now < new Date(Date.UTC(now.getUTCFullYear(), birthdate.getUTCMonth(), birthdate.getUTCDate()))) age--;
---

<Shell title="About — Skiddle" description="About Jeff (Skiddle) — night-shift platform engineer in Bangkok, homelabber, open-web fan and student pilot.">
  <div class="max-w-[70ch] w-full">
    <div class="flex items-center gap-4 mb-8">
      <img src="https://github.com/arcestia.png?size=160" alt="Jeff's avatar" width="72" height="72" class="size-18 rounded-full border shrink-0" />
      <div>
        <h1 class="font-semibold text-xl before-hash-1">About me</h1>
        <p class="text-sm text-[var(--color-muted)] mt-1">Bangkok · <span id="age" data-birthdate={birthdate.toISOString()}>{age}</span> · night person</p>
      </div>
    </div>

    <div class="prose">
      <p>
        I'm <strong>Jeff</strong>, known online as <strong>Skiddle</strong>. I work the night shift as a platform
        engineer in Bangkok: building platforms, automating ops, and keeping infrastructure running across cloud
        and my homelab.
      </p>

      <h2>What I do</h2>
      <p>
        Most days I'm working with <code>Go</code>, <code>PHP/Laravel</code>, <code>Node.js</code>,
        <code>Postgres</code>/<code>MariaDB</code>/<code>Redis</code> and <code>Docker</code>/<code>Kubernetes</code>,
        on <code>Cloudflare</code>, <code>AWS</code> and self-hosted hardware.
      </p>
      <p>
        I like shipping small tools that remove toil. Reliability, security and cost all matter to me, and my default
        answer is usually "can we automate that?". The longer version is on my <a href="/works/">works</a> page, and
        the open-source bits are on <a href="/projects/">projects</a>.
      </p>

      <h2>The open web</h2>
      <p>
        I care about open protocols and owning your own data. I'm into ATProto, I'm on Bluesky as
        <a href="https://bsky.app/profile/skiddle.blue" rel="me">@skiddle.blue</a>, and I run as much as I can myself.
        This site is where I write about what I'm building, what I'm learning, and sometimes things that have nothing to
        do with tech.
      </p>

      <h2>Outside of work</h2>
      <p>
        I have ADHD, and it doesn't stop me doing the work. I game, I read, and I keep odd hours. Right now I'm also
        working toward my Private Pilot License, and I'm writing about that journey on the blog too.
      </p>
      <p>
        Curious what hardware and software I use? It's all on the <a href="/uses/">uses</a> page.
      </p>

      <h2>Say hi</h2>
      <p>
        <a href="https://bsky.app/profile/skiddle.blue" rel="me">Bluesky</a> ·
        <a href="https://github.com/arcestia" rel="me">GitHub</a> ·
        <a href="mailto:jeff@skiddle.id">jeff@skiddle.id</a>
      </p>
    </div>
  </div>
</Shell>

<script>
  // The page is static, so refresh the age in the browser (the build-time value is the fallback).
  const el = document.getElementById('age');
  const born = el?.dataset.birthdate ? new Date(el.dataset.birthdate) : null;
  if (el && born) {
    const now = new Date();
    let age = now.getUTCFullYear() - born.getUTCFullYear();
    if (now < new Date(Date.UTC(now.getUTCFullYear(), born.getUTCMonth(), born.getUTCDate()))) age--;
    el.textContent = String(age);
  }
</script>
