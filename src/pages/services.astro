---
import Shell from '../layouts/shell.astro';
import Blocks from '../components/blocks/blocks.astro';
import { CONTENT_PAGES } from '~/data/list-pages';
import { blockPage } from '~/lib/block-page';
import { PAGES_CACHE, getCv } from '~/lib/page-content';
import { servicesPageFromLegacy } from '~/lib/page-legacy.mjs';
import { scriptJson } from '~/lib/script-json.mjs';

// Rendered on request, from blocks: the id.skiddle.page record `services`, or until there is one,
// the page as it was laid out before blocks, with the CV's highlights (servicesPageFromLegacy). The
// services and testimonials are the id.skiddle.services record's.
export const prerender = false;

const { page, data, preview } = await blockPage(Astro, 'services', async () => servicesPageFromLegacy((await getCv()).highlights, CONTENT_PAGES.services, new Date().toISOString()));
if (!preview) Astro.cache.set(PAGES_CACHE);

// The services as structured data, when the page shows them
const site = Astro.site!;
const services = page.blocks.some((b) => b.block.kind === 'services') ? (await data.services()).services : [];
const jsonLd = services.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${page.title} — Skiddle`,
  url: new URL('/services/', site).toString(),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'Service',
      position: i + 1,
      name: s.name,
      description: s.description,
      serviceType: s.category,
      provider: {
        '@type': 'Organization',
        name: 'Skiddle Labs Pte. Ltd.',
        url: site.toString(),
        founder: { '@type': 'Person', name: 'Laurensius Jeffrey', alternateName: 'Skiddle' },
      },
    })),
  },
};
---

<Shell title={`${page.title} — Skiddle`} description={page.description || undefined} image={page.card && `/media/${page.card}`}>
  {jsonLd && <script type="application/ld+json" set:html={scriptJson(jsonLd)} />}
  <Blocks page={page} data={data} preview={preview} />
</Shell>

<script>
  import '~/components/blocks/scripts/reviews';
</script>
