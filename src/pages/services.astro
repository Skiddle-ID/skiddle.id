---
import Shell from '../layouts/shell.astro';
import Blocks from '../components/blocks/blocks.astro';
import { CONTENT_PAGES } from '~/data/list-pages';
import { blockPage } from '~/lib/block-page';
import { PAGES_CACHE, getCv } from '~/lib/page-content';
import { servicesPageFromLegacy } from '~/lib/page-legacy.mjs';
import { scriptJson } from '~/lib/script-json.mjs';

// Rendered on request, from blocks: the id.skiddle.page record `services`, or until there is one,
// the page as it was laid out before blocks, with the CV's highlights (servicesPageFromLegacy). The
// services and testimonials are the id.skiddle.services record's.
export const prerender = false;

const { page, data, preview } = await blockPage(Astro, 'services', async () => servicesPageFromLegacy((await getCv()).highlights, CONTENT_PAGES.services, new Date().toISOString()));
if (!preview) Astro.cache.set(PAGES_CACHE);

// The services as structured data, when the page shows them
const site = Astro.site!;
const services = page.blocks.some((b) => b.block.kind === 'services') ? (await data.services()).services : [];
const jsonLd = services.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${page.title} — Skiddle`,
  url: new URL('/services/', site).toString(),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'Service',
      position: i + 1,
      name: s.name,
      description: s.description,
      serviceType: s.category,
      provider: {
        '@type': 'Organization',
        name: 'Skiddle Labs Pte. Ltd.',
        url: site.toString(),
        founder: { '@type': 'Person', name: 'Laurensius Jeffrey', alternateName: 'Skiddle' },
      },
    })),
  },
};
---

<Shell title={`${page.title} — Skiddle`} description={page.description || undefined} image={page.card && `/media/${page.card}`}>
  {jsonLd && <script type="application/ld+json" set:html={scriptJson(jsonLd)} />}
  <Blocks page={page} data={data} preview={preview} />
</Shell>

<script>
  import { slider } from '~/lib/slider';

  // The reviews block's slider, chips and "Read more" (src/components/blocks/reviews.astro)
  const root = document.querySelector<HTMLElement>('[data-testimonials]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const filters = root.querySelector<HTMLElement>('[data-filters]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];

    // Cut long quotes at 7 lines, with "Read more" on the ones that were cut
    for (const card of cards) {
      const quote = card.querySelector<HTMLElement>('[data-quote]');
      const more = card.querySelector<HTMLButtonElement>('[data-read-more]');
      if (!quote || !more) continue;
      quote.classList.add('is-clamped');
      if (quote.scrollHeight <= quote.clientHeight + 1) {
        quote.classList.remove('is-clamped');
        continue;
      }
      more.hidden = false;
      more.addEventListener('click', () => {
        const open = quote.classList.toggle('is-clamped') === false;
        more.textContent = open ? 'Show less' : 'Read more';
        more.setAttribute('aria-expanded', String(open));
      });
    }

    const row = slider(root);
    const choose = (key: string) => {
      for (const c of cards) c.hidden = !!key && c.dataset.service !== key;
      for (const b of buttons) b.setAttribute('aria-pressed', String((b.dataset.filter ?? '') === key));
      row.refresh();
    };
    if (filters) filters.hidden = false;
    for (const b of buttons) b.addEventListener('click', () => choose(b.dataset.filter ?? ''));
    // A service card's "★ 5.0 · 1 review" shows just that service's
    for (const a of document.querySelectorAll<HTMLElement>('[data-show-reviews]')) a.addEventListener('click', () => choose(a.dataset.showReviews ?? ''));
  }
</script>
