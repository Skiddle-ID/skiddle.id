---
import Shell from '../layouts/shell.astro';
import Icon from '../components/icon.astro';
import { CONTENT_PAGES } from '~/data/list-pages';
import { PAGES_CACHE, getCv, getServices } from '~/lib/page-content';
import { ratingSummary, reviews, serviceAnchor, serviceKey, serviceOf, stars, testimonialGroups } from '~/lib/testimonials.mjs';

// Rendered on request: the services and the CV's highlights come from their records (src/lib/page-content.ts)
export const prerender = false;

const [{ services: data }, { highlights: proof }] = await Promise.all([getServices(), getCv()]);
Astro.cache.set(PAGES_CACHE);

const site = Astro.site!;
const pageUrl = new URL('/services/', site).toString();
const services = data.services;
const testimonials = data.testimonials;
// What the testimonials are about, for the filter and the service cards' "★ 5.0 · 1 review"
const summary = ratingSummary(testimonials);
const groups = testimonialGroups(testimonials, services);
const groupOf = (name: string) => groups.find((g) => g.key === serviceKey(name));
// The first few testimonials show, the rest behind "Show more" (the script below); the filter only
// appears once there are more than that, about more than one thing
const SHOWN = 6;
const filterable = testimonials.length > SHOWN && groups.length > 1;

const email = 'work@skiddle.id';
const mailto = (subject: string, body?: string) =>
  `mailto:${email}?subject=${encodeURIComponent(subject)}${body ? `&body=${encodeURIComponent(body)}` : ''}`;
const briefTemplate = [
  'Hi Jeff,',
  '',
  'What I need help with:',
  '',
  'Goal / what "done" looks like:',
  '',
  'Timeline:',
  '',
  'Current setup and constraints:',
  '',
].join('\n');


const steps = [
  { title: 'Tell me about it', body: 'Email what you need, your goal, timeline and constraints. The template below helps.' },
  { title: 'Get a plan', body: 'I reply with next steps and a lightweight plan, so you know what you’re getting before we start.' },
  { title: 'Build it', body: 'I set it up, keep you posted, and stick to what we agreed.' },
  { title: 'Hand over', body: 'You get notes on what was set up and how to run it, so you’re not dependent on me.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Services — Skiddle',
  url: pageUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'Service',
      position: i + 1,
      name: s.name,
      description: s.description,
      serviceType: s.category,
      provider: {
        '@type': 'Organization',
        name: 'Skiddle Labs Pte. Ltd.',
        url: site.toString(),
        founder: { '@type': 'Person', name: 'Laurensius Jeffrey', alternateName: 'Skiddle' },
      },
    })),
  },
};
---

<Shell title={`${CONTENT_PAGES.services.title} — Skiddle`} description={CONTENT_PAGES.services.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="max-w-[56rem] w-full">

    <!-- Pitch -->
    <header class="max-w-[70ch]">
      <h1 class="font-semibold text-xl before-hash-1">Services</h1>
      <p class="mt-3 leading-relaxed">
        Infrastructure that's secure, automated and boring in the best way, so you can get back to your product.
      </p>
      <p class="text-sm text-[var(--color-muted)] mt-2 leading-relaxed">
        I help small teams and individuals with servers, pipelines, monitoring and self-hosting. If you don't see exactly
        what you need, ask anyway and we'll figure it out.
      </p>
      <p class="text-sm text-[var(--color-muted)] mt-2 leading-relaxed">
        Client work runs through <span class="text-[var(--color-text)]">Skiddle Labs Pte. Ltd.</span>, my own company.
      </p>
      <p class="text-xs text-[var(--color-muted)] mt-4 flex items-center gap-2">
        <span class="size-2 rounded-full bg-[var(--color-ok)] shrink-0" aria-hidden="true"></span>
        Open to consulting · based in Bangkok (UTC+7)
      </p>
      <div class="flex flex-wrap gap-2 mt-5">
        <a class="btn border-[var(--color-primary)] text-[var(--color-primary)]" href={mailto('Service inquiry from skiddle.id', briefTemplate)}><Icon name="mail" size={14} /> Email {email}</a>
        <a class="btn" href="#services">See what I do</a>
        <a class="btn" href="/works/">View my CV</a>
      </div>
    </header>

    <!-- Proof -->
    <section aria-label="Track record" class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-3">
      {proof.map((p) => (
        <div class="card p-4">
          <p class="text-lg font-semibold text-[var(--color-primary)]">{p.value}</p>
          <p class="text-xs text-[var(--color-muted)] mt-1 leading-relaxed">
            {p.label}{p.href && <> <a href={p.href} class="link">story</a></>}
          </p>
        </div>
      ))}
    </section>

    <!-- Services -->
    <section id="services" aria-labelledby="services-title" class="mt-12 scroll-mt-16">
      <h2 id="services-title" class="font-semibold before-hash-2">What I can help with</h2>
      <p class="text-xs text-[var(--color-muted)] mt-1" aria-hidden="true">
        <span class="text-[var(--color-primary)]">skiddle@web</span>:~$ ls services/
      </p>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {services.map((svc, i) => (
          <article id={serviceAnchor(svc.name)} class="card p-5 flex flex-col scroll-mt-16 hover:border-[var(--color-primary)] transition-colors">
            <header class="flex items-baseline justify-between gap-3">
              <h3 class="font-semibold text-[var(--color-primary)]">{svc.name}</h3>
              <span class="text-xs text-[var(--color-muted)] tabular-nums shrink-0" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </header>
            {svc.category && <p class="text-[11px] uppercase tracking-wider text-[var(--color-muted)] mt-1">{svc.category}</p>}
            <p class="text-sm mt-3 leading-relaxed">{svc.description}</p>
            {svc.features && svc.features.length > 0 && (
              <ul class="mt-3 text-sm flex flex-col gap-1">
                {svc.features.map((f) => (
                  <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-ok)]">✓</span><span>{f}</span></li>
                ))}
              </ul>
            )}
            <p class="mt-auto pt-4 text-sm flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <a href={mailto(`Inquiry: ${svc.name}`, briefTemplate)} class="link">Ask about this →</a>
              {(() => {
                const g = groupOf(svc.name);
                return g?.summary && (
                  <a href="#kind-words" data-show-reviews={g.key} class="text-xs text-[var(--color-muted)] hover:text-[var(--color-primary)]">
                    <span class="text-[var(--color-warn)]" aria-hidden="true">★</span> {g.summary.average} · {reviews(g.count)}
                  </a>
                );
              })()}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- Process -->
    <section aria-labelledby="process" class="mt-12">
      <h2 id="process" class="font-semibold before-hash-2">How it works</h2>
      <ol class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="card p-4">
            <p class="text-xs text-[var(--color-primary)] font-semibold">step {i + 1}</p>
            <h3 class="font-semibold mt-1">{s.title}</h3>
            <p class="text-xs text-[var(--color-muted)] mt-1.5 leading-relaxed">{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <!--
      Testimonials, in the record's order (drag them in the admin app to reorder). Quotes of any
      length pack into columns. With JavaScript: chips to show one service's, and "Show more" past
      the first few. Without it, every one shows.
    -->
    {testimonials.length > 0 && (
      <section id="kind-words" aria-labelledby="kind-words-title" class="mt-12 scroll-mt-16" data-testimonials data-shown={SHOWN}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id="kind-words-title" class="font-semibold before-hash-2">What people say</h2>
          {summary && (
            <p class="text-xs text-[var(--color-muted)]">
              <span class="text-[var(--color-warn)]" aria-hidden="true">★</span> {summary.average} average · {reviews(summary.count)}
            </p>
          )}
        </div>
        {/* One row that scrolls sideways on a phone, so the chips don't push the testimonials down; wrapped on wider screens */}
        {filterable && (
          <div class="mt-3 -mx-1 px-1 pb-1 flex gap-2 overflow-x-auto md:flex-wrap md:overflow-visible [scrollbar-width:thin]" role="group" aria-label="Show testimonials about" data-filters hidden>
            <button type="button" class="btn shrink-0 whitespace-nowrap aria-pressed:border-[var(--color-primary)] aria-pressed:text-[var(--color-primary)]" aria-pressed="true" data-filter="">All <span class="text-[var(--color-muted)] tabular-nums">{testimonials.length}</span></button>
            {groups.map((g) => (
              <button type="button" class="btn shrink-0 whitespace-nowrap aria-pressed:border-[var(--color-primary)] aria-pressed:text-[var(--color-primary)]" aria-pressed="false" data-filter={g.key}>{g.label} <span class="text-[var(--color-muted)] tabular-nums">{g.count}</span></button>
            ))}
          </div>
        )}
        <div class="mt-4 columns-1 md:columns-2 lg:columns-3 gap-3" data-list aria-live="polite">
          {testimonials.map((t, i) => {
            const service = serviceOf(services, t.serviceName);
            return (
              <figure class="card p-5 mb-3 break-inside-avoid" data-service={serviceKey(service?.name ?? t.serviceName ?? '')} data-index={i}>
                <p class="text-[var(--color-warn)] text-sm tracking-[0.15em]" role="img" aria-label={`${t.rating} out of 5 stars`}>{stars(t.rating)}</p>
                <blockquote class="text-sm leading-relaxed mt-2">“{t.quote}”</blockquote>
                <figcaption class="pt-4 text-xs text-[var(--color-muted)]">
                  <span class="block text-[var(--color-text)]">{t.author}</span>
                  {t.role}
                  {service ? (
                    <a href={`#${serviceAnchor(service.name)}`} class="block mt-1 text-[var(--color-primary)] hover:underline">{service.name}</a>
                  ) : (
                    t.serviceName && <span class="block mt-1 text-[var(--color-primary)]">{t.serviceName}</span>
                  )}
                </figcaption>
              </figure>
            );
          })}
        </div>
        <button type="button" class="btn" data-more hidden></button>
      </section>
    )}

    <!-- Contact -->
    <section aria-labelledby="contact" class="mt-12 card p-6">
      <h2 id="contact" class="font-semibold text-lg">Tell me about your project</h2>
      <p class="text-sm text-[var(--color-muted)] mt-2 max-w-[60ch]">
        A few lines is plenty. The email button opens with a short template so you don't have to think about what to include:
      </p>
      <ul class="mt-3 text-sm flex flex-col gap-1">
        <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span>what you need help with</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span>what "done" looks like</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span>your timeline</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span>your current setup and any constraints</li>
      </ul>
      <div class="flex flex-wrap gap-2 mt-5">
        <a class="btn border-[var(--color-primary)] text-[var(--color-primary)]" href={mailto('Service inquiry from skiddle.id', briefTemplate)}><Icon name="mail" size={14} /> Email {email}</a>
        <a class="btn" href="https://bsky.app/profile/skiddle.blue" target="_blank" rel="noopener"><Icon name="bluesky" size={14} /> Or say hi on Bluesky</a>
      </div>
    </section>
  </div>
</Shell>

<script>
  // The testimonials' filter and "Show more" (the section above). Without this, every one shows.
  const root = document.querySelector<HTMLElement>('[data-testimonials]');
  if (root) {
    // The first few show (data-shown); the rest wait behind "Show more", so a long list doesn't bury the contact form
    const SHOWN = Number(root.dataset.shown) || 6;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-list] > figure')];
    const filters = root.querySelector<HTMLElement>('[data-filters]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const more = root.querySelector<HTMLButtonElement>('[data-more]')!;
    let current = '';
    let all = false;

    const render = () => {
      const matching = cards.filter((c) => !current || c.dataset.service === current);
      const visible = all ? matching : matching.slice(0, SHOWN);
      for (const c of cards) c.hidden = !visible.includes(c);
      const rest = matching.length - visible.length;
      more.hidden = rest <= 0;
      more.textContent = `Show ${rest} more`;
      for (const b of buttons) b.setAttribute('aria-pressed', String((b.dataset.filter ?? '') === current));
    };
    const choose = (key: string) => {
      current = key;
      all = false;
      render();
    };

    if (filters) filters.hidden = false;
    for (const b of buttons) b.addEventListener('click', () => choose(b.dataset.filter ?? ''));
    more.addEventListener('click', () => {
      const first = cards.find((c) => c.hidden && (!current || c.dataset.service === current));
      all = true;
      render();
      // Keyboard users carry on from the first one that appeared
      if (first) {
        first.tabIndex = -1;
        first.focus({ preventScroll: true });
      }
    });
    // A service card's "★ 5.0 · 1 review" shows just that service's
    for (const a of document.querySelectorAll<HTMLElement>('[data-show-reviews]')) a.addEventListener('click', () => choose(a.dataset.showReviews ?? ''));
    render();
  }
</script>
