---
export const prerender = true;
import Shell from '~/layouts/shell.astro';
import PostList from '~/components/post-list.astro';
import { getPosts, categoryLabels } from '~/lib/posts';

const posts = await getPosts();
const cats = (Object.keys(categoryLabels) as (keyof typeof categoryLabels)[])
  .map((id) => ({ id, label: categoryLabels[id], posts: posts.filter((p) => p.data.category === id) }))
  .filter((c) => c.posts.length > 0);

const tagCount = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCount.set(t.toLowerCase(), (tagCount.get(t.toLowerCase()) || 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Shell title="Topics — Skiddle" description="Browse posts by topic and tag.">
  <div class="max-w-[70ch] w-full">
    <h1 class="font-semibold text-xl before-hash-1">Topics</h1>
    <p class="text-sm text-[var(--color-muted)] mt-2">
      {cats.map((c, i) => (<>{i > 0 && ' · '}<a href={`#${c.id}`} class="hover:text-[var(--color-primary)]">{c.label.toLowerCase()} ({c.posts.length})</a></>))}
    </p>

    {cats.map((c) => (
      <section id={c.id} class="mt-10">
        <h2 class="font-semibold before-hash-2 mb-1">{c.label}</h2>
        <PostList posts={c.posts} />
      </section>
    ))}

    <section class="mt-10">
      <h2 class="font-semibold before-hash-2 mb-2">Tags</h2>
      <p class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
        {tags.map(([t, n]) => <a href={`/topics/tag/${t}/`} class="tag">#{t}<span class="opacity-60"> {n}</span></a>)}
      </p>
    </section>
  </div>
</Shell>
