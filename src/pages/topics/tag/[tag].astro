---
export const prerender = true;
import Shell from '~/layouts/shell.astro';
import PostList from '~/components/post-list.astro';
import { getPosts, type Post } from '~/lib/posts';

export async function getStaticPaths() {
  const all = await getPosts();
  const tags = new Set<string>();
  for (const p of all) for (const t of p.data.tags) tags.add(t.toLowerCase());
  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag, posts: all.filter((p) => p.data.tags.some((t) => t.toLowerCase() === tag)) },
  }));
}

const { tag, posts } = Astro.props as { tag: string; posts: Post[] };
---

<Shell title={`#${tag} — Skiddle`} description={`Posts tagged #${tag} on skiddle.id`}>
  <div class="max-w-[70ch] w-full">
    <p class="text-xs text-[var(--color-muted)] mb-3">
      <a href="/posts/" class="hover:text-[var(--color-primary)]">posts</a>
      <span aria-hidden="true"> / </span>
      <a href="/topics/" class="hover:text-[var(--color-primary)]">topics</a>
    </p>
    <h1 class="font-semibold text-xl">#{tag}</h1>
    <p class="text-sm text-[var(--color-muted)] mt-1">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
    <div class="mt-4">
      <PostList posts={posts} descriptions />
    </div>
  </div>
</Shell>
