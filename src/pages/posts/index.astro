---
export const prerender = true;
import Shell from '~/layouts/shell.astro';
import PostList from '~/components/post-list.astro';
import { getPosts } from '~/lib/posts';

const posts = await getPosts();
const tagCount = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCount.set(t.toLowerCase(), (tagCount.get(t.toLowerCase()) || 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Shell title="Posts — Skiddle" description="Everything I've written: infra, open protocols, homelab notes and life.">
  <div class="max-w-[70ch] w-full">
    <h1 class="font-semibold text-xl before-hash-1">Posts</h1>

    <form action="/posts/" method="get" role="search" class="mt-4 flex gap-2" id="postsSearchForm">
      <label class="sr-only" for="postsSearch">Search posts</label>
      <input id="postsSearch" type="search" name="q" placeholder="search titles, tags, text…" autocomplete="off"
        class="flex-1 h-9 bg-transparent border rounded-md px-3 text-sm placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-primary)]" />
    </form>
    <p id="postsSummary" class="text-xs text-[var(--color-muted)] mt-2" aria-live="polite">{posts.length} posts</p>

    <div class="mt-2">
      <PostList posts={posts} descriptions searchable />
      <p id="postsEmpty" class="hidden py-8 text-sm text-[var(--color-muted)]">Nothing matches that. <a href="/posts/" class="link">Clear search</a></p>
    </div>

    <section class="mt-10">
      <h2 class="font-semibold before-hash-2 mb-2">Browse by tag</h2>
      <p class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
        {tags.map(([t, n]) => <a href={`/topics/tag/${t}/`} class="tag">#{t}<span class="opacity-60"> {n}</span></a>)}
      </p>
      <p class="text-sm mt-3"><a href="/topics/" class="link">or by topic →</a></p>
    </section>
  </div>
</Shell>

<script>
  // Static page, so search runs in the browser (works for ?q= links from the sidebar too).
  const input = document.getElementById('postsSearch') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.post-item'));
  const summary = document.getElementById('postsSummary');
  const empty = document.getElementById('postsEmpty');
  const total = items.length;

  function apply(q: string) {
    const terms = q.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const el of items) {
      const hay = el.dataset.search || '';
      const ok = terms.every((t) => hay.includes(t));
      el.hidden = !ok;
      if (ok) shown++;
    }
    if (summary) summary.textContent = terms.length ? `${shown} of ${total} posts match “${q.trim()}”` : `${total} posts`;
    empty?.classList.toggle('hidden', shown > 0);
  }

  const initial = new URLSearchParams(location.search).get('q') || '';
  if (input) {
    input.value = initial;
    input.addEventListener('input', () => {
      apply(input.value);
      const url = new URL(location.href);
      if (input.value.trim()) url.searchParams.set('q', input.value.trim()); else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    });
  }
  document.getElementById('postsSearchForm')?.addEventListener('submit', (e) => e.preventDefault());
  const sidebarSearch = document.getElementById('siteSearch') as HTMLInputElement | null;
  if (sidebarSearch) sidebarSearch.value = initial;
  apply(initial);
</script>
