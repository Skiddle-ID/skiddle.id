---
export const prerender = true;
import { getCollection } from 'astro:content';
import Shell from '~/layouts/shell.astro';
import FormattedDate from '~/components/formatted-date.astro';

const q = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const all = (await getCollection('posts', ({ data }: any) => !data.draft)).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const filtered = q
  ? all.filter((p: any) => {
      const t = (p.data.title || '').toLowerCase();
      const body = (p.body || '').toLowerCase();
      const tags = (p.data.tags || []).join(' ').toLowerCase();
      return t.includes(q) || body.includes(q) || tags.includes(q);
    })
  : all;

function readingTime(words: number): string {
  return `${Math.max(1, Math.ceil(words / 200))} min`;
}
const withExcerpt = filtered.map((entry: any) => {
  const words = entry.body.split(/\s+/).length;
  const excerpt = entry.data.description || entry.body.slice(0, 180).trimEnd() + '…';
  const slug = entry.slug || entry.id.replace(/\.mdx?$/, '');
  return { entry, words, excerpt, slug };
});
---

<Shell title="Posts — Skiddle">
  <div class="mx-auto max-w-2xl flex flex-col">
    <header class="flex flex-col gap-3">
      <h1 class="font-bold before-hash-1" style="font-family: var(--font-heading)">Posts</h1>
      <form action="/posts" method="get" class="flex gap-2">
        <label class="sr-only" for="postsSearch">Search</label>
        <input id="postsSearch" type="search" name="q" value={q} placeholder="Search title, tags, body..." class="flex-1 h-9 rounded-full px-4 text-sm" style="background:white; border:1px solid var(--color-border); color: var(--color-text)" />
        <button class="h-9 px-4 rounded-full text-sm font-semibold" style="background: var(--color-primary); color:white; border:1px solid var(--color-primary)">Search</button>
        {q && (<a href="/posts" class="h-9 px-4 rounded-full text-sm grid place-items-center" style="background:#eef6ff; border:1px solid var(--color-border); color: var(--color-primary)">Clear</a>)}
      </form>
      <p class="text-base03 mono text-xs">
        { q && (<>Showing {filtered.length} result{filtered.length === 1 ? '' : 's'} for "{q}".</>) }
        { !q && (<>Showing {all.length} posts · local markdown · shiki at build — <a href="/topics/">Topics →</a></>) }
      </p>
    </header>

    <div class="flex flex-col divide-y mt-2" style="border-color: var(--color-border)">
      {withExcerpt.length === 0 && (<div class="py-10 text-sm" style="color: var(--color-muted)">No posts for "{q}". <a href="/posts" style="color: var(--color-primary)">Clear</a></div>)}
      {withExcerpt.map(({ entry, words, excerpt, slug }) => (
        <div class="py-4">
          <article>
            <header>
              <h2 class="font-bold" style="font-family: var(--font-heading)">
                <a href={`/posts/${slug}/`} style="color: var(--color-primary)">{entry.data.title}</a>
              </h2>
              <p class="mono text-xs flex flex-wrap gap-2 items-center" style="color: var(--color-text-muted)">
                <FormattedDate date={entry.data.pubDate} />
                {entry.data.updatedDate && (<span>· Updated <FormattedDate date={entry.data.updatedDate} /></span>)}
                <span>· {readingTime(words)}</span>
                <span class="tag">{entry.data.category}</span>
                {entry.data.tags.slice(0,2).map((t: string) => (<span class="tag">#{t}</span>))}
              </p>
            </header>
          </article>
          <p class="text-sm mt-2" style="color: var(--color-text-muted)">{excerpt}</p>
        </div>
      ))}
    </div>
  </div>
</Shell>
