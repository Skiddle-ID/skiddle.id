---
export const prerender = true;
import { getCollection } from 'astro:content';
import Shell from '~/layouts/shell.astro';
import FormattedDate from '~/components/formatted-date.astro';

const q = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const all = (await getCollection('posts', ({ data }: any) => !data.draft)).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = all;
const filtered = q
  ? base.filter((p: any) => {
      const t = (p.data.title || '').toLowerCase();
      const body = (p.body || '').toLowerCase();
      const tags = (p.data.tags || []).join(' ').toLowerCase();
      return t.includes(q) || body.includes(q) || tags.includes(q);
    })
  : base;

function readingTime(words: number): string {
  const m = Math.max(1, Math.ceil(words / 200));
  return `${m} min`;
}
const withExcerpt = filtered.map((entry: any) => {
  const words = entry.body.split(/\s+/).length;
  const excerpt = entry.data.description || entry.body.slice(0, 180).trimEnd() + '…';
  const slug = entry.slug || entry.id.replace(/\.md$/, '');
  return { entry, words, excerpt, slug };
});
---

<Shell title="Skiddle@web ~/posts">
  <div class="mx-auto max-w-2xl flex flex-col">
    <header class="flex flex-col">
      <h1 class="font-bold before-hash-1">Posts</h1>
      <p class="text-base03">
        { q && (
          <>Showing {filtered.length} result{filtered.length === 1 ? '' : 's'} for "{q}".</>
        ) }
        { !q && (<>Showing {base.length} posts · local markdown · shiki at build.</>) }
      </p>
    </header>

    <div class="flex flex-col divide-y divide-muted">
      {withExcerpt.map(({ entry, words, excerpt, slug }) => (
        <div class="py-4">
          <article>
            <header>
              <h2 class="text-[var(--color-primary)] font-bold">
                <a href={`/posts/${slug}/`}>{entry.data.title}</a>
              </h2>
              <p class="text-base03 mono text-xs flex flex-wrap gap-2 items-center">
                <FormattedDate date={entry.data.pubDate} />
                {entry.data.updatedDate && (
                  <span>· Updated <FormattedDate date={entry.data.updatedDate} /></span>
                )}
                <span>· {readingTime(words)}</span>
                <span class="tag">{entry.data.category}</span>
                {entry.data.tags.slice(0,2).map((t: string) => (<span class="tag">#{t}</span>))}
              </p>
            </header>
          </article>

          <p class="text-sm mt-2" style="color: var(--color-text-muted)">{excerpt}</p>
        </div>
      ))}
    </div>
  </div>
</Shell>
