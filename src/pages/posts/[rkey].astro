---
export const prerender = true;
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }: any) => !data.draft && !!data.rkey);
  return posts.map((entry: any) => ({
    params: { rkey: entry.data.rkey! },
    props: { slug: entry.slug || entry.id.replace(/\.md$/, '') },
  }));
}

const { slug } = Astro.props as { slug: string };
return Astro.redirect(`/posts/${slug}/`, 301);
---
