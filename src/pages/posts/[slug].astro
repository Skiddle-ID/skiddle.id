---
export const prerender = true;
import { render } from 'astro:content';
import Shell from '~/layouts/shell.astro';
import FormattedDate from '~/components/formatted-date.astro';
import Icon from '~/components/icon.astro';
import PostList from '~/components/post-list.astro';
import BlueskyComments from '~/components/bluesky-comments.astro';
import { getPosts, postUrl, readingMinutes, categoryLabels, type Post } from '~/lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Post };
const { Content, headings } = await render(entry);

const site = Astro.site!;
const canonical = new URL(postUrl(entry), site).toString();
const description = entry.data.description || (entry.body ?? '').slice(0, 160).trimEnd() + '…';
const minutes = readingMinutes(entry);
const toc = headings.filter((h) => h.depth <= 3);
const repoFile = entry.filePath ?? `src/content/posts/${entry.id}.md`;
const editUrl = `https://github.com/Skiddle-ID/skiddle.id/blob/v3/${repoFile}`;

const all = await getPosts();

// Series navigation
let prev: Post | null = null;
let next: Post | null = null;
if (entry.data.series) {
  const series = all
    .filter((p) => p.data.series === entry.data.series)
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
  const idx = series.findIndex((p) => p.id === entry.id);
  if (idx > 0) prev = series[idx - 1];
  if (idx >= 0 && idx < series.length - 1) next = series[idx + 1];
}

// Chronological neighbours for the older / newer links (all is newest first)
const pos = all.findIndex((p) => p.id === entry.id);
const newer: Post | null = pos > 0 ? all[pos - 1] : null;
const older: Post | null = pos >= 0 && pos < all.length - 1 ? all[pos + 1] : null;

// Related: score by shared tags (2pts) and same category (1pt); skip series neighbours
const myTags = new Set(entry.data.tags.map((t) => t.toLowerCase()));
const related = all
  .filter((p) => p.id !== entry.id && p.id !== prev?.id && p.id !== next?.id && p.id !== older?.id && p.id !== newer?.id)
  .map((p) => ({
    p,
    score: p.data.tags.filter((t) => myTags.has(t.toLowerCase())).length * 2 + (p.data.category === entry.data.category ? 1 : 0),
  }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map((r) => r.p);
// Nothing related? Suggest the latest posts instead so readers always have somewhere to go.
if (related.length === 0) {
  related.push(...all.filter((p) => ![entry.id, prev?.id, next?.id, older?.id, newer?.id].includes(p.id)).slice(0, 3));
}

// Share image: a raster cover photo if the post has one, otherwise its generated card
const cover = entry.data.cover;
const shareImage = cover && /\.(png|jpe?g|webp)$/i.test(cover) ? cover : `/og/posts/${entry.id}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  image: new URL(shareImage, site).toString(),
  headline: entry.data.title,
  inLanguage: entry.data.lang,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (entry.data.updatedDate || entry.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Laurensius Jeffrey', alternateName: 'Skiddle', url: site.toString() },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  description,
  url: canonical,
  keywords: entry.data.tags.join(', '),
};
---

<Shell title={`${entry.data.title} — Skiddle`} description={description} type="article" image={shareImage}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Wide screens: article plus a sticky "On this page" column, centred together -->
  <div class="w-full xl:flex xl:justify-center xl:gap-14">
  <article class="max-w-[70ch] w-full min-w-0 mx-auto xl:mx-0" lang={entry.data.lang}>
    <header class="mb-8">
      <p class="text-xs text-[var(--color-muted)] mb-3">
        <a href="/posts/" class="hover:text-[var(--color-primary)]">posts</a>
        <span aria-hidden="true"> / </span>
        <a href={`/topics/#${entry.data.category}`} class="hover:text-[var(--color-primary)]" lang="en">{categoryLabels[entry.data.category].toLowerCase()}</a>
      </p>
      <h1 class="text-2xl font-semibold leading-snug">{entry.data.title}</h1>
      <p class="text-xs text-[var(--color-muted)] mt-3 flex flex-wrap gap-x-2 gap-y-1" lang="en">
        <FormattedDate date={entry.data.pubDate} />
        {entry.data.updatedDate && (<span>· updated <FormattedDate date={entry.data.updatedDate} /></span>)}
        <span>· {minutes} min read</span>
        {entry.data.tags.length > 0 && <span>·</span>}
        {entry.data.tags.map((t) => (<a href={`/topics/tag/${t.toLowerCase()}/`} class="tag">#{t}</a>))}
      </p>
    </header>

    {entry.data.series && (prev || next) && (
      <aside class="card px-4 py-3 mb-8 text-sm" lang="en">
        <p class="text-xs text-[var(--color-muted)] mb-1">Part of a series: <span class="text-[var(--color-text)]">{entry.data.series}</span></p>
        {prev && (<p>← <a href={postUrl(prev)} class="link">{prev.data.title}</a></p>)}
        {next && (<p>→ <a href={postUrl(next)} class="link">{next.data.title}</a></p>)}
      </aside>
    )}

    {entry.data.cover && /^(https?:)?\//.test(entry.data.cover) && (
      <img src={entry.data.cover} alt="" class="w-full rounded-md border mb-8" loading="eager" />
    )}

    {toc.length >= 3 && (
      <details class="card px-4 py-3 mb-8 text-sm group xl:hidden" lang="en">
        <summary class="cursor-pointer text-[var(--color-muted)] select-none">On this page <span>({toc.length})</span></summary>
        <ol class="mt-2 flex flex-col gap-1">
          {toc.map((h) => (
            <li class={h.depth === 3 ? 'pl-4' : ''}>
              <a href={`#${h.slug}`} class="text-[var(--color-muted)] hover:text-[var(--color-primary)]" lang={entry.data.lang}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    )}

    <div class="prose">
      <Content />
    </div>

    {next && (
      <p class="mt-10 text-sm" lang="en">
        <span class="text-[var(--color-muted)]">Next in this series:</span>
        <a href={postUrl(next)} class="link ml-1" lang={next.data.lang}>{next.data.title} →</a>
      </p>
    )}

    {(older || newer) && (
      <nav aria-label="More posts" class="grid sm:grid-cols-2 gap-3 mt-6 text-sm" lang="en">
        {older ? (
          <a href={postUrl(older)} rel="prev" class="card p-3 hover:border-[var(--color-primary)]">
            <span class="block text-xs text-[var(--color-muted)]">← older post</span>
            <span lang={older.data.lang}>{older.data.title}</span>
          </a>
        ) : <span class="hidden sm:block" />}
        {newer && (
          <a href={postUrl(newer)} rel="next" class="card p-3 sm:text-right hover:border-[var(--color-primary)]">
            <span class="block text-xs text-[var(--color-muted)]">newer post →</span>
            <span lang={newer.data.lang}>{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <footer class="mt-12 pt-6 border-t text-sm" lang="en">
      <div class="flex gap-4 items-start">
        <img src="https://github.com/arcestia.png?size=96" alt="" width="48" height="48" class="size-12 rounded-full border shrink-0" loading="lazy" />
        <div>
          <p>Thanks for reading! I'm <a href="/about/" class="link">Jeff</a>, a protocol engineer and the founder of Skiddle Labs, based in Bangkok.</p>
          <p class="text-[var(--color-muted)] mt-1">
            If you enjoyed this, follow me on <a href="https://bsky.app/profile/skiddle.blue" class="link">Bluesky</a>
            or grab the <a href="/rss.xml" class="link">RSS feed</a>. See you in the next post. 👋
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 mt-6">
        <button type="button" class="btn" id="copyLink" data-url={canonical}><Icon name="copy" size={14} /> <span>Copy link</span></button>
        <a class="btn" target="_blank" rel="noopener" href={`https://bsky.app/intent/compose?text=${encodeURIComponent(entry.data.title + ' ' + canonical)}`}><Icon name="bluesky" size={14} /> Share on Bluesky</a>
        <a class="btn" target="_blank" rel="noopener" href={editUrl}><Icon name="github" size={14} /> Suggest an edit</a>
      </div>
    </footer>

    <BlueskyComments uri={entry.data.bluesky} title={entry.data.title} url={canonical} />

    {related.length > 0 && (
      <section class="mt-12" lang="en">
        <h2 class="font-semibold before-hash-2 mb-2">Keep reading</h2>
        <PostList posts={related} />
      </section>
    )}
  </article>

  {toc.length >= 3 && (
    <aside class="hidden xl:block w-56 shrink-0 print:hidden" aria-label="On this page" lang="en">
      <nav class="sticky top-12 text-sm">
        <p class="text-xs text-[var(--color-muted)] mb-3">On this page</p>
        <ol id="tocRail" class="flex flex-col gap-1.5 border-l">
          {toc.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc={h.slug}
                class:list={['block -ml-px border-l-2 border-transparent leading-snug text-[var(--color-muted)] hover:text-[var(--color-primary)]', h.depth === 3 ? 'pl-6' : 'pl-3']}
                lang={entry.data.lang}
              >{h.text}</a>
            </li>
          ))}
        </ol>
        <a href="#main" class="inline-block mt-5 text-xs text-[var(--color-muted)] hover:text-[var(--color-primary)]">↑ back to top</a>
      </nav>
    </aside>
  )}
  </div>
</Shell>

<script>
  // "On this page" column (wide screens): highlight the section being read
  const rail = document.getElementById('tocRail');
  if (rail) {
    const links = [...rail.querySelectorAll<HTMLAnchorElement>('a[data-toc]')];
    const headings = links
      .map((a) => document.getElementById(a.dataset.toc!))
      .filter((h): h is HTMLElement => h !== null);
    let ticking = false;
    const update = () => {
      ticking = false;
      // The last heading above the top quarter of the screen is the current section
      let current = headings[0]?.id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= window.innerHeight * 0.25) current = h.id;
        else break;
      }
      for (const a of links) {
        const on = a.dataset.toc === current;
        a.classList.toggle('toc-active', on);
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }

  // Copy buttons on code blocks
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    if (pre.querySelector('.code-copy')) return;
    const btn = document.createElement('button');
    btn.className = 'code-copy';
    btn.type = 'button';
    btn.textContent = 'copy';
    btn.setAttribute('aria-label', 'Copy code');
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      try {
        await navigator.clipboard.writeText((code ?? pre).innerText);
        btn.textContent = 'copied';
        setTimeout(() => (btn.textContent = 'copy'), 1200);
      } catch {}
    });
    pre.appendChild(btn);
  });

  // Copy page link
  const copyLink = document.getElementById('copyLink');
  copyLink?.addEventListener('click', async () => {
    const label = copyLink.querySelector('span');
    try {
      await navigator.clipboard.writeText(copyLink.dataset.url || location.href);
      if (label) { label.textContent = 'Copied!'; setTimeout(() => (label.textContent = 'Copy link'), 1200); }
    } catch {}
  });
</script>
