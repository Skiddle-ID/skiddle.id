---
/*
  A post, rendered when it's requested from its record in Jeff's AT Protocol repo (the pdsPosts live
  collection, src/lib/pds-posts.ts), so publishing or editing a post needs no build. The page is
  cached at Cloudflare (Astro's route cache, tag "posts") and the PDS reads are cached too.

  Until the v4 launch, a post that isn't on the PDS yet (a draft on a preview, or a post merged
  minutes before the AT Protocol sync ran) is rendered from git instead. Old record-key URLs from
  the WhiteWind days, /posts/<rkey>/, redirect to the post.
*/
export const prerender = false;
import { getEntry, getLiveCollection, getLiveEntry, render } from 'astro:content';
import Shell from '~/layouts/shell.astro';
import FormattedDate from '~/components/formatted-date.astro';
import Icon from '~/components/icon.astro';
import PostList from '~/components/post-list.astro';
import BlueskyComments from '~/components/bluesky-comments.astro';
import SeriesBar from '~/components/series-bar.astro';
import SeriesParts from '~/components/series-parts.astro';
import { getPosts, postUrl, readingMinutes, categoryLabels, groupSeries, seriesUrl, SERIES_LIST_LIMIT, type Post } from '~/lib/posts';
import { POSTS_TAG } from '~/lib/pds-posts';
import { seriesInfo as gitSeriesInfo } from '~/data/series';
import { DID, documentUri } from '~/lib/standard-site.mjs';
import { env } from 'cloudflare:workers';

const slug = Astro.params.slug ?? '';
/** The site's static 404 page, with a 404 status (a rewrite can't reach a prerendered page) */
const notFound = async () => {
  const page = await env.ASSETS.fetch(new URL('/404.html', Astro.url));
  return new Response(page.body, { status: 404, headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' } });
};
const [live, liveList, liveSeries, gitPosts] = await Promise.all([
  getLiveEntry('pdsPosts', slug),
  getLiveCollection('pdsPosts'),
  getLiveCollection('pdsSeries'),
  getPosts(),
]);
if (liveList.error) console.error('posts from the PDS:', liveList.error);
const pdsPosts: Post[] = (liveList.entries ?? []).map((e) => ({ id: e.id, body: e.data.markdown, data: e.data }));
const onPds = new Set(pdsPosts.map((p) => p.id));
// Every post, newest first: the PDS's, plus git's that aren't there yet (until the v4 launch)
const all: Post[] = [...pdsPosts, ...gitPosts.filter((p) => !onPds.has(p.id))].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const seriesInfo = { ...gitSeriesInfo, ...Object.fromEntries((liveSeries.entries ?? []).map((s) => [s.data.name, s.data])) };

let entry: Post | undefined;
let Content: Awaited<ReturnType<typeof render>>['Content'];
let headings: { depth: number; slug: string; text: string }[];
let shareImage: string;
let atDocument: string | undefined;
if (live.entry) {
  entry = { id: live.entry.id, body: live.entry.data.markdown, data: live.entry.data };
  ({ Content } = await render(live.entry));
  headings = live.entry.data.headings ?? [];
  const card = live.entry.data.coverImage;
  shareImage = card ? `/media/${card.cid}` : '/og/site.png';
  atDocument = `at://${DID}/site.standard.document/${live.entry.data.recordKey}`;
  Astro.cache.set({ tags: [POSTS_TAG, `post:${slug}`], lastModified: live.entry.data.updatedDate ?? live.entry.data.pubDate });
} else {
  entry = gitPosts.find((p) => p.id === slug);
  if (!entry) {
    const moved = pdsPosts.find((p) => (p.data as { recordKey?: string }).recordKey === slug) ?? gitPosts.find((p) => p.data.rkey === slug);
    if (moved) return Astro.redirect(postUrl(moved), 301);
    return notFound();
  }
  const gitEntry = await getEntry('posts', slug);
  if (!gitEntry) return notFound();
  ({ Content, headings } = await render(gitEntry));
  // Raster cover photo if the post has one, otherwise its generated card
  const cover = entry.data.cover;
  shareImage = cover && /\.(png|jpe?g|webp)$/i.test(cover) ? cover : `/og/posts/${entry.id}.png`;
  atDocument = documentUri({ slug: entry.id, pubDate: entry.data.pubDate, rkey: entry.data.rkey });
}

const site = Astro.site!;
const canonical = new URL(postUrl(entry), site).toString();
const description = entry.data.description || (entry.body ?? '').slice(0, 160).trimEnd() + '…';
const minutes = readingMinutes(entry);
const toc = headings.filter((h) => h.depth <= 3);
const repoFile = `src/content/posts/${entry.id}.md`;
const editUrl = `https://github.com/Skiddle-ID/skiddle.id/blob/v3/${repoFile}`;
// "updated …" links to the post's change history
const historyUrl = `https://github.com/Skiddle-ID/skiddle.id/commits/v3/${repoFile}`;
// A scheduled draft (publishAt): when it goes live, in Bangkok time
const scheduledFor = entry.data.draft && entry.data.publishAt
  ? new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Bangkok' }).format(entry.data.publishAt)
  : '';
// Series: the box at the top (side column on wide screens) and the "next part" card at the end.
// Parts count planned ones too (src/data/series.ts), so part 1 of a new series is "part 1 of 6".
const series = entry.data.series ? groupSeries(all, seriesInfo).find((s) => s.name === entry!.data.series) : undefined;
// An ongoing series (e.g. weekly) has its box from part 1 and no "of N"
const hasSeries = !!series && (series.entries.length > 1 || series.ongoing);
const openEnded = !!series?.ongoing && series.planned.length === 0;
const entryIdx = series ? series.entries.findIndex((e) => e.post?.id === entry.id) : -1;
const partNumber = entryIdx + 1;
const partCount = series?.entries.length ?? 0;
const nextEntry = series && entryIdx >= 0 ? series.entries[entryIdx + 1] : undefined;
// Published neighbours in the series, kept out of "Keep reading"
const partIdx = series ? series.parts.findIndex((p) => p.id === entry.id) : -1;
const prev: Post | null = series && partIdx > 0 ? series.parts[partIdx - 1] : null;
const next: Post | null = series && partIdx >= 0 && partIdx < series.parts.length - 1 ? series.parts[partIdx + 1] : null;
const showRail = toc.length >= 3 || hasSeries;
const ofCount = openEnded ? '' : ` of ${partCount}`;
const seriesLink = partCount > SERIES_LIST_LIMIT ? `all ${partCount} parts →` : 'all series →';

// Chronological neighbours for the older / newer links (all is newest first)
const pos = all.findIndex((p) => p.id === entry.id);
const newer: Post | null = pos > 0 ? all[pos - 1] : null;
const older: Post | null = pos >= 0 && pos < all.length - 1 ? all[pos + 1] : null;

// Related: score by shared tags (2pts) and same category (1pt); skip series neighbours
const myTags = new Set(entry.data.tags.map((t) => t.toLowerCase()));
const related = all
  .filter((p) => p.id !== entry.id && p.id !== prev?.id && p.id !== next?.id && p.id !== older?.id && p.id !== newer?.id)
  .map((p) => ({
    p,
    score: p.data.tags.filter((t) => myTags.has(t.toLowerCase())).length * 2 + (p.data.category === entry.data.category ? 1 : 0),
  }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map((r) => r.p);
// Nothing related? Suggest the latest posts instead so readers always have somewhere to go.
if (related.length === 0) {
  related.push(...all.filter((p) => ![entry.id, prev?.id, next?.id, older?.id, newer?.id].includes(p.id)).slice(0, 3));
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  image: new URL(shareImage, site).toString(),
  headline: entry.data.title,
  inLanguage: entry.data.lang,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (entry.data.updatedDate || entry.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Laurensius Jeffrey', alternateName: 'Skiddle', url: site.toString() },
  // All rights reserved, no AI training (LICENSE-CONTENT.md)
  copyrightHolder: { '@type': 'Person', name: 'Laurensius Jeffrey' },
  copyrightYear: entry.data.pubDate.getUTCFullYear(),
  license: 'https://github.com/Skiddle-ID/skiddle.id/blob/v3/LICENSE-CONTENT.md',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  description,
  url: canonical,
  keywords: entry.data.tags.join(', '),
};
---

<Shell title={`${entry.data.title} — Skiddle`} description={description} type="article" image={shareImage} atDocument={atDocument}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Wide screens: article plus a sticky "On this page" column, centred together -->
  <div class="w-full xl:flex xl:justify-center xl:gap-14">
  <article class="max-w-[70ch] w-full min-w-0 mx-auto xl:mx-0" lang={entry.data.lang}>
    {entry.data.draft && (
      <p class="card border-[var(--color-warn)] text-[var(--color-warn)] px-4 py-2.5 mb-6 text-sm" role="note" lang="en">
        {scheduledFor ? `Scheduled for ${scheduledFor} (Bangkok time): only on this preview until then.` : 'Draft: only on this preview, not on skiddle.id.'}
      </p>
    )}
    <header class="mb-8">
      <p class="text-xs text-[var(--color-muted)] mb-3">
        <a href="/posts/" class="hover:text-[var(--color-primary)]">posts</a>
        <span aria-hidden="true"> / </span>
        <a href={`/topics/#${entry.data.category}`} class="hover:text-[var(--color-primary)]" lang="en">{categoryLabels[entry.data.category].toLowerCase()}</a>
      </p>
      <h1 class="text-2xl font-semibold leading-snug">{entry.data.title}</h1>
      <p class="text-xs text-[var(--color-muted)] mt-3 flex flex-wrap gap-x-2 gap-y-1" lang="en">
        <FormattedDate date={entry.data.pubDate} />
        {entry.data.updatedDate && (<span>· <a href={historyUrl} class="hover:text-[var(--color-primary)] hover:underline underline-offset-4" title="See what changed" target="_blank" rel="noopener">updated <FormattedDate date={entry.data.updatedDate} /></a></span>)}
        <span>· {minutes} min read</span>
        {entry.data.tags.length > 0 && <span>·</span>}
        {entry.data.tags.map((t) => (<a href={`/topics/tag/${t.toLowerCase()}/`} class="tag">#{t}</a>))}
      </p>
    </header>

    {hasSeries && (
      <details class="card px-4 py-3 mb-8 text-sm group xl:hidden" lang="en">
        <summary class="cursor-pointer select-none list-none flex flex-col gap-2.5 [&::-webkit-details-marker]:hidden">
          <span class="flex items-baseline justify-between gap-3">
            <span>Part {partNumber}{ofCount} in <span class="font-semibold">{series!.name}</span>{series!.ongoing && series!.cadence && <span class="text-[var(--color-muted)]"> · new {series!.cadence}</span>}</span>
            <span class="text-xs text-[var(--color-muted)] whitespace-nowrap"><span class="group-open:hidden">show parts</span><span class="hidden group-open:inline">hide parts</span></span>
          </span>
          <SeriesBar series={series!} />
        </summary>
        <SeriesParts series={series!} currentId={entry.id} class="mt-3" />
        <a href={seriesUrl(series!.name)} class="inline-block mt-3 text-xs text-[var(--color-muted)] hover:text-[var(--color-primary)]">{seriesLink}</a>
      </details>
    )}

    {entry.data.cover && /^(https?:)?\//.test(entry.data.cover) && (
      <img src={entry.data.cover} alt="" class="w-full rounded-md border mb-8" loading="eager" />
    )}

    {toc.length >= 3 && (
      <details class="card px-4 py-3 mb-8 text-sm group xl:hidden" lang="en">
        <summary class="cursor-pointer text-[var(--color-muted)] select-none">On this page <span>({toc.length})</span></summary>
        <ol class="mt-2 flex flex-col gap-1">
          {toc.map((h) => (
            <li class={h.depth === 3 ? 'pl-4' : ''}>
              <a href={`#${h.slug}`} class="text-[var(--color-muted)] hover:text-[var(--color-primary)]" lang={entry.data.lang}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    )}

    <div class="prose prose-reading">
      <Content />
    </div>

    {hasSeries && !nextEntry && series!.ongoing && (
      <div class="card p-4 mt-10 text-sm" lang="en">
        <p class="text-xs text-[var(--color-muted)]">Next in {series!.name} · part {partNumber + 1}</p>
        <p class="mt-1 font-semibold">Coming soon</p>
        <p class="mt-1 font-reading text-[0.95rem] leading-relaxed text-[var(--color-muted)]">
          {series!.cadence && `A new part comes out ${series!.cadence}. `}Follow me on <a href="https://bsky.app/profile/skiddle.blue" class="link">Bluesky</a> or grab the <a href="/rss.xml" class="link">RSS feed</a> to catch the next one.
        </p>
      </div>
    )}
    {hasSeries && nextEntry && (
      nextEntry.post ? (
        <a href={postUrl(nextEntry.post)} class="card block p-4 mt-10 text-sm hover:border-[var(--color-primary)] transition-colors group" lang="en">
          <span class="block text-xs text-[var(--color-muted)]">Next in {series!.name} · part {partNumber + 1}{ofCount}</span>
          <span class="block mt-1 font-semibold group-hover:text-[var(--color-primary)]" lang={nextEntry.post.data.lang}>{nextEntry.title} →</span>
          {nextEntry.post.data.description && (
            <span class="block mt-1 font-reading text-[0.95rem] leading-relaxed text-[var(--color-muted)]" lang={nextEntry.post.data.lang}>{nextEntry.post.data.description}</span>
          )}
        </a>
      ) : (
        <div class="card p-4 mt-10 text-sm" lang="en">
          <p class="text-xs text-[var(--color-muted)]">Next in {series!.name} · part {partNumber + 1}{ofCount}</p>
          <p class="mt-1 font-semibold">{nextEntry.title}</p>
          <p class="mt-1 font-reading text-[0.95rem] leading-relaxed text-[var(--color-muted)]">
            Not out yet. Follow me on <a href="https://bsky.app/profile/skiddle.blue" class="link">Bluesky</a> or grab the <a href="/rss.xml" class="link">RSS feed</a> to catch it.
          </p>
        </div>
      )
    )}

    {(older || newer) && (
      <nav aria-label="More posts" class="grid sm:grid-cols-2 gap-3 mt-6 text-sm" lang="en">
        {older ? (
          <a href={postUrl(older)} rel="prev" class="card p-3 hover:border-[var(--color-primary)]">
            <span class="block text-xs text-[var(--color-muted)]">← older post</span>
            <span lang={older.data.lang}>{older.data.title}</span>
          </a>
        ) : <span class="hidden sm:block" />}
        {newer && (
          <a href={postUrl(newer)} rel="next" class="card p-3 sm:text-right hover:border-[var(--color-primary)]">
            <span class="block text-xs text-[var(--color-muted)]">newer post →</span>
            <span lang={newer.data.lang}>{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <footer class="mt-12 pt-6 border-t text-sm" lang="en">
      <div class="flex gap-4 items-start">
        <img src="/avatars/github-96.jpg" alt="" width="48" height="48" class="size-12 rounded-full border shrink-0" loading="lazy" />
        <div>
          <p>Thanks for reading! I'm <a href="/about/" class="link">Jeff</a>, a protocol engineer and the founder of Skiddle Labs, based in Bangkok.</p>
          <p class="text-[var(--color-muted)] mt-1">
            If you enjoyed this, follow me on <a href="https://bsky.app/profile/skiddle.blue" class="link">Bluesky</a>
            or grab the <a href="/rss.xml" class="link">RSS feed</a>. See you in the next post. 👋
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 mt-6">
        <button type="button" class="btn" id="copyLink" data-url={canonical}><Icon name="copy" size={14} /> <span>Copy link</span></button>
        <a class="btn" target="_blank" rel="noopener" href={`https://bsky.app/intent/compose?text=${encodeURIComponent(entry.data.title + ' ' + canonical)}`}><Icon name="bluesky" size={14} /> Share on Bluesky</a>
        <a class="btn" target="_blank" rel="noopener" href={editUrl}><Icon name="github" size={14} /> Suggest an edit</a>
      </div>
    </footer>

    <BlueskyComments uri={entry.data.bluesky} title={entry.data.title} url={canonical} />

    {related.length > 0 && (
      <section class="mt-12" lang="en">
        <h2 class="font-semibold before-hash-2 mb-2">Keep reading</h2>
        <PostList posts={related} />
      </section>
    )}
  </article>

  {showRail && (
    <aside class="hidden xl:block w-56 shrink-0 print:hidden" aria-label={hasSeries ? 'Series and contents' : 'On this page'} lang="en">
      <div class="sticky top-12 text-sm">
        {hasSeries && (
          <nav aria-label="Series" class="mb-8">
            <p class="text-xs text-[var(--color-muted)] mb-2.5"><a href={seriesUrl(series!.name)} class="hover:text-[var(--color-primary)]">{series!.name}</a> · {openEnded ? `part ${partNumber}` : `${partNumber} of ${partCount}`}</p>
            <SeriesBar series={series!} class="mb-3" />
            <SeriesParts series={series!} currentId={entry.id} labels={false} class="gap-1.5" />
            {partCount > SERIES_LIST_LIMIT && <a href={seriesUrl(series!.name)} class="inline-block mt-2.5 text-xs text-[var(--color-muted)] hover:text-[var(--color-primary)]">{seriesLink}</a>}
          </nav>
        )}
        {toc.length >= 3 && (
          <nav aria-label="On this page">
            <p class="text-xs text-[var(--color-muted)] mb-3">On this page</p>
            <ol id="tocRail" class="flex flex-col gap-1.5 border-l">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc={h.slug}
                    class:list={['block -ml-px border-l-2 border-transparent leading-snug text-[var(--color-muted)] hover:text-[var(--color-primary)]', h.depth === 3 ? 'pl-6' : 'pl-3']}
                    lang={entry.data.lang}
                  >{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <a href="#main" class="inline-block mt-5 text-xs text-[var(--color-muted)] hover:text-[var(--color-primary)]">↑ back to top</a>
      </div>
    </aside>
  )}
  </div>
</Shell>

<script>
  // "On this page" column (wide screens): highlight the section being read
  const rail = document.getElementById('tocRail');
  if (rail) {
    const links = [...rail.querySelectorAll<HTMLAnchorElement>('a[data-toc]')];
    const headings = links
      .map((a) => document.getElementById(a.dataset.toc!))
      .filter((h): h is HTMLElement => h !== null);
    let ticking = false;
    const update = () => {
      ticking = false;
      // The last heading above the top quarter of the screen is the current section
      let current = headings[0]?.id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= window.innerHeight * 0.25) current = h.id;
        else break;
      }
      for (const a of links) {
        const on = a.dataset.toc === current;
        a.classList.toggle('toc-active', on);
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }

  // Copy buttons on code blocks
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    if (pre.querySelector('.code-copy')) return;
    const btn = document.createElement('button');
    btn.className = 'code-copy';
    btn.type = 'button';
    btn.textContent = 'copy';
    btn.setAttribute('aria-label', 'Copy code');
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      try {
        await navigator.clipboard.writeText((code ?? pre).innerText);
        btn.textContent = 'copied';
        setTimeout(() => (btn.textContent = 'copy'), 1200);
      } catch {}
    });
    pre.appendChild(btn);
  });

  // Copy page link
  const copyLink = document.getElementById('copyLink');
  copyLink?.addEventListener('click', async () => {
    const label = copyLink.querySelector('span');
    try {
      await navigator.clipboard.writeText(copyLink.dataset.url || location.href);
      if (label) { label.textContent = 'Copied!'; setTimeout(() => (label.textContent = 'Copy link'), 1200); }
    } catch {}
  });
</script>
