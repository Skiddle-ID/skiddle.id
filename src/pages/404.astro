---
import Shell from '../layouts/shell.astro';
---

<Shell title="Page not found — Skiddle" description="This page doesn't exist." image="/og/site.png">
  <div class="max-w-[70ch] w-full">
    <h1 class="sr-only">Page not found</h1>
    <div class="card p-5 text-sm leading-relaxed" role="status">
      <p><span class="text-[var(--color-primary)]">skiddle@web</span>:<span class="text-[var(--color-muted)]">~</span>$ cd <span id="missingPath">this-page</span></p>
      <p class="text-[#fa4d56]">bash: cd: <span id="missingPath2">this-page</span>: No such file or directory</p>
      <p class="mt-3"><span class="text-[var(--color-primary)]">skiddle@web</span>:<span class="text-[var(--color-muted)]">~</span>$ <span class="cursor-blink" aria-hidden="true"></span></p>
    </div>

    <p class="mt-6 text-sm">
      This page doesn't exist, or it moved. Try one of these instead:
    </p>
    <ul class="mt-3 text-sm flex flex-col gap-1.5">
      <!-- Opens the command bar, searching for the words in the missing URL (set by the script below) -->
      <li><a href="/posts/" id="notFoundSearch" data-cmdk-open class="link">grep</a> <span class="text-[var(--color-muted)]">— search posts and pages<span class="hidden lg:inline"> (or press /)</span></span></li>
      <li><a href="/" class="link">cd ~</a> <span class="text-[var(--color-muted)]">— home</span></li>
      <li><a href="/posts/" class="link">ls posts/</a> <span class="text-[var(--color-muted)]">— everything I've written (with search)</span></li>
      <li><a href="/projects/" class="link">ls projects/</a> <span class="text-[var(--color-muted)]">— things I've built</span></li>
    </ul>
  </div>
</Shell>

<script>
  // The 404 page is static, so fill in the path the visitor actually asked for.
  const path = decodeURIComponent(location.pathname).slice(0, 80);
  for (const id of ['missingPath', 'missingPath2']) {
    const el = document.getElementById(id);
    if (el) el.textContent = path;
  }

  // Search for the words in the missing URL: /posts/how-it-started → "how it started"
  const words = (path.split('/').filter(Boolean).pop() ?? '').replace(/\.\w+$/, '').replace(/[-_+]+/g, ' ').trim().slice(0, 60);
  const search = document.getElementById('notFoundSearch') as HTMLAnchorElement | null;
  if (search && words) {
    search.textContent = `grep "${words}"`;
    search.dataset.cmdkQuery = words;
    search.href = `/posts/?q=${encodeURIComponent(words)}`; // for ⌘/Ctrl-click (new tab)
  }
</script>
