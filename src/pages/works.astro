---
import Shell from '../layouts/shell.astro';
import works from '../data/works';
---

<Shell title="Works — Skiddle" description="Jeff’s work — DevOps engineer building platforms, automation, and networks across cloud and self‑hosted. Passionate about AI and aviation.">
  <div class="max-w-[900px] mx-auto w-full flex flex-col gap-6">
    <!-- Header — warm blue hero -->
    <div class="card p-5" style="background: linear-gradient(135deg, #e6f0ff 0%, #d9e8ff 50%, #c2d6f0 100%); border-color: var(--color-primary)">
      <h1 style="font-family: var(--font-heading); font-size: 1.75rem; line-height: 1.1; margin: 0; color: var(--color-text)">{works.header.name}</h1>
      <p class="mono text-xs mt-1 px-2.5 py-1 rounded-full inline-flex" style="background:white; border:1px solid var(--color-border); color: var(--color-primary)">{works.header.title} · {works.header.location}</p>
      <div class="flex flex-wrap gap-3 mt-3 text-sm">
        <a href={`mailto:${works.header.email}`} style="color: var(--color-primary)" class="mono text-xs">{works.header.email}</a>
        {works.header.links.github && (<a href={works.header.links.github} style="color: var(--color-primary)" class="mono text-xs" target="_blank">GitHub →</a>)}
        {works.header.links.bluesky && (<a href={works.header.links.bluesky} style="color: var(--color-primary)" class="mono text-xs" target="_blank">Bluesky →</a>)}
      </div>
    </div>

    <!-- Summary -->
    <div class="card p-4" style="background:white">
      <div class="mono text-xs uppercase tracking-widest mb-2" style="color: var(--color-text-muted)">Summary</div>
      {works.summary.map((p) => (<p class="text-sm leading-relaxed" style="color: var(--color-text)">{p}</p>))}
    </div>

    <!-- Experience — warm timeline -->
    <section>
      <div class="mono text-xs uppercase tracking-widest mb-2" style="color: var(--color-text-muted)">Experience</div>
      <div class="flex flex-col gap-3">
        {works.experience.map((exp) => (
          <div class="card p-4" style="background:white">
            <div class="font-bold" style="font-family: var(--font-heading); color: var(--color-text)">{exp.company}</div>
            <div class="mt-2 flex flex-col gap-3">
              {exp.positions.map((pos) => (
                <div class="flex gap-3">
                  <div class="w-1 rounded-full shrink-0 self-stretch" style="background: var(--color-border)"></div>
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <span class="text-sm font-semibold" style="color: var(--color-text)">{pos.role}</span>
                      <span class="mono text-xs px-1.5 py-0.5 rounded-full" style="background:#eef6ff; border:1px solid var(--color-border); color: var(--color-text-muted)">{pos.start} — {pos.end}</span>
                    </div>
                    <ul class="mt-2 space-y-1 text-sm" style="color: var(--color-text-muted)">
                      {pos.highlights.map((h) => (<li class="flex gap-2"><span style="color: var(--color-primary)">·</span><span>{h}</span></li>))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education + Skills — grid -->
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="card p-4" style="background:white">
        <div class="mono text-xs uppercase tracking-widest mb-3" style="color: var(--color-text-muted)">Education</div>
        <div class="flex flex-col gap-4">
          {works.education.map((ed) => (
            <div>
              <div class="font-semibold text-sm" style="color: var(--color-text)">{ed.degree}</div>
              <div class="mono text-xs" style="color: var(--color-text-muted)">{ed.school} · {ed.start}{ed.end ? ` — ${ed.end}` : ''}</div>
              {ed.description && (<p class="text-xs mt-1" style="color: var(--color-text-muted)">{ed.description}</p>)}
            </div>
          ))}
        </div>
      </div>
      <div class="card p-4" style="background:white">
        <div class="mono text-xs uppercase tracking-widest mb-2" style="color: var(--color-text-muted)">Skills</div>
        <div class="flex flex-col gap-3 text-sm">
          <div><div class="mono text-xs mb-1" style="color: var(--color-primary)">Languages</div><div class="flex flex-wrap gap-1.5">{works.skills.programmingLanguages.map((s) => (<span class="tag">{s}</span>))}</div></div>
          <div><div class="mono text-xs mb-1" style="color: var(--color-primary)">DevOps</div><div class="flex flex-wrap gap-1.5">{works.skills.devopsInfrastructure.map((s) => (<span class="tag">{s}</span>))}</div></div>
          <div><div class="mono text-xs mb-1" style="color: var(--color-primary)">Frameworks</div><div class="flex flex-wrap gap-1.5">{works.skills.frameworksTools.map((s) => (<span class="tag">{s}</span>))}</div></div>
          <div><div class="mono text-xs mb-1" style="color: var(--color-primary)">Interests</div><div class="flex flex-wrap gap-1.5">{works.skills.interests.map((s) => (<span class="tag">{s}</span>))}</div></div>
        </div>
      </div>
    </div>

    <!-- Projects + Certs -->
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="card p-4" style="background:white">
        <div class="mono text-xs uppercase tracking-widest mb-3" style="color: var(--color-text-muted)">Notable projects</div>
        <div class="flex flex-col gap-4">
          {works.projects.map((prj) => (
            <div>
              <div class="font-semibold text-sm" style="color: var(--color-text)">{prj.title}</div>
              <p class="text-xs mt-1" style="color: var(--color-text-muted)">{prj.description}</p>
              <div class="flex flex-wrap gap-1 mt-2">{prj.labels.map((l) => (<span class="tag" style="background:#eef6ff">{l}</span>))}</div>
              <div class="flex gap-3 mt-2 mono text-xs">
                {prj.live && (<a href={prj.live} style="color: var(--color-primary)" target="_blank">Live →</a>)}
                {prj.github && (<a href={prj.github} style="color: var(--color-primary)" target="_blank">GitHub →</a>)}
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="card p-4" style="background:white">
        <div class="mono text-xs uppercase tracking-widest mb-3" style="color: var(--color-text-muted)">Certifications</div>
        <div class="flex flex-col gap-2 text-sm">
          {works.certifications.map((c) => (
            <div class="flex justify-between gap-2"><span style="color: var(--color-text)">{c.title}</span><span class="mono text-xs shrink-0" style="color: var(--color-text-muted)">{c.yearOrStatus}</span></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Shell>
