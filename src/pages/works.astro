---
import Shell from '../layouts/shell.astro';
import Blocks from '../components/blocks/blocks.astro';
import { CONTENT_PAGES } from '~/data/list-pages';
import { blockPage } from '~/lib/block-page';
import { PAGES_CACHE, getCv } from '~/lib/page-content';
import { cvPageFromLegacy } from '~/lib/page-legacy.mjs';

// Rendered on request, from blocks: the id.skiddle.page record `works`, or until there is one, the
// page made from the id.skiddle.cv record (cvPageFromLegacy). On paper, links show where they go.
export const prerender = false;

const { page, data, preview } = await blockPage(Astro, 'works', async () => {
  const { works, highlights } = await getCv();
  return cvPageFromLegacy(works, highlights, CONTENT_PAGES.works, new Date().toISOString());
});
if (!preview) Astro.cache.set(PAGES_CACHE);
---

<Shell title={`${page.title} — Skiddle`} description={page.description || undefined} image={page.card && `/media/${page.card}`}>
  <Blocks page={page} data={data} preview={preview} class="print-urls" />
</Shell>

<script>
  // The CV header's and contact box's print buttons
  document.querySelectorAll('#printCv, [data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
</script>
