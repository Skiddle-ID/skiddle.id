---
import Shell from '../layouts/shell.astro';
import works from '../data/works';

const h2 = 'font-semibold before-hash-2 mt-10 mb-3';
---

<Shell title="Works & CV — Skiddle" description="Jeff's CV — DevOps and platform engineer building platforms, automation and networks across cloud and self-hosted infrastructure.">
  <div class="max-w-[70ch] w-full print-urls">
    <header>
      <div class="flex flex-wrap items-start justify-between gap-3">
        <h1 class="font-semibold text-xl before-hash-1 print:before:content-none">{works.header.name}</h1>
        <button type="button" id="printCv" class="btn print:hidden">Print / save as PDF</button>
      </div>
      <p class="text-[var(--color-primary)] mt-1">{works.header.title} · {works.header.location}</p>
      <p class="text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1">
        <a href={`mailto:${works.header.email}`} class="link">{works.header.email}</a>
        <a href="https://skiddle.id" class="link hidden print:inline">skiddle.id</a>
        {works.header.links.github && (<a href={works.header.links.github} class="link" target="_blank" rel="me noopener">GitHub</a>)}
        {works.header.links.bluesky && (<a href={works.header.links.bluesky} class="link" target="_blank" rel="me noopener">Bluesky</a>)}
        <a href="/projects/" class="link print:hidden">Open-source projects</a>
        <a href="/services/" class="link print:hidden">Hire me</a>
      </p>
    </header>

    <h2 class={h2}>Summary</h2>
    <div class="text-sm leading-relaxed flex flex-col gap-3">
      {works.summary.map((p) => (<p>{p}</p>))}
    </div>

    <h2 class={h2}>Experience</h2>
    <div class="flex flex-col gap-8">
      {works.experience.map((exp) => (
        <section>
          <h3 class="font-semibold">{exp.company}</h3>
          <div class="mt-2 flex flex-col gap-4 border-l pl-4">
            {exp.positions.map((pos) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                  <span class="text-sm text-[var(--color-primary)]">{pos.role}</span>
                  <span class="text-xs text-[var(--color-muted)] tabular-nums">{pos.start} – {pos.end}</span>
                </div>
                <ul class="mt-1.5 text-sm text-[var(--color-muted)] flex flex-col gap-1">
                  {pos.highlights.map((h) => (<li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span><span>{h}</span></li>))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <h2 class={h2}>Education</h2>
    <div class="flex flex-col gap-3 text-sm">
      {works.education.map((ed) => (
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <span>{ed.degree}</span>
            <span class="text-xs text-[var(--color-muted)] tabular-nums">{ed.start}{ed.end ? ` – ${ed.end}` : ''}</span>
          </div>
          <div class="text-[var(--color-muted)]">{ed.school}</div>
          {ed.description && (<p class="text-xs text-[var(--color-muted)] mt-1">{ed.description}</p>)}
        </div>
      ))}
    </div>

    <h2 class={h2}>Skills</h2>
    <dl class="text-sm grid sm:grid-cols-[9rem_1fr] gap-x-4 gap-y-2">
      <dt class="text-[var(--color-muted)]">Languages</dt><dd>{works.skills.programmingLanguages.join(', ')}</dd>
      <dt class="text-[var(--color-muted)]">DevOps & infra</dt><dd>{works.skills.devopsInfrastructure.join(', ')}</dd>
      <dt class="text-[var(--color-muted)]">Frameworks</dt><dd>{works.skills.frameworksTools.join(', ')}</dd>
      <dt class="text-[var(--color-muted)]">Interests</dt><dd>{works.skills.interests.join(', ')}</dd>
    </dl>

    <h2 class={h2}>Notable projects</h2>
    <div class="flex flex-col gap-5 text-sm">
      {works.projects.map((prj) => (
        <div>
          <div class="flex flex-wrap items-baseline gap-x-3">
            <span class="font-semibold">{prj.title}</span>
            {prj.live && (<a href={prj.live} class="link text-xs" target="_blank" rel="noopener">live</a>)}
            {prj.github && (<a href={prj.github} class="link text-xs" target="_blank" rel="noopener">source</a>)}
          </div>
          <p class="text-[var(--color-muted)] mt-1">{prj.description}</p>
          <p class="text-xs text-[var(--color-muted)] mt-1">{prj.labels.join(' · ')}</p>
        </div>
      ))}
    </div>

    <h2 class={h2}>Certifications</h2>
    <ul class="flex flex-col gap-1.5 text-sm">
      {works.certifications.map((c) => (
        <li class="flex justify-between gap-3"><span>{c.title}</span><span class="text-xs text-[var(--color-muted)] shrink-0">{c.yearOrStatus}</span></li>
      ))}
    </ul>
  </div>
</Shell>

<script>
  document.getElementById('printCv')?.addEventListener('click', () => window.print());
</script>
