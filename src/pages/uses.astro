---
import Shell from '../layouts/shell.astro';
import uses, { usesUpdated } from '../data/uses';

const itemCount = uses.reduce((n, s) => n + s.groups.reduce((m, g) => m + g.items.length, 0), 0);
---

<Shell title="Uses — Skiddle" description="The hardware, software and tools Jeff (Skiddle) uses every day: machines, homelab, dev setup, creative tools and the flight bag.">
  <div class="max-w-[56rem] w-full">
    <header class="max-w-[70ch]">
      <h1 class="font-semibold text-xl before-hash-1">Uses</h1>
      <p class="text-sm mt-2 leading-relaxed">
        The hardware, software and tools I use every day, from the dev box to the flight bag.
        Inspired by <a href="https://uses.tech" class="link" target="_blank" rel="noopener">uses.tech</a>.
      </p>
      <p class="text-xs text-[var(--color-muted)] mt-3">{itemCount} things · last updated {usesUpdated}</p>
    </header>

    <!-- Jump links -->
    <nav aria-label="Sections" class="sticky top-12 lg:top-0 z-10 -mx-5 lg:-mx-10 px-5 lg:px-10 py-3 mt-6 bg-[var(--color-bg)]/95 backdrop-blur border-b border-dashed print:hidden">
      <p class="text-xs flex flex-wrap gap-x-1 gap-y-1.5">
        <span class="text-[var(--color-muted)] mr-1" aria-hidden="true">cd</span>
        {uses.map((s) => (
          <a href={`#${s.id}`} class="px-2 py-0.5 rounded border hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-colors">{s.id}/</a>
        ))}
      </p>
    </nav>

    {uses.map((section) => (
      <section id={section.id} aria-labelledby={`${section.id}-title`} class="mt-10 scroll-mt-28 lg:scroll-mt-16">
        <h2 id={`${section.id}-title`} class="font-semibold before-hash-2">{section.title}</h2>
        {section.blurb && <p class="text-sm text-[var(--color-muted)] mt-1">{section.blurb}</p>}
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {section.groups.map((group) => (
            <div class="card p-4">
              <h3 class="text-xs uppercase tracking-wider text-[var(--color-primary)]">{group.title}</h3>
              <ul class="mt-2.5 flex flex-col gap-2 text-sm">
                {group.items.map((item) => (
                  <li>
                    {item.href
                      ? <a href={item.href} class="link" target="_blank" rel="noopener noreferrer">{item.name}</a>
                      : <span>{item.name}</span>}
                    {item.note && <span class="block text-xs text-[var(--color-muted)] mt-0.5">{item.note}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}

    <p class="mt-12 text-sm text-[var(--color-muted)]">
      Want to know more about any of this? Ask me on
      <a href="https://bsky.app/profile/skiddle.blue" class="link" target="_blank" rel="noopener">Bluesky</a>,
      or read <a href="/topics/tag/homelab/" class="link">my homelab posts</a>.
    </p>
  </div>
</Shell>
