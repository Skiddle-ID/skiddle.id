---
import Shell from '../layouts/shell.astro';
const h2 = 'font-semibold before-hash-2 mt-10 mb-3';
const h3 = 'text-sm text-[var(--color-primary)] mb-1.5';
const list = 'text-sm flex flex-col gap-1.5';
---

<Shell title="Uses — Skiddle" description="The hardware, software and tools Jeff (Skiddle) uses every day.">
  <div class="max-w-[70ch] w-full">
    <h1 class="font-semibold text-xl before-hash-1">Uses</h1>
    <p class="text-sm text-[var(--color-muted)] mt-2">
      Hardware, software and tools I use daily. Inspired by <a href="https://uses.tech" class="link" target="_blank" rel="noopener">uses.tech</a>.
      Last updated September 2025.
    </p>

    <h2 class={h2}>Machines</h2>
    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-6">
      <section>
        <h3 class={h3}>PCs</h3>
        <ul class={list}>
          <li><strong class="font-semibold">Skiddle-Pika</strong> <span class="text-[var(--color-muted)]">— Arch Linux · Ryzen 9 7950X · RTX 4090</span></li>
          <li><strong class="font-semibold">Skiddle-Bulba</strong> <span class="text-[var(--color-muted)]">— Windows 11 · Ryzen 9 9950X3D · RTX 5090</span></li>
        </ul>
      </section>
      <section>
        <h3 class={h3}>Laptops</h3>
        <ul class={list}>
          <li><strong class="font-semibold">Skiddle-Blastoise</strong> <span class="text-[var(--color-muted)]">— MacBook Pro 16" · M3 Pro</span></li>
          <li><strong class="font-semibold">Skiddle-Charizard</strong> <span class="text-[var(--color-muted)]">— ASUS ProArt P16 · AMD HX 370 · RTX 5070</span></li>
        </ul>
      </section>
      <section>
        <h3 class={h3}>Storage</h3>
        <ul class={list}>
          <li><strong class="font-semibold">Skiddle-Torchic</strong> <span class="text-[var(--color-muted)]">— home NAS · Unraid · 4TB NVMe · 65TB HDD</span></li>
          <li><strong class="font-semibold">Skiddle-Mewtwo</strong> <span class="text-[var(--color-muted)]">— primary NAS in Indonesia · Unraid · 8TB NVMe · 550TB · Backblaze</span></li>
        </ul>
      </section>
      <section>
        <h3 class={h3}>Cluster & servers</h3>
        <ul class={list}>
          <li><strong class="font-semibold">Skiddle-Eevee</strong> <span class="text-[var(--color-muted)]">— 8× Raspberry Pi 4B (4GB) · Kubernetes</span></li>
          <li><strong class="font-semibold">Skiddle-Titan</strong> <span class="text-[var(--color-muted)]">— Threadripper PRO 9985WX · RTX 6000 Ada · Proxmox VE (now with Aerialite)</span></li>
        </ul>
      </section>
    </div>

    <h2 class={h2}>Software</h2>
    <dl class="text-sm grid sm:grid-cols-[9rem_1fr] gap-x-4 gap-y-2.5">
      <dt class="text-[var(--color-muted)]">Editor</dt>
      <dd><a href="https://zed.dev" class="link" target="_blank" rel="noopener">Zed</a>, plus <a href="https://neovim.io" class="link" target="_blank" rel="noopener">Neovim</a> for quick edits</dd>
      <dt class="text-[var(--color-muted)]">Terminal</dt>
      <dd><a href="https://ghostty.org/" class="link" target="_blank" rel="noopener">Ghostty</a> on macOS/Linux, Windows Terminal + WSL</dd>
      <dt class="text-[var(--color-muted)]">OS</dt>
      <dd>Arch Linux for dev, macOS daily, Windows 11 for games</dd>
      <dt class="text-[var(--color-muted)]">Browser</dt>
      <dd>Zen Browser, Chrome Canary, Firefox Nightly</dd>
      <dt class="text-[var(--color-muted)]">DevOps & infra</dt>
      <dd>Docker, Kubernetes, Proxmox VE, Unraid, ZFS, Prometheus, Grafana, GitHub Actions, Backblaze</dd>
      <dt class="text-[var(--color-muted)]">Cloud</dt>
      <dd>Cloudflare, AWS, GCP, Vercel, Render</dd>
      <dt class="text-[var(--color-muted)]">Web & data</dt>
      <dd>Astro, Vue, React, Svelte, Nuxt · Node, Go, PHP, Python, Ruby · Postgres, MySQL, Redis, Mongo</dd>
      <dt class="text-[var(--color-muted)]">Writing</dt>
      <dd>This site is Astro + Markdown. Notes live in Obsidian.</dd>
      <dt class="text-[var(--color-muted)]">Design & video</dt>
      <dd>Adobe CC, DaVinci Resolve, OBS</dd>
    </dl>

    <h2 class={h2}>Audio</h2>
    <dl class="text-sm grid sm:grid-cols-[9rem_1fr] gap-x-4 gap-y-2.5">
      <dt class="text-[var(--color-muted)]">Listening</dt><dd>Sony WH-1000XM4, Sennheiser HD600</dd>
      <dt class="text-[var(--color-muted)]">Recording</dt><dd>AT2020, SM58, Audient iD14</dd>
      <dt class="text-[var(--color-muted)]">Software</dt><dd>Logic Pro, Audacity</dd>
    </dl>

    <h2 class={h2}>Fun</h2>
    <dl class="text-sm grid sm:grid-cols-[9rem_1fr] gap-x-4 gap-y-2.5">
      <dt class="text-[var(--color-muted)]">Gaming</dt><dd>Steam, Epic</dd>
      <dt class="text-[var(--color-muted)]">Watching</dt><dd>Netflix, YouTube</dd>
      <dt class="text-[var(--color-muted)]">Reading</dt><dd>Kindle, Prime Reading, Audible</dd>
      <dt class="text-[var(--color-muted)]">Music</dt><dd>Spotify, scrobbled to <a href="https://www.last.fm/user/arcestia" class="link" target="_blank" rel="noopener">Last.fm</a></dd>
    </dl>

    <h2 class={h2}>Aviation</h2>
    <p class="text-sm">
      Working toward my Private Pilot License. Tools: ForeFlight, SkyVector, Aviation Weather Center, Windy and
      simulators, and the Cirrus SR22. <a href="/topics/tag/aviation/" class="link">Read the journey →</a>
    </p>
  </div>
</Shell>
