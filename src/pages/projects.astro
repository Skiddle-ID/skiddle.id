---
import Shell from '../layouts/shell.astro';
import type { Project, ProjectStatus } from '../types/projects';
import projects from '../data/projects';

export const prerender = true;

const byYear = (a: Project, b: Project) => (b.year ?? 0) - (a.year ?? 0);
const featured = projects.filter((p) => p.featured).sort(byYear);
// Put the one with a real story first on the page
featured.sort((a, b) => Number(!!b.writeup) - Number(!!a.writeup));
const others = projects.filter((p) => !p.featured).sort(byYear);

const statusInfo: Record<ProjectStatus, { label: string; color: string }> = {
  'in-services': { label: 'running', color: 'var(--color-ok)' },
  completed: { label: 'done', color: 'var(--color-primary)' },
  'in-progress': { label: 'building', color: 'var(--color-warn)' },
  planned: { label: 'planned', color: 'var(--color-muted)' },
  archived: { label: 'archived', color: 'var(--color-muted)' },
};
const status = (p: Project) => (p.status ? statusInfo[p.status] : null);

function stackOf(p: Project): string[] {
  return [
    ...(p.tech?.languages ?? []),
    ...(p.tech?.frameworks ?? []),
    ...(p.tech?.databases ?? []),
    ...(p.tech?.platforms ?? []),
    ...(p.tech?.tools ?? []),
  ].map((s) => String(s));
}

const years = projects.map((p) => p.year).filter((y): y is number => typeof y === 'number');
const running = projects.filter((p) => p.status === 'in-services').length;
const stats = [
  `${projects.length} projects`,
  `${running} running right now`,
  years.length ? `building since ${Math.min(...years)}` : null,
].filter(Boolean);
---
<Shell title="Projects — Skiddle" description="Open-source projects by Jeff (Skiddle): APIs, automation and tools, with links to source code, live demos and the stories behind them.">
  <div class="max-w-[56rem] w-full">
    <header class="max-w-[70ch]">
      <h1 class="font-semibold text-xl before-hash-1">Projects</h1>
      <p class="text-sm mt-2 leading-relaxed">
        Things I've built in the open, mostly small tools that solve a problem I had, then turned out to be useful
        to other people too. Contributions and feedback are always welcome.
      </p>
      <p class="text-xs text-[var(--color-muted)] mt-3">{stats.join(' · ')}</p>
    </header>

    <!-- Featured -->
    <section aria-labelledby="featured" class="mt-10">
      <h2 id="featured" class="font-semibold before-hash-2">Featured</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {featured.map((p, i) => {
          const s = status(p);
          const stack = stackOf(p);
          return (
            <article class:list={['card p-5 flex flex-col hover:border-[var(--color-primary)] transition-colors', i === 0 && 'md:col-span-2']}>
              <header class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                <h3 class="font-semibold text-lg text-[var(--color-primary)]">{p.name}</h3>
                <p class="text-xs text-[var(--color-muted)] flex items-center gap-2">
                  {s && (
                    <span class="inline-flex items-center gap-1.5">
                      <span class="size-2 rounded-full" style={`background:${s.color}`} aria-hidden="true"></span>
                      {s.label}
                    </span>
                  )}
                  {p.year && <span>· {p.year}</span>}
                  {p.category && <span>· {p.category}</span>}
                </p>
              </header>

              {p.impact && <p class="mt-3 leading-relaxed">{p.impact}</p>}
              {!p.impact && <p class="mt-3 leading-relaxed">{p.description}</p>}

              {p.highlights && p.highlights.length > 0 && (
                <ul class="mt-3 text-sm flex flex-col gap-1">
                  {p.highlights.slice(0, i === 0 ? 4 : 3).map((h) => (
                    <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span><span>{h}</span></li>
                  ))}
                </ul>
              )}

              <div class="mt-auto pt-4 flex flex-wrap items-end justify-between gap-3">
                {stack.length > 0 && (
                  <p class="flex flex-wrap gap-1.5" aria-label="Built with">
                    {stack.map((t) => <span class="text-[11px] px-1.5 py-0.5 rounded border text-[var(--color-muted)]">{t.toLowerCase()}</span>)}
                  </p>
                )}
                <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
                  {p.writeup && <a href={p.writeup} class="link">read the story</a>}
                  {p.homepage && <a href={p.homepage} class="link" target="_blank" rel="noopener noreferrer">live ↗</a>}
                  {p.github && <a href={p.github} class="link" target="_blank" rel="noopener noreferrer">source ↗</a>}
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Everything else, terminal-style -->
    {others.length > 0 && (
      <section aria-labelledby="more" class="mt-12">
        <h2 id="more" class="font-semibold before-hash-2">More projects</h2>
        <div class="card mt-4 p-4 sm:p-5 text-sm overflow-hidden">
          <p class="text-[var(--color-muted)]" aria-hidden="true">
            <span class="text-[var(--color-primary)]">skiddle@web</span>:~$ ls -l projects/
          </p>
          <ul class="mt-3 flex flex-col">
            {others.map((p) => {
              const s = status(p);
              const href = p.homepage ?? p.github;
              return (
                <li class="py-3 border-t border-dashed first:border-t-0 sm:grid sm:grid-cols-[6.5rem_3.5rem_9rem_1fr] sm:gap-x-3 sm:items-baseline">
                  <span class="text-xs inline-flex items-center gap-1.5 text-[var(--color-muted)]">
                    {s && <span class="size-2 rounded-full" style={`background:${s.color}`} aria-hidden="true"></span>}
                    {s?.label ?? '—'}
                  </span>
                  <span class="text-xs text-[var(--color-muted)] tabular-nums ml-2 sm:ml-0">{p.year ?? ''}</span>
                  <span class="block sm:inline mt-1 sm:mt-0">
                    {href
                      ? <a href={href} class="font-semibold text-[var(--color-primary)] hover:underline underline-offset-4" target="_blank" rel="noopener noreferrer">{p.id}/</a>
                      : <span class="font-semibold text-[var(--color-primary)]">{p.id}/</span>}
                  </span>
                  <span class="block sm:inline text-[var(--color-muted)] mt-0.5 sm:mt-0">
                    {p.description}
                    {p.github && p.homepage && (
                      <a href={p.github} class="link ml-2 text-xs" target="_blank" rel="noopener noreferrer">source ↗</a>
                    )}
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}

    <p class="mt-10 text-sm text-[var(--color-muted)]">
      More on <a href="https://github.com/arcestia" class="link" target="_blank" rel="noopener noreferrer">GitHub</a> and
      <a href="https://github.com/Skiddle-ID" class="link" target="_blank" rel="noopener noreferrer">Skiddle-ID</a>.
      Want something like this built? <a href="/services/" class="link">Let's talk</a>.
    </p>
  </div>
</Shell>
