---
import Shell from '../layouts/shell.astro';
import type { Project } from '../types/projects';
import projects from '../data/projects';

export const prerender = true;
// Sort projects by year (descending). Items without year go last.
const sortedProjects: Project[] = [...projects].sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
function statusLabel(status?: string) {
  const map: Record<string, string> = { completed: 'done', 'in-progress': 'in progress', 'in-services': 'running', archived: 'archived' };
  return status ? map[status.toLowerCase()] ?? status : '';
}
function stackOf(p: Project): string[] {
  return [
    ...(p.tech?.languages ?? []),
    ...(p.tech?.frameworks ?? []),
    ...(p.tech?.tools ?? []),
    ...(p.tech?.platforms ?? []),
    ...(p.tech?.databases ?? []),
  ].map(String);
}
const categories = Array.from(new Set(sortedProjects.map((p) => p.category).filter(Boolean))) as string[];
const techstack = Array.from(new Set(sortedProjects.flatMap(stackOf))).sort((a, b) => a.localeCompare(b));
function formatCategory(cat?: string) {
  if (!cat) return '';
  return cat.slice(0,1).toUpperCase() + cat.slice(1);
}
---
<Shell title="Projects — Skiddle" description="Open-source projects by Jeff (Skiddle), with links to source code and live demos.">
  <div class="max-w-[70ch] w-full">
    <h1 class="font-semibold text-xl before-hash-1">Projects</h1>
    <p class="text-sm text-[var(--color-muted)] mt-2">
      Things I've built in the open. Contributions and feedback are always welcome.
    </p>

    <div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-3 text-xs">
      <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by category">
        <button class="filter-cat px-2.5 py-1 border rounded-full" data-cat="all" aria-pressed="true">all</button>
        {categories.map((cat) => (
          <button class="filter-cat px-2.5 py-1 border rounded-full" data-cat={cat} aria-pressed="false">{cat.toLowerCase()}</button>
        ))}
      </div>
      <div class="flex items-center gap-2 sm:ml-auto">
        <label for="tech-select" class="text-[var(--color-muted)]">tech</label>
        <select id="tech-select" class="bg-[var(--color-bg)] text-[var(--color-text)] border rounded px-2 py-1 focus:outline-none focus:border-[var(--color-primary)]">
          <option value="all">all</option>
          {techstack.map((l) => (<option value={l}>{l}</option>))}
        </select>
      </div>
    </div>

    <div class="mt-4 flex flex-col">
      {sortedProjects.map((p: Project) => {
        const stack = stackOf(p);
        const href = p.homepage ?? p.github;
        return (
          <article data-category={p.category ?? ''} data-langs={stack.join(',')} class="project-card py-5 border-b border-dashed last:border-b-0">
            <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="font-semibold">
                {href ? (<a href={href} target="_blank" rel="noopener noreferrer" class="text-[var(--color-primary)] hover:underline underline-offset-4">{p.name}</a>) : (<span class="text-[var(--color-primary)]">{p.name}</span>)}
              </h2>
              {p.featured && (<span class="text-xs" title="Featured">★</span>)}
              <span class="text-xs text-[var(--color-muted)]">
                {[p.year, p.category?.toLowerCase(), statusLabel(p.status)].filter(Boolean).join(' · ')}
              </span>
            </header>

            <p class="text-sm mt-1.5 leading-relaxed">{p.description}</p>
            {p.highlights && p.highlights.length > 0 && (
              <ul class="mt-2 text-sm text-[var(--color-muted)] flex flex-col gap-1">
                {p.highlights.map((h) => (<li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span><span>{h}</span></li>))}
              </ul>
            )}

            {stack.length > 0 && (
              <p class="text-xs text-[var(--color-muted)] mt-3"><span class="sr-only">Built with: </span>{stack.join(' · ')}</p>
            )}

            <p class="mt-3 flex gap-4 text-xs">
              {p.homepage && (<a class="link" href={p.homepage} target="_blank" rel="noopener noreferrer">live</a>)}
              {p.github && (<a class="link" href={p.github} target="_blank" rel="noopener noreferrer">source</a>)}
            </p>
          </article>
        );
      })}
      <p id="projectsEmpty" class="hidden py-8 text-sm text-[var(--color-muted)]">No projects match those filters.</p>
    </div>
  </div>
</Shell>

<script>
  // Simple client-side filters for category and languages
  const $$ = (s) => Array.from(document.querySelectorAll(s));
  function getTechSelect(): HTMLSelectElement | null {
    const el = document.getElementById('tech-select');
    return el instanceof HTMLSelectElement ? el : null;
  }
  function applyFilters() {
    const activeCatBtn = document.querySelector('.filter-cat[aria-pressed="true"]');
    const techSelect = getTechSelect();
    const activeCat = activeCatBtn?.getAttribute('data-cat') ?? 'all';
    const activeLang = techSelect?.value ?? 'all';

    $$('.project-card').forEach((card) => {
      const cat = card.getAttribute('data-category') || '';
      const langs = (card.getAttribute('data-langs') || '').toLowerCase().split(',').filter(Boolean);
      const catOk = activeCat === 'all' || cat === activeCat;
      const langOk = activeLang === 'all' || langs.includes(String(activeLang).toLowerCase());
      card.classList.toggle('hidden', !(catOk && langOk));
    });
    const anyShown = $$('.project-card').some((c) => !c.classList.contains('hidden'));
    document.getElementById('projectsEmpty')?.classList.toggle('hidden', anyShown);
  }

  function setExclusivePressed(selector, target) {
    $$(selector).forEach((btn) => btn.setAttribute('aria-pressed', btn === target ? 'true' : 'false'));
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const btn = target ? (target.closest('.filter-cat, .filter-lang') as HTMLElement | null) : null;
    if (!btn) return;
    if (btn.classList.contains('filter-cat')) setExclusivePressed('.filter-cat', btn);
    applyFilters();
  });

  document.addEventListener('DOMContentLoaded', applyFilters);
  const techSelectInit = getTechSelect();
  if (techSelectInit) {
    techSelectInit.addEventListener('change', applyFilters);
  }
</script>

<style is:global>
  .filter-cat[aria-pressed="true"],
  .filter-lang[aria-pressed="true"] {
    background: color-mix(in oklch, var(--color-primary) 18%, transparent);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .filter-cat,
  .filter-lang {
    transition: background-color .15s ease, border-color .15s ease, color .15s ease;
  }
  .filter-cat:hover,
  .filter-lang:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .filter-cat:focus-visible,
  .filter-lang:focus-visible {
    outline: 2px solid color-mix(in oklch, var(--color-primary) 60%, transparent);
    outline-offset: 2px;
    border-color: var(--color-primary);
  }
</style>
