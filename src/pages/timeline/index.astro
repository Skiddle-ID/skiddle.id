---
/*
  /timeline/: this week on Jeff's timeline, with what's coming up (docs/v4/timeline.md). Other
  weeks, months and days are /timeline/<period>/ (./[period].astro). Rendered on request from the
  id.skiddle.event records (src/lib/page-content.ts), cached like the pages.
*/
import Shell from '~/layouts/shell.astro';
import TimelineIntro from '~/components/timeline-intro.astro';
import TimelineView from '~/components/timeline-view.astro';
import { CONTENT_PAGES } from '~/data/list-pages';
import { PAGES_CACHE, getEvents } from '~/lib/page-content';
import { spanLabel, todayIn, upcoming, weekOf } from '~/lib/timeline.mjs';

export const prerender = false;

const events = await getEvents();
Astro.cache.set(PAGES_CACHE);
const today = todayIn();
const soon = upcoming(events, today);
const meta = CONTENT_PAGES.timeline;
---

<Shell title={`${meta.title} — Skiddle`} description={meta.description}>
  <div class="max-w-[70ch] w-full">
    <TimelineIntro />

    <section aria-labelledby="upcoming" class="mt-8">
      <h2 id="upcoming" class="font-semibold before-hash-2">Upcoming</h2>
      {soon.length === 0 ? (
        <p class="text-sm text-[var(--color-muted)] mt-2">Nothing planned yet.</p>
      ) : (
        <ul class="mt-2 flex flex-col text-sm">
          {soon.map((e) => (
            <li class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3 py-2 border-b last:border-b-0">
              <a href={`/timeline/${e.startsOn}/`} class="text-xs text-[var(--color-muted)] pt-0.5 hover:text-[var(--color-primary)]">{spanLabel(e.startsOn, e.endsOn)}</a>
              <span>{e.title ?? e.label}<span class="text-xs text-[var(--color-muted)]">{[e.title && e.label, e.city].filter(Boolean).map((x) => ` · ${x}`).join('')}</span></span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <TimelineView period={weekOf(today)} events={events} today={today} />
  </div>
</Shell>
