    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }
  .admin-md-tool:nth-child(1) {
    font-weight: 700;
  }
  .admin-md-tool:nth-child(2) {
    font-style: italic;
  }
  .admin-write-tools {
    align-items: center;
    justify-content: space-between;
  }
  .admin-drop-target {
    outline: 2px dashed var(--color-primary);
    outline-offset: 2px;
  }
  .admin-words {
    margin-top: 0.25rem;
    text-align: right;
  }
  /* Focus mode (#editor[data-focus]): the title and the text, nothing else */
  .admin-editor[data-focus] #editorForm > :not(.admin-field-title):not(.admin-editor-panes),
  .admin-editor[data-focus] .admin-pane-preview,
  .admin-editor[data-focus] #editorConflict,
  .admin-editor[data-focus] #editorBackup {
    display: none;
  }
  .admin-editor[data-focus] #editorForm {
    max-width: 46rem;
    width: 100%;
    margin: 0 auto;
  }
  .admin-editor[data-focus] .admin-field-title input {
    font-size: 1.5rem;
    font-weight: 700;
    border-color: transparent;
    background: transparent;
    padding-left: 0;
  }
  .admin-editor[data-focus] .admin-field-title label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .admin-editor[data-focus] .admin-markdown {
    min-height: calc(100vh - 14rem);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .admin textarea {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 1rem;
  }
  .admin input[type='datetime-local'],
  .admin input[type='number'] {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 1rem;
  }
  .admin textarea:focus-visible,
  .admin input[type='datetime-local']:focus-visible,
  .admin input[type='number']:focus-visible,
  .admin-check:has(input:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .admin-row {
    display: flex;
    gap: 0.75rem;
  }
  .admin-row > .admin-field {
    flex: 1 1 0;
    min-width: 0;
  }
  .admin-row > .admin-field-narrow {
    flex: 0 0 6rem;
  }
  .admin-affix {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg);
    padding-left: 0.75rem;
    color: var(--color-muted);
  }
  .admin .admin-affix input {
    border: 0;
    padding-left: 0.125rem;
    padding-right: 0.125rem;
    min-width: 0;
  }
  .admin-affix span:last-child {
    padding-right: 0.75rem;
  }
  .admin-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
  }
  .admin-check input {
    accent-color: var(--color-primary);
  }
  .admin-tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .admin-tabs button {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    color: var(--color-muted);
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }
  .admin-tabs button[aria-selected='true'] {
    color: var(--color-text);
    border-bottom-color: var(--color-primary);
  }
  .admin-label-row > .admin-toolbar {
    margin-bottom: 0;
  }
  .admin-toolbar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .admin-markdown {
    min-height: 60vh;
    font-family: inherit;
    line-height: 1.6;
    resize: vertical;
  }
  .admin-image-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
    border: 1px dashed var(--color-border);
    border-radius: 0.375rem;
    margin-bottom: 0.5rem;
  }
  .admin-image-box img {
    max-height: 10rem;
    width: auto;
    align-self: flex-start;
    border-radius: 0.25rem;
  }
  .admin-preview-head,
  .admin-preview-body {
    max-width: 70ch;
  }
  .admin-preview-head {
    padding-top: 0.5rem;
  }
  .admin-preview-title {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }
  .admin-editor-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  /* Phones: one pane at a time, switched by the tabs. Wide screens: both, side by side */
  .admin-editor[data-pane='write'] .admin-pane-preview,
  .admin-editor[data-pane='preview'] .admin-pane-write {
    display: none;
  }
  @media (min-width: 64rem) {
    .admin-tabs {
      display: none;
    }
    .admin-editor-panes {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }
    .admin-editor[data-pane] .admin-pane-write,
    .admin-editor[data-pane] .admin-pane-preview {
      display: block;
    }
    .admin-editor[data-focus] .admin-editor-panes {
      display: block;
    }
    .admin-editor[data-focus] .admin-pane-preview {
      display: none;
    }
    .admin-pane-preview {
      position: sticky;
      top: 1rem;
      max-height: calc(100vh - 2rem);
      overflow: auto;
    }
  }
  /* One section at a time, chosen by the section bar (src/lib/admin/sections.ts) */
  #dashboard > .admin-card {
    display: none;
  }
  #dashboard[data-section='overview'] > [data-section='overview'],
  #dashboard[data-section='posts'] > [data-section='posts'],
  #dashboard[data-section='series'] > [data-section='series'],
  #dashboard[data-section='pages'] > [data-section='pages'],
  #dashboard[data-section='status'] > [data-section='status'],
  #dashboard[data-section='timeline'] > [data-section='timeline'],
  #dashboard[data-section='media'] > [data-section='media'],
  #dashboard[data-section='site'] > [data-section='site'] {
    display: flex;
  }
  /* The CMS layout: the sidebar beside the sections and editors, on wide screens; on a phone, a bar
     along the bottom with the main sections, and More for the rest (src/lib/admin/sections.ts) */
  .admin:has(#signedIn:not([hidden])) {
    max-width: 84rem;
  }
  body[data-view='editor'] .admin {
    max-width: 92rem;
  }
  #signedIn:not([hidden]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  #signedIn > :not(.admin-side) {
    min-width: 0;
  }
  #dashboard {
    width: 100%;
    max-width: 44rem;
  }
  .admin-side {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .admin-side a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border-radius: 0.375rem;
    color: var(--color-muted);
  }
  .admin-side a:hover {
    color: var(--color-text);
  }
  .admin-side a[aria-current='page'] {
    color: var(--color-primary);
    background: var(--color-bg-alt);
  }
  .admin-side a:focus-visible,
  .admin-side-more:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }
  .admin-side-group {
    margin: 0.75rem 0.75rem 0.25rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .admin-count {
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .admin-side-more {
    display: none;
  }
  @media (min-width: 56rem) {
    #signedIn:not([hidden]) {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
    .admin-side {
      grid-column: 1;
      grid-row: 1 / span 4;
      position: sticky;
      top: 1rem;
    }
    #signedIn > :not(.admin-side) {
      grid-column: 2;
    }
  }
  @media (max-width: 55.99rem) {
    .admin {
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
    .admin-side {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 20;
      flex-direction: row;
      padding: 0.25rem 0.5rem env(safe-area-inset-bottom);
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
    }
    .admin-side > a:not([data-primary]),
    .admin-side-group,
    .admin-side .admin-count {
      display: none;
    }
    .admin-side a,
    .admin-side-more {
      flex: 1 1 0;
      justify-content: center;
      min-height: 3rem;
      font-size: 0.8125rem;
    }
    .admin-side-more {
      display: flex;
      align-items: center;
      background: none;
      border: 0;
      color: var(--color-muted);
      font: inherit;
      font-size: 0.8125rem;
      cursor: pointer;
    }
    /* An editor has its own back button and bars; the bottom bar would cover them */
    body:is([data-view='editor'], [data-view='series'], [data-view='page'], [data-view='blocks']) .admin-side {
      display: none;
    }
    body:is([data-view='editor'], [data-view='series'], [data-view='page'], [data-view='blocks']) .admin {
      padding-bottom: max(3rem, env(safe-area-inset-bottom));
    }
    /* More: every section, as a sheet above the bar */
    .admin-side[data-open] {
      flex-direction: column;
      padding-top: 0.75rem;
      max-height: 85dvh;
      overflow-y: auto;
      border-radius: 0.75rem 0.75rem 0 0;
      box-shadow: 0 -8px 24px rgb(0 0 0 / 0.3);
    }
    .admin-side[data-open] > a:not([data-primary]),
    .admin-side[data-open] .admin-side-group {
      display: flex;
    }
    .admin-side[data-open] a {
      justify-content: space-between;
      flex: none;
    }
    .admin-side[data-open] .admin-count {
      display: inline;
    }
  }
  /* Tables (src/lib/admin/table.ts): filters and search over the rows; on a phone each row stacks */
  .admin-table-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .admin-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .admin-filter {
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .admin-filter[aria-pressed='true'] {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .admin-search {
    flex: 1 1 10rem;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
  }
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .admin-table[hidden] {
    display: none;
  }
  .admin-table th {
    text-align: left;
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--color-muted);
    padding: 0.25rem 0.5rem 0.375rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .admin-table td {
    padding: 0.5rem 0.5rem 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .admin-table tr:last-child td {
    border-bottom: 0;
  }
  .admin-cell-secondary {
    color: var(--color-muted);
    font-size: 0.8125rem;
  }
  .admin-cell-row {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
  }
  .admin-badge {
    display: inline-block;
    padding: 0 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .admin-badge[data-kind='ok'] {
    color: var(--color-ok);
    border-color: var(--color-ok);
  }
  .admin-badge[data-kind='warn'] {
    color: var(--color-warn);
    border-color: var(--color-warn);
  }
  @media (max-width: 40rem) {
    .admin-table thead {
      display: none;
    }
    .admin-table tr {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.5rem;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--color-border);
    }
    .admin-table tr:last-child {
      border-bottom: 0;
    }
    .admin-table td {
      padding: 0;
      border: 0;
    }
    .admin-table td:first-child {
      flex: 1 0 100%;
    }
  }
  /* The Media section (src/lib/admin/media.ts): a grid of files, and the open one under it */
  .admin-media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.5rem;
  }
  .admin-media-tile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    text-align: left;
    overflow: hidden;
    cursor: pointer;
  }
  .admin-media-tile[aria-pressed='true'],
  .admin-media-tile:hover {
    border-color: var(--color-primary);
  }
  .admin-media-tile img,
  .admin-media-ph {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--color-bg-alt);
  }
  .admin-media-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-size: 0.75rem;
  }
  .admin-media-cap {
    padding: 0 0.5rem 0.375rem;
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The site's icon in its editor (src/lib/admin/icon-field.ts) */
  .admin-icon-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .admin-icon-preview {
    width: 4rem;
    height: 4rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg);
  }
  /* The Theme editor's card designs (src/lib/admin/design-field.ts) */
  .admin-designs {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .admin-design-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.75rem;
  }
  .admin-design {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    cursor: pointer;
  }
  .admin-design:has(input:checked) {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary);
  }
  .admin-choice-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .admin-choice {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .admin-choice:has(input:checked) {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary);
  }
  .admin-swatch {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    background: var(--swatch-dark);
  }
  [data-theme='light'] .admin-swatch {
    background: var(--swatch-light);
  }
  .admin-design canvas {
    width: 100%;
    height: auto;
    border-radius: 0.25rem;
    background: var(--color-bg-alt);
  }
  .admin-design-head {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.875rem;
  }
  /* The Theme editor's design (src/lib/admin/theme-editor.ts): the form beside its preview on wide
     screens, the preview under the form on a phone */
  .admin-theme-layout {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 64rem) {
    .admin-theme-layout {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
      align-items: start;
    }
    .admin-theme-preview {
      position: sticky;
      top: 1rem;
    }
  }
  .admin-colors {
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .admin-colors th {
    padding: 0.25rem 0.75rem 0.25rem 0;
    text-align: left;
    font-weight: 400;
  }
  .admin-colors thead th {
    color: var(--color-muted);
  }
  .admin-colors td {
    padding: 0.125rem 0.75rem 0.125rem 0;
  }
  .admin-colors input[type='color'] {
    width: 3rem;
    height: 2rem;
    padding: 0.125rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg);
    cursor: pointer;
  }
  .admin-colors input[aria-invalid='true'] {
    border-color: var(--color-err);
    box-shadow: 0 0 0 2px var(--color-err);
  }
  .admin-colors input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .admin-theme-preview {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .admin-theme-preview h3 {
    font-weight: 600;
  }
  .tp {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tp-space) * 3);
    padding: calc(var(--tp-space) * 4);
    border: 1px solid var(--tp-border);
    border-radius: 0.5rem;
    background: var(--tp-bg);
    color: var(--tp-text);
    font-family: var(--tp-font-text);
    font-size: var(--tp-size);
    line-height: var(--tp-leading);
    letter-spacing: -0.32px;
  }
  .tp p,
  .tp h4 {
    margin: 0;
  }
  .tp-label,
  .tp-muted,
  .tp-prompt,
  .tp-mark {
    color: var(--tp-muted);
  }
  .tp-label {
    font-size: 0.75em;
  }
  .tp-heading {
    font-family: var(--tp-font-heading);
    font-weight: 600;
  }
  .tp-accent,
  .tp-brand {
    color: var(--tp-primary);
  }
  .tp-link {
    color: var(--tp-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tp-post {
    font-family: var(--tp-font-post);
    font-size: 1.1667em;
    line-height: var(--tp-leading-post);
    letter-spacing: 0;
  }
  .tp-card {
    padding: calc(var(--tp-space) * 3);
    border: 1px solid var(--tp-border);
    border-radius: var(--tp-radius);
  }
  .tp-code {
    padding: 0.1em 0.35em;
    border: 1px solid var(--tp-border);
    border-radius: var(--tp-radius-sm);
    background: var(--tp-bg-alt);
    color: var(--tp-primary);
    font-family: var(--tp-font-code);
  }
  .tp-accents span {
    text-decoration: underline;
  }
  .tp-accents [data-accent='blue'] { color: var(--tp-blue); }
  .tp-accents [data-accent='teal'] { color: var(--tp-teal); }
  .tp-accents [data-accent='purple'] { color: var(--tp-purple); }
  .tp-accents [data-accent='pink'] { color: var(--tp-pink); }
  .tp-accents [data-accent='green'] { color: var(--tp-green); }
  .tp-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    margin-left: 0.25em;
    vertical-align: text-bottom;
    background: var(--tp-primary);
  }
  .tp[data-no-prompt] .tp-prompt,
  .tp[data-no-cursor] .tp-cursor,
  .tp[data-no-heading-marks] .tp-mark {
    display: none;
  }
  .admin-media-empty {
    grid-column: 1 / -1;
  }
  .admin-media-detail {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg);
    overflow-wrap: anywhere;
  }
  .admin-media-detail[hidden] {
    display: none;
  }
  .admin-media-uses {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.875rem;
  }
  .admin-media-upload fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .admin-media-upload legend {
    margin-bottom: 0.25rem;
  }
  .admin-media-upload canvas {
    max-width: 16rem;
    max-height: 12rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
  }
  .admin-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.5rem;
  }
  .admin-stat {
    display: flex;
    flex-direction: column;
