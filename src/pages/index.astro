---
import Shell from '../layouts/shell.astro';
import PostList from '../components/post-list.astro';
import { getPosts } from '~/lib/posts';
export const prerender = true;

const handle = 'skiddle.blue';
let avatarUrl: string | undefined;
try {
  const res = await fetch(`https://public.api.bsky.app/xrpc/app.bsky.actor.getProfile?actor=${handle}`);
  if (res.ok) {
    const data = (await res.json()) as { avatar?: string };
    avatarUrl = typeof data?.avatar === 'string' ? data.avatar : undefined;
  }
} catch (_) {}
const profileImg = avatarUrl || 'https://github.com/arcestia.png';

const posts = await getPosts();
const recent = posts.slice(0, 5);
const linkCls = 'link';
---

<Shell title="Skiddle — Jeff's corner of the internet" description="Jeff (Skiddle) — night-shift platform engineer in Bangkok. I build delivery pipelines, run a homelab, care about open protocols, and I'm learning to fly.">
  <div class="max-w-[70ch] w-full">
    <section class="flex flex-col sm:flex-row sm:items-center gap-6 mb-8">
      <img src={profileImg} alt="Jeff's avatar" width="112" height="112" class="size-28 rounded-full shrink-0 border" />
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-semibold leading-tight">Hi, I'm Jeff. Known as Skiddle.</h1>
        <p class="text-[var(--color-primary)]">Platform engineer / Homelabber / Student pilot</p>
      </div>
    </section>

    <div class="prose">
      <p>
        I'm a night-shift platform engineer based in Bangkok, Thailand. I build delivery pipelines,
        keep infrastructure running across cloud and my homelab, and write small tools so I don't
        have to do the same boring thing twice.
      </p>
      <p>
        I'm a big fan of open source and open protocols like ATProto. Most of what I run lives in
        my homelab, because I like owning my own little corner of the internet.
      </p>
      <p>
        Away from the terminal, I'm working toward my Private Pilot License together with my fiancé.
        I write about all of it here: infra, the open web, homelab experiments, and life.
      </p>
      <p>
        Always happy to talk about any of it. Say hi on <a href="https://bsky.app/profile/skiddle.blue" rel="me">Bluesky</a> or
        by <a href="mailto:jeff@skiddle.id">email</a>.
      </p>
    </div>

    <section class="mt-10">
      <div class="flex items-baseline justify-between mb-2">
        <h2 class="font-semibold before-hash-2">Recent posts</h2>
        <a href="/posts/" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-primary)]">all posts →</a>
      </div>
      <PostList posts={recent} />
    </section>

    <section class="mt-10 grid grid-cols-2 gap-6 text-sm">
      <div>
        <h2 class="font-semibold mb-2 before-hash-2">On the web</h2>
        <ul class="space-y-1">
          <li><a class={linkCls} href="https://bsky.app/profile/skiddle.blue" rel="me noopener" target="_blank">Bluesky</a></li>
          <li><a class={linkCls} href="https://github.com/arcestia" rel="me noopener" target="_blank">GitHub</a></li>
          <li><a class={linkCls} href="https://www.instagram.com/skiddle.id" rel="noopener" target="_blank">Instagram</a></li>
          <li><a class={linkCls} href="mailto:jeff@skiddle.id">Email</a></li>
        </ul>
      </div>
      <div>
        <h2 class="font-semibold mb-2 before-hash-2">On this site</h2>
        <ul class="space-y-1">
          <li><a class={linkCls} href="/about/">About me</a></li>
          <li><a class={linkCls} href="/works/">Works</a></li>
          <li><a class={linkCls} href="/projects/">Projects</a></li>
          <li><a class={linkCls} href="/uses/">Uses</a></li>
          <li><a class={linkCls} href="/services/">Services</a></li>
        </ul>
      </div>
    </section>
  </div>
</Shell>
