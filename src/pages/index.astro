---
import Shell from '../layouts/shell.astro';
import LastFm from '../components/LastFm.astro';

const handle = 'skiddle.blue';
let avatarUrl: string | undefined;
try {
  const res = await fetch(`https://public.api.bsky.app/xrpc/app.bsky.actor.getProfile?actor=${handle}`);
  if (res.ok) {
    const data = (await res.json()) as { avatar?: string };
    avatarUrl = data && typeof data.avatar === 'string' ? data.avatar : undefined;
  }
} catch (_) {}
const fallback = 'https://github.com/arcestia.png';
const profileImg = avatarUrl || fallback;
---

<Shell title="skiddle@web ~" description="Jeff (Skiddle) — night-shift DevOps engineer in Bangkok, building platforms, automation, and open internet infrastructure.">

  <!-- Terminal intro block -->
  <div class="max-w-2xl mx-auto w-full">
    <!-- whoami prompt -->
    <div class="font-mono text-sm leading-relaxed mb-6">
      <div class="flex items-start gap-2">
        <span class="text-[var(--color-primary)] select-none">$</span>
        <div>
          <div class="flex items-center gap-1">
            <span class="text-[var(--color-muted)]">skiddle</span><span class="text-[var(--color-text)]">@web</span><span class="text-[var(--color-muted)]"> whoami</span>
          </div>
          <div class="pl-4 mt-1 flex items-center gap-4">
            <img src={profileImg} alt="avatar" class="size-12 rounded-full border border-border" />
            <div class="leading-snug">
              <div class="font-bold text-[var(--color-text)]">Jeff <span class="text-[var(--color-muted)]">aka</span> Skiddle</div>
              <div class="text-[var(--color-primary)] text-sm">DevOps · Bangkok · night shift</div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-2 mt-3">
        <span class="text-[var(--color-primary)] select-none">$</span>
        <div class="flex items-center gap-1">
          <span class="text-[var(--color-muted)]">skiddle</span><span class="text-[var(--color-text)]">@web</span><span class="text-[var(--color-muted)]"> cat about.txt</span>
        </div>
      </div>
      <div class="pl-8 mt-1 space-y-1 text-sm leading-relaxed">
        <p>I build platforms end-to-end, automate delivery and operations, and run infra across cloud and self-hosted.</p>
        <p>Into AI, open protocols (ATProtocol), homelab stuff, and shipping small tools that remove toil.</p>
        <p>Based in Bangkok. Open to collaborating — see <a href="/services" class="text-[var(--color-primary)] hover:underline">services</a>.</p>
      </div>

      <div class="flex items-start gap-2 mt-4">
        <span class="text-[var(--color-primary)] select-none">$</span>
        <div class="flex items-center gap-1">
          <span class="text-[var(--color-muted)]">skiddle</span><span class="text-[var(--color-text)]">@web</span><span class="text-[var(--color-muted)]"> tail -f music.lastfm</span>
        </div>
      </div>
    </div>

    <!-- Last.fm widget -->
    <div class="pl-8 mb-8">
      <LastFm />
    </div>

    <!-- More links -->
    <div class="flex items-start gap-2 mb-4">
      <span class="text-[var(--color-primary)] select-none">$</span>
      <div class="flex items-center gap-1">
        <span class="text-[var(--color-muted)]">skiddle</span><span class="text-[var(--color-text)]">@web</span><span class="text-[var(--color-muted)]"> ls links/</span>
      </div>
    </div>

    <div class="pl-8 grid sm:grid-cols-2 gap-6 max-w-sm">
      <div>
        <div class="text-xs text-[var(--color-muted)] mb-2">elsewhere/</div>
        <ul class="space-y-1 text-sm">
          <li><a class="text-[var(--color-primary)] hover:underline" href="https://bsky.app/profile/skiddle.blue" target="_blank" rel="me noopener noreferrer">bsky.social</a></li>
          <li><a class="text-[var(--color-primary)] hover:underline" href="https://github.com/arcestia" target="_blank" rel="noopener noreferrer">github</a></li>
          <li><a class="text-[var(--color-primary)] hover:underline" href="https://www.instagram.com/skiddle.id" target="_blank" rel="noopener noreferrer">instagram</a></li>
          <li><a class="text-[var(--color-primary)] hover:underline" href="mailto:jeff@skiddle.id">email</a></li>
        </ul>
      </div>
      <div>
        <div class="text-xs text-[var(--color-muted)] mb-2">on_this_site/</div>
        <ul class="space-y-1 text-sm">
          <li><a class="text-[var(--color-primary)] hover:underline" href="/about">about</a></li>
          <li><a class="text-[var(--color-primary)] hover:underline" href="/works">works</a></li>
          <li><a class="text-[var(--color-primary)] hover:underline" href="/services">services</a></li>
          <li><a class="text-[var(--color-primary)] hover:underline" href="/uses">uses</a></li>
          <li><a class="text-[var(--color-primary)] hover:underline" href="/posts">blog</a></li>
        </ul>
      </div>
    </div>

    <!-- Prompt with cursor -->
    <div class="mt-8 flex items-center gap-1 text-sm">
      <span class="text-[var(--color-muted)]">skiddle</span><span class="text-[var(--color-text)]">@web</span><span class="text-[var(--color-muted)]"> ~</span>
      <div class="cursor-blink"></div>
    </div>
  </div>

</Shell>
