---
import Shell from '../layouts/shell.astro';
import PostList from '../components/post-list.astro';
import SeriesBar from '../components/series-bar.astro';
import { groupSeries, seriesStatus, seriesUrl, type Series } from '~/lib/posts';
import { POSTS_CACHE, sitePosts } from '~/lib/site-posts';
import { PAGES_TAG, getProjects, getServices } from '~/lib/page-content';
import { status } from '../data/status';
import { STATE_INFO, toneColour } from '~/lib/status-states.mjs';
// Rendered on request: the recent posts and series come from the PDS (src/lib/site-posts.ts), and
// so do the project cards and the testimonial (src/lib/page-content.ts)
export const prerender = false;

// Bluesky avatar, resized to 224px (2× its 112px size). See README → "Avatars" to update it.
const profileImg = '/avatars/bluesky.jpg';

const [{ posts, seriesInfo }, { projects }, { services }] = await Promise.all([
  sitePosts(),
  getProjects(),
  getServices(),
]);
const series = groupSeries(posts, seriesInfo);
// Purged when either posts or the pages' records change
Astro.cache.set({ ...POSTS_CACHE, tags: [...POSTS_CACHE.tags, PAGES_TAG] });

// Recent posts: everything not in a series, plus only the newest part of each series (the series cards cover the rest)
const seen = new Set<string>();
const recent = posts
  .filter((p) => {
    if (!p.data.series) return true;
    if (seen.has(p.data.series)) return false;
    seen.add(p.data.series);
    return true;
  })
  .slice(0, 4);

const monthYear = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
// Finished series also say when their latest part came out
const seriesMeta = (s: Series) =>
  s.planned.length || s.ongoing
    ? seriesStatus(s)
    : `${seriesStatus(s)} · latest ${monthYear(new Date(Math.max(...s.parts.map((p) => p.data.pubDate.valueOf()))))}`;
const seriesLangs = (s: Series) => [...new Set(s.parts.map((p) => p.data.lang))];

// Hand-picked order for the homepage; everything else lives on /projects/
const selectedIds = ['checkdomain', 'shortlink', 'blocklist'];
const selected = selectedIds
  .map((id) => projects.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const testimonial = services.testimonials[0];
// The status line starts from src/data/status.ts and updates from /api/status.json (the AT Protocol record)
const capitalise = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const h2 = 'font-semibold before-hash-2';
---

<Shell title="Skiddle — protocol engineer in Bangkok" description="Jeff (Skiddle) — protocol engineer and founder of Skiddle Labs in Bangkok, with a background in delivery pipelines and self-hosted infrastructure. I write about it, and I fly as a private pilot.">
  <div class="max-w-[70ch] w-full">

    <!-- Intro -->
    <section aria-labelledby="intro" class="flex flex-col sm:flex-row sm:items-center gap-6">
      <img src={profileImg} alt="Jeff's avatar" width="112" height="112" class="size-24 sm:size-28 rounded-full shrink-0 border" />
      <div class="flex flex-col gap-1.5">
        <h1 id="intro" class="text-2xl font-semibold leading-tight">Hi, I'm Jeff. Known as Skiddle.</h1>
        <p class="text-[var(--color-primary)]">Protocol engineer · Founder of Skiddle Labs · Bangkok</p>
        <p class="text-xs text-[var(--color-muted)] flex items-center gap-2">
          <span id="statusDot" class="size-2 rounded-full shrink-0" style={`background: ${toneColour(STATE_INFO[status.state].tone)}`} aria-hidden="true"></span>
          <span id="statusState" class="sr-only">{STATE_INFO[status.state].label}: </span>
          <span id="statusText">{capitalise(status.label)}</span>
        </p>
      </div>
    </section>

    <div class="prose mt-8">
      <p>
        I run Skiddle Labs, my own company. Right now my team and I are on a protocol-engineering contract for a
        client I can't name. My background is delivery pipelines and keeping infrastructure running across the
        cloud and my homelab. If I have to do something twice, I'd rather write a small tool for it.
      </p>
      <p>
        I'm a fan of open source and open protocols like ATProto, and I write here about infra, the open web,
        homelab experiments and life, including flying.
      </p>
    </div>

    <nav aria-label="Quick links" class="flex flex-wrap gap-2 mt-6">
      <a href="#work" class="btn">Selected work</a>
      <a href="/posts/" class="btn">Read the blog</a>
      <a href="/services/" class="btn border-[var(--color-primary)] text-[var(--color-primary)]">Work with me →</a>
    </nav>

    <!-- Now -->
    <section aria-labelledby="now" class="mt-12">
      <h2 id="now" class={h2}>Now</h2>
      <ul class="mt-3 text-sm flex flex-col gap-1.5">
        <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span><span>Protocol engineering on contract for an undisclosed client, with my Skiddle Labs team (since Q3 2026)</span></li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span><span>Advising <span class="text-[var(--color-text)]">Aerialite</span>, the security &amp; privacy startup I co-founded</span></li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span><span>Studying for a master's in AI &amp; machine learning at Chulalongkorn</span></li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">-</span><span>Flying as a newly licensed private pilot (PPL, early 2026). <a href="/topics/tag/aviation/" class="link">How it started</a></span></li>
      </ul>
    </section>

    <!-- Selected work -->
    <section id="work" aria-labelledby="work-title" class="mt-12 scroll-mt-16">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="work-title" class={h2}>Selected work</h2>
        <a href="/projects/" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-primary)]">all projects →</a>
      </div>
      <div class="mt-4 flex flex-col gap-3">
        {selected.map((p) => (
          <article class="card p-4 hover:border-[var(--color-primary)] transition-colors">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <h3 class="font-semibold text-[var(--color-primary)]">{p.name}</h3>
              <span class="text-xs text-[var(--color-muted)]">{[p.year, p.category].filter(Boolean).join(' · ')}</span>
            </div>
            <p class="text-sm mt-1.5">{p.impact ?? p.description}</p>
            <p class="text-xs mt-3 flex flex-wrap gap-x-4 gap-y-1">
              {p.writeup && (<a href={p.writeup} class="link">read the story</a>)}
              {p.homepage && (<a href={p.homepage} class="link" target="_blank" rel="noopener noreferrer">live</a>)}
              {p.github && (<a href={p.github} class="link" target="_blank" rel="noopener noreferrer">source</a>)}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- Writing -->
    <section aria-labelledby="writing" class="mt-12">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="writing" class={h2}>Writing</h2>
        <a href="/posts/" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-primary)]">all posts →</a>
      </div>
      {series.length > 0 && (
        <>
          <h3 class="text-xs text-[var(--color-muted)] mt-4">series</h3>
          <!-- Two columns for 2 or 4 series, so no card sits alone on a row -->
          <ul class:list={['grid gap-2.5 mt-2', series.length % 2 === 0 && series.length % 3 !== 0 ? 'sm:grid-cols-2' : 'sm:grid-cols-3']}>
            {series.map((s) => (
              <li class="flex">
                <a href={seriesUrl(s.name)} class="card p-3.5 w-full flex flex-col gap-2 hover:border-[var(--color-primary)] transition-colors group">
                  <span class="text-sm font-semibold leading-snug group-hover:text-[var(--color-primary)]">{s.name}</span>
                  <SeriesBar series={s} />
                  <span class="text-xs text-[var(--color-muted)] leading-normal">
                    {seriesMeta(s)}
                    {seriesLangs(s).length > 1 && seriesLangs(s).map((l) => (
                      <span class="ml-1.5 inline-block border rounded px-1 text-[10px] leading-4 uppercase">{l}</span>
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <h3 class="text-xs text-[var(--color-muted)] mt-6">recent</h3>
        </>
      )}
      <div class="mt-2">
        <PostList posts={recent} />
      </div>
    </section>

    <!-- Kind words -->
    {testimonial && (
      <section aria-label="Testimonial" class="mt-12">
        <figure class="border-l-2 border-[var(--color-primary)] pl-4">
          <blockquote class="text-sm leading-relaxed">“{testimonial.quote}”</blockquote>
          <figcaption class="text-xs text-[var(--color-muted)] mt-2">
            — <span class="text-[var(--color-text)]">{testimonial.author}</span>, {testimonial.role}
          </figcaption>
        </figure>
      </section>
    )}

    <!-- Work with me -->
    <section aria-labelledby="hire" class="mt-12 card p-5">
      <h2 id="hire" class="font-semibold">Need a hand with infrastructure?</h2>
      <p class="text-sm text-[var(--color-muted)] mt-1.5">
        I help with server hardening, CI/CD, automation, monitoring and self-hosting.
        Tell me what you're working on and I'll reply with next steps.
      </p>
      <div class="flex flex-wrap gap-2 mt-4">
        <a class="btn border-[var(--color-primary)] text-[var(--color-primary)]" href="mailto:work@skiddle.id?subject=Hello%20from%20skiddle.id">Email work@skiddle.id</a>
        <a class="btn" href="/services/">See services</a>
        <a class="btn" href="/works/">View my CV</a>
      </div>
    </section>

    <!-- Elsewhere -->
    <p class="mt-10 text-sm text-[var(--color-muted)] flex flex-wrap gap-x-4 gap-y-1">
      <span>Elsewhere:</span>
      <a class="link" href="https://bsky.app/profile/skiddle.blue" rel="me noopener" target="_blank">Bluesky</a>
      <a class="link" href="https://github.com/arcestia" rel="me noopener" target="_blank">GitHub</a>
      <a class="link" href="https://www.instagram.com/skiddle.id" rel="noopener" target="_blank">Instagram</a>
      <a class="link" href="mailto:jeff@skiddle.id">Email</a>
      <a class="link" href="/rss.xml">RSS</a>
    </p>
  </div>
</Shell>

<script>
  import { STATE_INFO, stateOf, toneColour } from '~/lib/status-states.mjs';

  // Keep the status line current from the id.skiddle.status record (see src/lib/at-status.ts)
  (async () => {
    const text = document.getElementById('statusText');
    const label = document.getElementById('statusState');
    const dot = document.getElementById('statusDot');
    if (!text || !label || !dot) return;
    try {
      const res = await fetch('/api/status.json');
      if (!res.ok) return;
      const s = (await res.json()) as { state?: string; available?: boolean; text?: string };
      if (typeof s.text !== 'string' || !s.text) return;
      const info = STATE_INFO[stateOf(s)];
      text.textContent = s.text.charAt(0).toUpperCase() + s.text.slice(1);
      label.textContent = `${info.label}: `;
      dot.style.background = toneColour(info.tone);
    } catch {
      // keep the status from the build
    }
  })();
</script>
