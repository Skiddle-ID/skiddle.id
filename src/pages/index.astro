---
import Shell from '../layouts/shell.astro';
import Blocks from '../components/blocks/blocks.astro';
import { blockPage } from '~/lib/block-page';
import { PAGES_TAG, getHome } from '~/lib/page-content';
import { homePageFromLegacy } from '~/lib/page-legacy.mjs';
import { POSTS_CACHE } from '~/lib/site-posts';
// Rendered on request, from blocks (src/components/blocks/): the id.skiddle.page record `home`, or
// until there is one, the page made from the id.skiddle.home record (or src/data/home.ts), as it
// was laid out before blocks (homePageFromLegacy). Each block reads what it shows, e.g. the posts
// and series, Now, the projects and the testimonials (src/lib/page-data.ts).
export const prerender = false;

const { page, data, preview } = await blockPage(Astro, 'home', async () => homePageFromLegacy(await getHome(), new Date().toISOString()));
// Purged when either posts or the pages' records change
if (!preview) Astro.cache.set({ ...POSTS_CACHE, tags: [...POSTS_CACHE.tags, PAGES_TAG] });
---

<Shell title={page.title || undefined} description={page.description || undefined} image={page.card && `/media/${page.card}`}>
  <Blocks page={page} data={data} preview={preview} />
</Shell>

<script>
  import { STATE_INFO, stateOf, toneColour } from '~/lib/status-states.mjs';

  // Keep the status line current from the id.skiddle.status record (see src/lib/at-status.ts)
  (async () => {
    const text = document.getElementById('statusText');
    const label = document.getElementById('statusState');
    const dot = document.getElementById('statusDot');
    const emoji = document.getElementById('statusEmoji');
    if (!text || !label || !dot || !emoji) return;
    try {
      const res = await fetch('/api/status.json');
      if (!res.ok) return;
      const s = (await res.json()) as { state?: string; available?: boolean; text?: string; emoji?: string | null };
      if (typeof s.text !== 'string' || !s.text) return;
      const info = STATE_INFO[stateOf(s)];
      text.textContent = s.text.charAt(0).toUpperCase() + s.text.slice(1);
      label.textContent = `${info.label}: `;
      dot.style.background = toneColour(info.tone);
      // An emoji takes the dot's place
      emoji.textContent = s.emoji ?? '';
      emoji.classList.toggle('hidden', !s.emoji);
      dot.classList.toggle('hidden', !!s.emoji);
    } catch {
      // keep the status from the build
    }
  })();
</script>
