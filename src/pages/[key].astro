---
/*
  /<key>/: a page of Jeff's own (docs/v4/themes.md, "Pages of Jeff's own"), the id.skiddle.page
  record under that key, made in the admin app. Rendered on request from its blocks, like the site's
  own pages (src/lib/block-page.ts), and cached with them. Every route in src/pages/ wins over this
  one, and an address the site uses itself is never one of these pages (src/lib/own-pages.mjs), so
  no record can take the place of a route. An address with no page is the site's 404.

  ?page=2 and on page back through a Bluesky posts block's notes, as on /notes/.
*/
import Shell from '../layouts/shell.astro';
import Blocks from '../components/blocks/blocks.astro';
import { ownBlockPage } from '~/lib/block-page';
import { readsOf } from '~/lib/page-blocks.mjs';
import { PAGES_CACHE } from '~/lib/page-content';
import { ownPagePath } from '~/lib/own-pages.mjs';
import { pageNumber } from '~/lib/notes.mjs';
import { env } from 'cloudflare:workers';

export const prerender = false;

const key = Astro.params.key ?? '';
const raw = Astro.url.searchParams.get('page');
const requested = pageNumber(raw);
const found = await ownBlockPage(Astro, key, { notesPage: requested ?? 1 });
if (!found) {
  const notFound = await env.ASSETS.fetch(new URL('/404.html', Astro.url));
  return new Response(notFound.body, { status: 404, headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' } });
}
const { page, data, preview } = found;
const path = ownPagePath(key);
if (requested === undefined || (requested === 1 && raw !== null)) return Astro.redirect(path, 302);
const shown = readsOf(page).includes('notes') ? await data.notes() : null;
if (requested > 1 && !shown) return Astro.redirect(path, 302);
if (!preview) Astro.cache.set(PAGES_CACHE);
---

<Shell title={`${page.title}${requested > 1 ? `, page ${requested}` : ''} — Skiddle`} description={page.description || undefined} image={page.card ? `/media/${page.card}` : '/og/site.png'}>
  <Blocks page={page} data={data} preview={preview} />
</Shell>

<script>
  // What the blocks of the site's own pages do in the browser, for the same blocks here
  import '~/components/blocks/scripts/status-line';
  import '~/components/blocks/scripts/accent-picker';
  import '~/components/blocks/scripts/print-buttons';
  import '~/components/blocks/scripts/reviews';
</script>
