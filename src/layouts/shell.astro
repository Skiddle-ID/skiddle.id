---
import BaseHead from '../components/base-head.astro';
import Sidebar from '../components/sidebar.astro';
import Footer from '../components/footer.astro';
import Icon from '../components/icon.astro';

import '../style.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Skiddle',
  description = 'Jeff (Skiddle) — night-shift platform engineer in Bangkok, writing about infra, open protocols, homelab and life.',
  image = '/android-chrome-512x512.png',
  type = 'website',
} = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).toString();

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.toString() },
  ...segments.map((seg, idx) => {
    const url = new URL('/' + segments.slice(0, idx + 1).join('/') + '/', site).toString();
    const name = seg.replace(/[-_]/g, ' ').replace(/\b\w/g, (m) => m.toUpperCase());
    return { '@type': 'ListItem', position: idx + 2, name, item: url };
  }),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'Skiddle', url: site.toString(), inLanguage: 'en' },
    {
      '@type': 'Person',
      name: 'Laurensius Jeffrey',
      alternateName: 'Skiddle',
      url: site.toString(),
      image: new URL('/android-chrome-512x512.png', site).toString(),
      sameAs: ['https://bsky.app/profile/skiddle.blue', 'https://github.com/arcestia'],
    },
    { '@type': 'WebPage', url: canonical, name: title, description },
    { '@type': 'BreadcrumbList', itemListElement: breadcrumbItems },
  ],
};
---

<html lang="en" data-theme="dark" data-accent="blue">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Apply saved theme/accent before first paint (no flash). Dark is the default. -->
    <script is:inline>
      (function () {
        try {
          var d = document.documentElement;
          var t = localStorage.getItem('theme');
          var a = localStorage.getItem('accent');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
          if (a) d.dataset.accent = a;
        } catch (e) {}
      })();
    </script>
    <BaseHead title={title} description={description} image={image} type={type} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="antialiased font-mono tracking-normal leading-normal min-h-screen text-[15px]">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:bg-[var(--color-bg)] focus:border focus:rounded">Skip to content</a>

    <!-- Mobile top bar -->
    <div class="lg:hidden fixed top-0 inset-x-0 h-12 border-b z-40 flex items-center justify-between px-4 bg-[var(--color-bg)]">
      <a href="/" class="flex items-center gap-1.5 text-[var(--color-primary)]">
        <span>skiddle@web ~</span><span class="cursor-blink" aria-hidden="true"></span>
      </a>
      <button id="mobileMenuButton" type="button" class="inline-flex items-center justify-center size-9 rounded-md hover:text-[var(--color-primary)]" aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
        <Icon name="menu" size={20} />
      </button>
    </div>

    <Sidebar />

    <div id="sidebarBackdrop" class="lg:hidden fixed inset-0 bg-black/50 z-30 hidden"></div>

    <div class="lg:pl-56 pt-12 lg:pt-0 flex flex-col min-h-screen">
      <main id="main" class="flex flex-col px-5 lg:px-10 py-8 lg:py-12 grow">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      function setupMobileSidebar() {
        const btn = document.getElementById('mobileMenuButton');
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        if (!btn || !sidebar || !backdrop) return;
        const open = () => {
          sidebar.classList.remove('-translate-x-full');
          backdrop.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          btn.setAttribute('aria-label', 'Close menu');
          document.documentElement.classList.add('overflow-hidden');
        };
        const close = () => {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Open menu');
          document.documentElement.classList.remove('overflow-hidden');
        };
        btn.addEventListener('click', () => (sidebar.classList.contains('-translate-x-full') ? open() : close()));
        backdrop.addEventListener('click', close);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      }
      setupMobileSidebar();
    </script>
  </body>
</html>
