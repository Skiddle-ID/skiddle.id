---
import BaseHead from '../components/base-head.astro';
import Sidebar from '../components/sidebar.astro';
import Footer from '../components/footer.astro';
import Icon from '../components/icon.astro';
import CommandBar from '../components/command-bar.astro';
import { scriptJson } from '../lib/script-json.mjs';
import { getSiteMeta, getSiteTheme } from '~/lib/page-content';
import { commandPagesOf, pageMetaOf } from '~/lib/site-meta.mjs';
import { COMMAND_PAGES } from '~/data/frame';
import { FALLBACK_SITE } from '~/data/site-meta';
import { decorationAttributes, fontsToPreload, themeCss } from '~/lib/site-theme.mjs';

import '../style.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** at:// URI of the page's site.standard.document record (posts only) */
  atDocument?: string;
  /** The page's own RSS feed (a series'), linked next to the site's */
  feed?: { title: string; href: string };
  /** The page's own keywords (a post's tags), before the site's */
  keywords?: string[];
}

const { image, type = 'website', atDocument, feed } = Astro.props;
// The site's metadata (id.skiddle.site, src/lib/site-meta.mjs): its name, description, keywords and
// author, and this page's own entry, which wins over what the page says
const [siteMeta, theme] = await Promise.all([getSiteMeta(), getSiteTheme()]);
// Without JavaScript, or until the script below runs: the theme's mode, dark when it follows the device
const firstMode = theme.mode === 'light' ? 'light' : 'dark';
// The theme's design: its CSS variables (none for today's look) and the terminal touches it hides
const designCss = themeCss(theme);
const { title, description, keywords, noindex } = pageMetaOf(siteMeta, Astro.url.pathname, Astro.props);
// The search lists the site's pages, and the menu's links when the record sets the menu
const commandPages = commandPagesOf(COMMAND_PAGES, siteMeta.menu === FALLBACK_SITE.menu ? [] : siteMeta.menu);
const author = siteMeta.author;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).toString();
// Share card: the home page uses the site card; every other page gets its own, rendered after
// the build by src/integrations/share-cards.ts (e.g. /uses/ -> /og/pages/uses.png)
const path = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const shareImage = image ?? (path ? `/og/pages/${path}.png` : '/og/site.png');

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.toString() },
  ...segments.map((seg, idx) => {
    const url = new URL('/' + segments.slice(0, idx + 1).join('/') + '/', site).toString();
    const name = seg.replace(/[-_]/g, ' ').replace(/\b\w/g, (m) => m.toUpperCase());
    return { '@type': 'ListItem', position: idx + 2, name, item: url };
  }),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: siteMeta.name, url: site.toString(), inLanguage: 'en' },
    {
      '@type': 'Person',
      name: author.name,
      ...(author.alternateName ? { alternateName: author.alternateName } : {}),
      ...(author.jobTitles.length ? { jobTitle: author.jobTitles } : {}),
      ...(author.worksFor ? { worksFor: { '@type': 'Organization', name: author.worksFor } } : {}),
      ...(author.knowsAbout.length ? { knowsAbout: author.knowsAbout } : {}),
      ...(author.location ? { homeLocation: { '@type': 'Place', name: author.location } } : {}),
      url: site.toString(),
      image: new URL(siteMeta.icon ? `/media/${siteMeta.icon.png512}` : '/android-chrome-512x512.png', site).toString(),
      sameAs: siteMeta.profiles,
    },
    { '@type': 'WebPage', url: canonical, name: title, description },
    { '@type': 'BreadcrumbList', itemListElement: breadcrumbItems },
  ],
};
---

<html lang="en" data-theme={firstMode} data-accent={theme.accent} data-site-mode={theme.mode} data-site-accent={theme.accent} {...decorationAttributes(theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Apply the theme and accent before first paint (no flash). A visitor's own pick wins; otherwise
         the site's theme (id.skiddle.theme, data-site-mode and data-site-accent): its mode, or the
         device's light/dark setting when it follows the device. Without JavaScript, the theme's
         mode, dark when it follows the device. -->
    <script is:inline>
      (function () {
        const d = document.documentElement;
        let t = null;
        let a = null;
        try {
          t = localStorage.getItem('theme');
          a = localStorage.getItem('accent');
        } catch (e) {}
        const mode = d.dataset.siteMode;
        if (t !== 'light' && t !== 'dark') t = mode === 'light' || mode === 'dark' ? mode : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        d.dataset.theme = t;
        if (a) d.dataset.accent = a;
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={shareImage}
      type={type}
      atDocument={atDocument}
      feed={feed}
      keywords={keywords}
      noindex={noindex}
      siteName={siteMeta.name}
      author={[author.name, author.alternateName && `(${author.alternateName})`].filter(Boolean).join(' ')}
      profiles={siteMeta.profiles}
      icon={siteMeta.icon}
      fonts={fontsToPreload(theme, type === 'article')}
      themeColors={{ dark: theme.colors.dark.bg, light: theme.colors.light.bg }}
    />
    {designCss && <style set:html={designCss} />}
    <script is:inline>
      (function () {
        const m = document.getElementById('themeColor');
        if (m && document.documentElement.dataset.theme === 'light') m.setAttribute('content', '#ffffff');
      })();
    </script>
    <script type="application/ld+json" set:html={scriptJson(jsonLd)} />
  </head>
  <body class="antialiased font-text tracking-normal leading-normal min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:bg-[var(--color-bg)] focus:border focus:rounded-sm">Skip to content</a>

    <!-- Mobile top bar -->
    <div id="topbar" class="lg:hidden print:hidden fixed top-0 inset-x-0 h-12 border-b z-40 flex items-center justify-between px-4 bg-[var(--color-bg)]">
      <a href="/" class="flex items-center gap-1.5 text-[var(--color-primary)]">
        <span>skiddle@web ~</span><span class="cursor-blink" aria-hidden="true"></span>
      </a>
      <div class="flex items-center gap-1">
        <!-- Opens the command bar as a full-screen sheet; a link to /posts/ without JavaScript -->
        <a href="/posts/" data-cmdk-open aria-haspopup="dialog" class="inline-flex items-center justify-center size-9 rounded-md hover:text-[var(--color-primary)]" aria-label="Search">
          <Icon name="search" size={18} />
        </a>
        <button id="mobileMenuButton" type="button" class="inline-flex items-center justify-center size-9 rounded-md hover:text-[var(--color-primary)]" aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
          <Icon name="menu" size={20} />
        </button>
      </div>
    </div>

    <Sidebar menu={siteMeta.menu} hideMusic={siteMeta.hideMusic} hideThemeButtons={siteMeta.hideThemeButtons} />

    <div id="sidebarBackdrop" class="lg:hidden fixed inset-0 bg-[#000]/50 z-30 hidden"></div>

    <div class="lg:pl-56 pt-12 lg:pt-0 print:p-0 flex flex-col min-h-screen">
      <!-- Desktop: centre the page column in the space next to the sidebar -->
      <main id="main" class="flex flex-col lg:items-center px-5 lg:px-10 py-8 lg:py-12 print:p-0 grow">
        <slot />
      </main>
      <Footer links={siteMeta.footerLinks} />
    </div>

    <CommandBar pages={commandPages} />

    <script>
      function setupMobileSidebar() {
        const btn = document.getElementById('mobileMenuButton');
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        if (!btn || !sidebar || !backdrop) return;
        const open = () => {
          sidebar.classList.remove('-translate-x-full');
          backdrop.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          btn.setAttribute('aria-label', 'Close menu');
          document.documentElement.classList.add('overflow-hidden');
        };
        const close = () => {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Open menu');
          document.documentElement.classList.remove('overflow-hidden');
        };
        btn.addEventListener('click', () => (sidebar.classList.contains('-translate-x-full') ? open() : close()));
        backdrop.addEventListener('click', close);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      }
      setupMobileSidebar();
    </script>
  </body>
</html>
