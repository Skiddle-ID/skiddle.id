{
  "lexicon": 1,
  "id": "id.skiddle.cv",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "Deprecated: replaced by id.skiddle.page (key works). Jeff's CV, the /works/ page. One record, key 'self'. Its highlights also show on /services/.",
      "record": {
        "type": "object",
        "required": ["name", "title", "updatedAt"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 1000,
            "maxGraphemes": 100,
            "description": "e.g. 'Laurensius Jeffrey (Jeff)'."
          },
          "title": {
            "type": "string",
            "maxLength": 2000,
            "maxGraphemes": 200,
            "description": "e.g. 'Protocol Engineer & Founder, Skiddle Labs'."
          },
          "location": {
            "type": "string",
            "maxLength": 1000,
            "maxGraphemes": 100
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "links": {
            "type": "ref",
            "ref": "#links"
          },
          "summary": {
            "type": "array",
            "maxLength": 10,
            "items": {
              "type": "string",
              "maxLength": 20000,
              "maxGraphemes": 2000
            },
            "description": "Paragraphs, in order."
          },
          "highlights": {
            "type": "array",
            "maxLength": 12,
            "items": {
              "type": "ref",
              "ref": "#highlight"
            },
            "description": "Proof points: a number or a short fact, and what it means. Every number comes from the CV, the projects or the posts."
          },
          "experience": {
            "type": "array",
            "maxLength": 30,
            "items": {
              "type": "ref",
              "ref": "#company"
            },
            "description": "Newest first."
          },
          "education": {
            "type": "array",
            "maxLength": 20,
            "items": {
              "type": "ref",
              "ref": "#education"
            }
          },
          "skills": {
            "type": "array",
            "maxLength": 10,
            "items": {
              "type": "ref",
              "ref": "#skillGroup"
            }
          },
          "selectedProjects": {
            "type": "array",
            "maxLength": 10,
            "items": {
              "type": "string",
              "format": "at-uri"
            },
            "description": "id.skiddle.project records to show, in order."
          },
          "projects": {
            "type": "array",
            "maxLength": 30,
            "items": {
              "type": "ref",
              "ref": "#notableProject"
            },
            "description": "Other work worth listing that has no id.skiddle.project record."
          },
          "certifications": {
            "type": "array",
            "maxLength": 50,
            "items": {
              "type": "ref",
              "ref": "#certification"
            },
            "description": "Newest first."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "github": {
          "type": "string",
          "format": "uri"
        },
        "bluesky": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "highlight": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 300,
          "maxGraphemes": 30,
          "description": "e.g. '60%' or 'since 2020'."
        },
        "label": {
          "type": "string",
          "maxLength": 3000,
          "maxGraphemes": 300
        },
        "href": {
          "type": "string",
          "maxLength": 2000,
          "description": "A path on skiddle.id, e.g. /posts/…/, or a full URL."
        }
      }
    },
    "company": {
      "type": "object",
      "required": ["company", "positions"],
      "properties": {
        "company": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "maxGraphemes": 500,
          "description": "One line under the company's name, e.g. what it is."
        },
        "positions": {
          "type": "array",
          "maxLength": 20,
          "items": {
            "type": "ref",
            "ref": "#position"
          },
          "description": "Newest first."
        }
      }
    },
    "position": {
      "type": "object",
      "required": ["role", "start"],
      "properties": {
        "role": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "employment": {
          "type": "string",
          "maxLength": 500,
          "maxGraphemes": 50,
          "description": "e.g. 'Contract'. Shown next to the role."
        },
        "client": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "Who the work is for, when it's done through the company, e.g. 'an undisclosed client'."
        },
        "start": {
          "type": "string",
          "maxLength": 200,
          "maxGraphemes": 20,
          "description": "e.g. '2020' or 'Q3 2026'."
        },
        "end": {
          "type": "string",
          "maxLength": 200,
          "maxGraphemes": 20,
          "description": "Absent while it's still the role."
        },
        "highlights": {
          "type": "array",
          "maxLength": 20,
          "items": {
            "type": "string",
            "maxLength": 5000,
            "maxGraphemes": 500
          }
        }
      }
    },
    "education": {
      "type": "object",
      "required": ["degree", "school"],
      "properties": {
        "degree": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "school": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "start": {
          "type": "string",
          "maxLength": 200,
          "maxGraphemes": 20
        },
        "end": {
          "type": "string",
          "maxLength": 200,
          "maxGraphemes": 20
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "maxGraphemes": 500
        }
      }
    },
    "skillGroup": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100,
          "description": "e.g. 'Languages'."
        },
        "items": {
          "type": "array",
          "maxLength": 50,
          "items": {
            "type": "string",
            "maxLength": 1000,
            "maxGraphemes": 100
          }
        }
      }
    },
    "notableProject": {
      "type": "object",
      "required": ["title", "description"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "maxGraphemes": 500
        },
        "labels": {
          "type": "array",
          "maxLength": 20,
          "items": {
            "type": "string",
            "maxLength": 500,
            "maxGraphemes": 50
          },
          "description": "What it's built with."
        },
        "live": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "type": "string",
          "maxLength": 500,
          "maxGraphemes": 50,
          "description": "e.g. 'Ongoing'."
        }
      }
    },
    "certification": {
      "type": "object",
      "required": ["title", "when"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "when": {
          "type": "string",
          "maxLength": 500,
          "maxGraphemes": 50,
          "description": "A year, or e.g. 'Expected Q1 2027'."
        }
      }
    }
  }
}
