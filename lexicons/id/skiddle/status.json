{
  "lexicon": 1,
  "id": "id.skiddle.status",
  "defs": {
    "main": {
      "type": "record",
      "description": "Jeff's current status on skiddle.id: the status badge and the home page. One record, key 'self'.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["available", "text", "updatedAt"],
        "properties": {
          "available": {
            "type": "boolean",
            "description": "Open to new work: a green dot when true, grey when false."
          },
          "text": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640,
            "description": "What the status says, e.g. 'open to consulting'."
          },
          "location": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640,
            "description": "Where Jeff is, e.g. 'Bangkok'."
          },
          "timeZone": {
            "type": "string",
            "maxLength": 64,
            "description": "IANA time zone for the local time, e.g. 'Asia/Bangkok'."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
