{
  "lexicon": 1,
  "id": "id.skiddle.page",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "A page of the site, made of blocks (docs/v4/themes.md). The key is the page's address: 'home' for /, 'about' for /about/. A draft of a page is a record under '<key>~draft' (e.g. 'home~draft'), which the site shows only at the page's address with ?preview=draft; anything that lists pages leaves out keys with a '~'. The site's code defines each kind of block; a record only picks them, orders them and sets their options.",
      "record": {
        "type": "object",
        "required": ["title", "blocks", "updatedAt"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 2000,
            "maxGraphemes": 200,
            "description": "The page's title, in the browser tab and in search results, and its heading unless that's hidden."
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "maxGraphemes": 500,
            "description": "What search results and link previews say about the page."
          },
          "card": {
            "type": "blob",
            "accept": ["image/*"],
            "maxSize": 1000000,
            "description": "The page's share card, drawn by the admin app when the page is published. Without one, the home page uses the site's card."
          },
          "width": {
            "type": "string",
            "maxLength": 64,
            "knownValues": ["narrow", "wide"],
            "default": "narrow",
            "description": "How wide the page is: narrow for reading (the default), wide for grids."
          },
          "hideHeading": {
            "type": "boolean",
            "description": "Leave out the page's heading, e.g. when a block has its own."
          },
          "blocks": {
            "type": "array",
            "maxLength": 200,
            "items": {
              "type": "ref",
              "ref": "#block"
            },
            "description": "The page's blocks, in reading order."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "block": {
      "type": "object",
      "description": "One block on the page, and where it sits. Blocks flow into rows: a full one alone, two halves or three thirds side by side. On a phone every block is full width, in the same order.",
      "required": ["block"],
      "properties": {
        "width": {
          "type": "string",
          "maxLength": 64,
          "knownValues": ["full", "half", "third"],
          "default": "full",
          "description": "How much of a row the block takes: full (the default), half or third."
        },
        "block": {
          "type": "union",
          "refs": [
            "#profile",
            "#markdown",
            "#links",
            "#now",
            "#thisWeek",
            "#projects",
            "#recentPosts",
            "#testimonials",
            "#callToAction",
            "#facts",
            "#section",
            "#principles",
            "#soFar",
            "#contact",
            "#nowFull",
            "#uses",
            "#cvHeader",
            "#jobs",
            "#skills",
            "#projectGrid",
            "#education",
            "#cvContact",
            "#servicesIntro",
            "#highlights",
            "#services",
            "#steps",
            "#reviews",
            "#brief"
          ],
          "description": "The block. A kind of block this site doesn't know is left out of the page, and the admin app keeps it as it is."
        }
      }
    },
    "profile": {
      "type": "object",
      "description": "Jeff's avatar, a greeting as the page's main heading, a tagline, and his status, which keeps itself current.",
      "required": ["greeting"],
      "properties": {
        "greeting": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The heading beside the avatar."
        },
        "tagline": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The line under the heading, in the accent colour."
        },
        "hideStatus": {
          "type": "boolean",
          "description": "Leave out the status line."
        }
      }
    },
    "markdown": {
      "type": "object",
      "description": "A section of text.",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200000,
          "maxGraphemes": 20000,
          "description": "Markdown: paragraphs, headings, lists, links, bold and italics. Raw HTML shows as text."
        }
      }
    },
    "links": {
      "type": "object",
      "description": "A list of links: in a line after its label (e.g. 'Elsewhere:'), or as buttons.",
      "required": ["links"],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100,
          "description": "What the list is, e.g. 'Elsewhere': shown before the links, or read out by screen readers for buttons."
        },
        "buttons": {
          "type": "boolean",
          "description": "Show the links as buttons."
        },
        "links": {
          "type": "array",
          "maxLength": 50,
          "items": {
            "type": "ref",
            "ref": "#link"
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["label", "href"],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100,
          "description": "e.g. 'Bluesky'."
        },
        "href": {
          "type": "string",
          "maxLength": 2000,
          "description": "A path on skiddle.id (/rss.xml), a place on the page (#work), or a full URL: https://… or mailto:…."
        },
        "me": {
          "type": "boolean",
          "description": "One of Jeff's own profiles (rel=\"me\"), so the profile can check it links back here."
        },
        "primary": {
          "type": "boolean",
          "description": "As a button, stands out in the accent colour."
        }
      }
    },
    "now": {
      "type": "object",
      "description": "What Jeff is doing now: the Now page's list (id.skiddle.now), with when it was updated.",
      "properties": {}
    },
    "thisWeek": {
      "type": "object",
      "description": "This week on the timeline: its events, and a count of its posts, status changes and notes. Left out when the week is empty.",
      "properties": {}
    },
    "projects": {
      "type": "object",
      "description": "Picked projects (id.skiddle.project), as cards, in order.",
      "required": ["projects"],
      "properties": {
        "projects": {
          "type": "array",
          "maxLength": 100,
          "items": {
            "type": "string",
            "format": "at-uri"
          },
          "description": "The id.skiddle.project records to show, in order."
        }
      }
    },
    "recentPosts": {
      "type": "object",
      "description": "The newest posts, under the series' cards. A series shows only its newest part, since its card covers the rest.",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 4,
          "description": "How many posts: 4 if left out."
        },
        "hideSeries": {
          "type": "boolean",
          "description": "Leave out the series' cards, and list every part of a series as a post."
        }
      }
    },
    "testimonials": {
      "type": "object",
      "description": "The first five testimonials of the Services page (id.skiddle.services), one at a time, sliding.",
      "properties": {}
    },
    "callToAction": {
      "type": "object",
      "description": "A box with a heading, a line and buttons, e.g. asking people to work with Jeff.",
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "text": {
          "type": "string",
          "maxLength": 10000,
          "maxGraphemes": 1000
        },
        "links": {
          "type": "array",
          "maxLength": 10,
          "items": {
            "type": "ref",
            "ref": "#link"
          },
          "description": "The buttons; one marked primary stands out."
        }
      }
    },
    "facts": {
      "type": "object",
      "description": "Jeff's avatar beside facts about him, a label and a value each, as neofetch prints them, with buttons to pick the site's accent colour. Its heading, if it has one, is the page's main heading, above the card.",
      "required": ["facts"],
      "properties": {
        "heading": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The page's main heading, above the card, e.g. 'About me'. Left out, the card has none."
        },
        "facts": {
          "type": "array",
          "maxLength": 20,
          "items": {
            "type": "ref",
            "ref": "#fact"
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 300,
          "maxGraphemes": 30,
          "description": "e.g. 'Location'."
        },
        "value": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100
        }
      }
    },
    "section": {
      "type": "object",
      "description": "A section of text, under its own heading when it has a title.",
      "required": ["text"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The section's heading. Without one, the text follows the block before it."
        },
        "anchor": {
          "type": "string",
          "maxLength": 64,
          "description": "The heading's id, so a link can point at it (#outside): lowercase letters, digits and hyphens. Made from the title when it's left out."
        },
        "text": {
          "type": "string",
          "maxLength": 200000,
          "maxGraphemes": 20000,
          "description": "Markdown: paragraphs, headings, lists, links, bold and italics. Raw HTML shows as text."
        }
      }
    },
    "principles": {
      "type": "object",
      "description": "How Jeff works: numbered cards, two to a row.",
      "required": ["title", "principles"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The section's heading."
        },
        "principles": {
          "type": "array",
          "maxLength": 10,
          "items": {
            "type": "ref",
            "ref": "#point"
          }
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["title", "body"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100
        },
        "body": {
          "type": "string",
          "maxLength": 5000,
          "maxGraphemes": 500
        }
      }
    },
    "soFar": {
      "type": "object",
      "description": "Jeff's life so far: a line for each year, oldest first, ending with what he's doing now.",
      "required": ["title", "milestones"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The section's heading."
        },
        "milestones": {
          "type": "array",
          "maxLength": 50,
          "items": {
            "type": "ref",
            "ref": "#milestone"
          }
        },
        "current": {
          "type": "string",
          "maxLength": 3000,
          "maxGraphemes": 300,
          "description": "The last line: what Jeff is doing now."
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": ["year", "text"],
      "properties": {
        "year": {
          "type": "string",
          "maxLength": 100,
          "maxGraphemes": 10
        },
        "text": {
          "type": "string",
          "maxLength": 5000,
          "maxGraphemes": 500
        },
        "href": {
          "type": "string",
          "maxLength": 2000,
          "description": "Where to read more: a path on skiddle.id (/posts/…) or a full https:// URL."
        },
        "link": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100,
          "description": "The link's text: 'read the post' if it's left out."
        }
      }
    },
    "contact": {
      "type": "object",
      "description": "Ways to reach Jeff: a heading, a line, and buttons with icons for email, Bluesky and GitHub. The one marked primary stands out.",
      "required": ["title", "links"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The section's heading."
        },
        "text": {
          "type": "string",
          "maxLength": 3000,
          "maxGraphemes": 300
        },
        "links": {
          "type": "array",
          "maxLength": 10,
          "items": {
            "type": "ref",
            "ref": "#link"
          }
        }
      }
    },
    "nowFull": {
      "type": "object",
      "description": "What Jeff is doing now, in full: a heading, the page's main heading, and a lead, when it was last updated, the intro and the whole list (id.skiddle.now).",
      "required": ["heading"],
      "properties": {
        "heading": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The page's main heading. The page hides its own."
        },
        "text": {
          "type": "string",
          "maxLength": 5000,
          "maxGraphemes": 500,
          "description": "The line under the heading, in Markdown: links, bold and italics."
        }
      }
    },
    "uses": {
      "type": "object",
      "description": "The things Jeff uses, in sections of groups, with links to jump to each section. Its heading is the page's main heading; under it, the lead, how many things there are and when the page was last updated.",
      "required": ["heading", "sections"],
      "properties": {
        "heading": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The page's main heading. The page hides its own."
        },
        "text": {
          "type": "string",
          "maxLength": 5000,
          "maxGraphemes": 500,
          "description": "The line under the heading, in Markdown: links, bold and italics."
        },
        "sections": {
          "type": "array",
          "maxLength": 20,
          "items": {
            "type": "ref",
            "ref": "#usesSection"
          }
        },
        "outro": {
          "type": "string",
          "maxLength": 5000,
          "maxGraphemes": 500,
          "description": "A line after the sections, in Markdown."
        }
      }
    },
    "usesSection": {
      "type": "object",
      "required": ["id", "title", "groups"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 500,
          "maxGraphemes": 50,
          "description": "Its address on the page (#homelab): letters, digits and hyphens, starting with a letter."
        },
        "title": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100
        },
        "blurb": {
          "type": "string",
          "maxLength": 3000,
          "maxGraphemes": 300
        },
        "groups": {
          "type": "array",
          "maxLength": 20,
          "items": {
            "type": "ref",
            "ref": "#usesGroup"
          }
        }
      }
    },
    "usesGroup": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100
        },
        "items": {
          "type": "array",
          "maxLength": 50,
          "items": {
            "type": "ref",
            "ref": "#usesItem"
          }
        }
      }
    },
    "usesItem": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100
        },
        "note": {
          "type": "string",
          "maxLength": 3000,
          "maxGraphemes": 300
        },
        "href": {
          "type": "string",
          "maxLength": 2000,
          "description": "Its website: a full https:// URL."
        }
      }
    },
    "cvHeader": {
      "type": "object",
      "description": "The CV's head: Jeff's name, the page's main heading, his title and where he is, how to reach him, a summary, how long he's been in infrastructure, and his highlights as cards under it.",
      "required": ["name", "title"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100
        },
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "location": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "github": {
          "type": "string",
          "maxLength": 2000,
          "description": "His GitHub profile: a full https:// URL."
        },
        "bluesky": {
          "type": "string",
          "maxLength": 2000,
          "description": "His Bluesky profile: a full https:// URL."
        },
        "summary": {
          "type": "array",
          "maxLength": 10,
          "items": {
            "type": "string",
            "maxLength": 20000,
            "maxGraphemes": 2000
          },
          "description": "Paragraphs."
        },
        "since": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100,
          "description": "The year he started in infrastructure: the CV says how many years ago that was."
        },
        "status": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100,
          "description": "A line after the years, in Markdown, e.g. 'open to consulting · [services](/services/)'. Left off the printed page."
        },
        "highlights": {
          "type": "array",
          "maxLength": 12,
          "items": {
            "type": "ref",
            "ref": "#highlight"
          }
        }
      }
    },
    "highlight": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 300,
          "maxGraphemes": 30,
          "description": "e.g. '10+'."
        },
        "label": {
          "type": "string",
          "maxLength": 3000,
          "maxGraphemes": 300
        },
        "href": {
          "type": "string",
          "maxLength": 2000,
          "description": "The story behind it: a path on skiddle.id or a full https:// URL. The CV leaves it out."
        }
      }
    },
    "jobs": {
      "type": "object",
      "description": "Where Jeff has worked: each company, with its roles on a timeline.",
      "required": ["title", "jobs"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The section's heading."
        },
        "jobs": {
          "type": "array",
          "maxLength": 30,
          "items": {
            "type": "ref",
            "ref": "#job"
          }
        }
      }
    },
    "job": {
      "type": "object",
      "required": ["company", "positions"],
      "properties": {
        "company": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "maxGraphemes": 500,
          "description": "One line under the company's name, e.g. what it is."
        },
        "positions": {
          "type": "array",
          "maxLength": 20,
          "items": {
            "type": "ref",
            "ref": "#position"
          }
        }
      }
    },
    "position": {
      "type": "object",
      "required": ["role", "start"],
      "properties": {
        "role": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "employment": {
          "type": "string",
          "maxLength": 500,
          "maxGraphemes": 50,
          "description": "e.g. 'Contract', shown beside the role."
        },
        "client": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "Who the role was for, when it was a client engagement through the company."
        },
        "start": {
          "type": "string",
          "maxLength": 200,
          "maxGraphemes": 20,
          "description": "e.g. '2022'."
        },
        "end": {
          "type": "string",
          "maxLength": 200,
          "maxGraphemes": 20,
          "description": "Left out while it's still the role."
        },
        "highlights": {
          "type": "array",
          "maxLength": 20,
          "items": {
            "type": "string",
            "maxLength": 5000,
            "maxGraphemes": 500
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "description": "Jeff's skills, in groups, as cards of tags.",
      "required": ["title", "groups"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The section's heading."
        },
        "groups": {
          "type": "array",
          "maxLength": 10,
          "items": {
            "type": "ref",
            "ref": "#skillGroup"
          }
        }
      }
    },
    "skillGroup": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100
        },
        "items": {
          "type": "array",
          "maxLength": 50,
          "items": {
            "type": "string",
            "maxLength": 1000,
            "maxGraphemes": 100
          }
        }
      }
    },
    "projectGrid": {
      "type": "object",
      "description": "Picked projects (id.skiddle.project) as a grid of cards, in order, and other projects as a list under them.",
      "required": ["title", "projects"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The section's heading."
        },
        "projects": {
          "type": "array",
          "maxLength": 10,
          "items": {
            "type": "string",
            "format": "at-uri"
          },
          "description": "The id.skiddle.project records to show, in order."
        },
        "others": {
          "type": "array",
          "maxLength": 30,
          "items": {
            "type": "ref",
            "ref": "#otherProject"
          }
        }
      }
    },
    "otherProject": {
      "type": "object",
      "required": ["title", "description"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "maxGraphemes": 500
        },
        "status": {
          "type": "string",
          "maxLength": 500,
          "maxGraphemes": 50,
          "description": "e.g. 'Ongoing'."
        },
        "live": {
          "type": "string",
          "maxLength": 2000,
          "description": "Where it runs: a full https:// URL."
        },
        "source": {
          "type": "string",
          "maxLength": 2000,
          "description": "Its source: a full https:// URL."
        }
      }
    },
    "education": {
      "type": "object",
      "description": "Jeff's education and certifications, side by side.",
      "required": ["title", "schools"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200,
          "description": "The section's heading."
        },
        "schools": {
          "type": "array",
          "maxLength": 20,
          "items": {
            "type": "ref",
            "ref": "#school"
          }
        },
        "certificationsTitle": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 200
        },
        "certifications": {
          "type": "array",
          "maxLength": 50,
          "items": {
            "type": "ref",
